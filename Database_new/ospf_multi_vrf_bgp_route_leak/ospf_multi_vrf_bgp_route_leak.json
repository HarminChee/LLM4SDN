{
  "nodes": {
    "r1": {
      "type": "router",
      "vrfs": {
        "default": { "interfaces": ["r1-eth0", "r1-eth1"] },
        "neno": { "interfaces": ["r1-eth2"] }
      },
      "interfaces": {
        "r1-eth0": { "ip": "10.0.1.1/24", "connected_to": "s1" },
        "r1-eth1": { "ip": "10.0.20.1/24", "connected_to": "s1-2" },
        "r1-eth2": { "ip": "10.0.30.1/24", "connected_to": "s1-3", "vrf": "neno" }
      }
    },
    "r2": {
      "type": "router",
      "vrfs": {
        "default": { "interfaces": ["r2-eth0", "r2-eth1"] },
        "ray": { "interfaces": ["r2-eth2"] }
      },
      "interfaces": {
        "r2-eth0": { "ip": "10.0.2.2/24", "connected_to": "s2" },
        "r2-eth1": { "ip": "10.0.20.2/24", "connected_to": "s1-2" },
        "r2-eth2": { "ip": "10.0.40.1/24", "connected_to": "s2-4", "vrf": "ray" }
      }
    },
    "r3": {
      "type": "router",
      "vrfs": {
        "default": { "interfaces": ["r3-eth0"] }
      },
      "interfaces": {
        "r3-eth0": { "ip": "10.0.3.3/24", "connected_to": "s3" },
        "r3-eth1": { "ip": "10.0.30.2/24", "connected_to": "s1-3" }
      }
    },
    "r4": {
      "type": "router",
      "vrfs": {
        "default": { "interfaces": ["r4-eth0"] }
      },
      "interfaces": {
        "r4-eth0": { "ip": "10.0.4.4/24", "connected_to": "s4" },
        "r4-eth1": { "ip": "10.0.40.2/24", "connected_to": "s2-4" }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "links": [
        { "node": "r1", "interface": "r1-eth0" }
      ]
    },
    "s2": {
      "type": "switch",
      "links": [
        { "node": "r2", "interface": "r2-eth0" }
      ]
    },
    "s3": {
      "type": "switch",
      "links": [
        { "node": "r3", "interface": "r3-eth0" }
      ]
    },
    "s4": {
      "type": "switch",
      "links": [
        { "node": "r4", "interface": "r4-eth0" }
      ]
    },
    "s1-2": {
      "type": "switch",
      "links": [
        { "node": "r1", "interface": "r1-eth1" },
        { "node": "r2", "interface": "r2-eth1" }
      ]
    },
    "s1-3": {
      "type": "switch",
      "links": [
        { "node": "r1", "interface": "r1-eth2" },
        { "node": "r3", "interface": "r3-eth1" }
      ]
    },
    "s2-4": {
      "type": "switch",
      "links": [
        { "node": "r2", "interface": "r2-eth2" },
        { "node": "r4", "interface": "r4-eth1" }
      ]
    }
  }
}
