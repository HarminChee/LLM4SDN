{
  "routers": {
    "r1": {
      "interfaces": [
        {
          "interface": "r1-eth0",
          "connected_to": "s1",
          "subnet": "192.168.0.0/24"
        }
      ],
      "bgp": {
        "as_number": 65001,
        "neighbors": {
          "r2": {
            "remote_as": 65001,
            "afi_safi": "ipv4Unicast",
            "graceful_restart": true
          }
        }
      }
    },
    "r2": {
      "interfaces": [
        {
          "interface": "r2-eth0",
          "connected_to": "s1",
          "subnet": "192.168.0.0/24"
        }
      ],
      "bgp": {
        "as_number": 65001,
        "neighbors": {
          "r1": {
            "remote_as": 65001,
            "afi_safi": "ipv4Unicast",
            "graceful_restart": true
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "connected_devices": ["r1", "r2"],
      "subnet": "192.168.0.0/24"
    }
  }
}
