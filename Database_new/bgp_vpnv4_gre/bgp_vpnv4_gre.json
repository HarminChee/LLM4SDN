{
  "nodes": [
    { "id": "r1", "type": "router", "as": 65500 },
    { "id": "r2", "type": "router", "as": 65501 },
    { "id": "s1", "type": "switch" },
    { "id": "s2", "type": "switch" },
    { "id": "s3", "type": "switch" }
  ],
  "links": [
    { "source": "r1", "target": "s1", "interfaces": ["r1:eth0", "s1:port1"] },
    { "source": "r2", "target": "s1", "interfaces": ["r2:eth0", "s1:port2"] },
    { "source": "r1", "target": "s2", "interfaces": ["r1:eth1", "s2:port1"] },
    { "source": "r2", "target": "s3", "interfaces": ["r2:eth1", "s3:port1"] }
  ],
  "vrfs": [
    {
      "router": "r1",
      "vrfs": [
        { "name": "vrf1", "table_id": 10, "interfaces": ["r1-eth1"] }
      ]
    },
    {
      "router": "r2",
      "vrfs": [
        { "name": "vrf1", "table_id": 10, "interfaces": ["r2-eth1"] }
      ]
    }
  ],
  "gre_tunnels": [
    {
      "source": "r1",
      "target": "r2",
      "interfaces": ["r1:gre0", "r2:gre0"],
      "local_ip": "10.125.0.1",
      "remote_ip": "10.125.0.2",
      "ttl": 64
    }
  ],
  "mpls": {
    "enabled_on": ["r1:eth0", "r2:eth0", "r1:gre0", "r2:gre0"]
  },
  "bgp_sessions": [
    {
      "source": "r1",
      "target": "r2",
      "parameters": { "local_as": 65500, "peer_as": 65501, "vpnv4_enabled": true }
    }
  ],
  "ipv4_forwarding": ["r1", "r2"]
}
