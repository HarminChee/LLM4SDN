{
  "nodes": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "ip": "192.168.1.1",
          "connected_to": "sw1"
        }
      },
      "role": "main_router"
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "ip": "192.168.1.2",
          "connected_to": "sw1"
        }
      },
      "role": "next_hop"
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "ip": "192.168.1.3",
          "connected_to": "sw1"
        }
      },
      "role": "next_hop"
    },
    "r4": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "ip": "192.168.1.4",
          "connected_to": "sw1"
        }
      },
      "role": "next_hop"
    },
    "r5": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "ip": "192.168.1.5",
          "connected_to": "sw1"
        }
      },
      "role": "next_hop"
    }
  },
  "links": {
    "sw1": {
      "type": "switch",
      "subnet": "192.168.1.0/24",
      "connected_to": ["r1", "r2", "r3", "r4", "r5"]
    }
  },
  "routes": {
    "10.0.0.0/24": {
      "origin": "r1",
      "next_hops": ["r2", "r3", "r4", "r5"]
    }
  }
}
