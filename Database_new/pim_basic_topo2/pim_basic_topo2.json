{
  "nodes": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "ip": "192.168.1.1",
          "connected_to": "sw1"
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "ip": "192.168.1.2",
          "connected_to": "sw1"
        },
        "eth1": {
          "ip": "192.168.2.1",
          "connected_to": "sw3"
        },
        "eth2": {
          "ip": "192.168.3.4",
          "connected_to": "sw2"
        }
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "ip": "192.168.3.3",
          "connected_to": "sw2"
        }
      }
    },
    "r4": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "ip": "192.168.1.4",
          "connected_to": "sw1"
        },
        "eth2": {
          "ip": "192.168.3.4",
          "connected_to": "sw2"
        }
      }
    },
    "sw1": {
      "type": "switch",
      "subnet": "192.168.1.0/24",
      "connected_to": ["r1", "r2", "r4"]
    },
    "sw2": {
      "type": "switch",
      "subnet": "192.168.3.0/24",
      "connected_to": ["r2", "r3", "r4"]
    },
    "sw3": {
      "type": "switch",
      "subnet": "192.168.2.0/24",
      "connected_to": ["r2"]
    }
  }
}
