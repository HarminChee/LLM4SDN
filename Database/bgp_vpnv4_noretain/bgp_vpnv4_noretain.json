{
  "nodes": [
    { "id": "r1", "type": "router", "as": 65500 },
    { "id": "r2", "type": "router", "as": 65501 },
    { "id": "s1", "type": "switch" },
    { "id": "s2", "type": "switch" },
    { "id": "s3", "type": "switch" },
    { "id": "s4", "type": "switch" },
    { "id": "s5", "type": "switch" },
    { "id": "s6", "type": "switch" },
    { "id": "s7", "type": "switch" },
    { "id": "s8", "type": "switch" }
  ],
  "links": [
