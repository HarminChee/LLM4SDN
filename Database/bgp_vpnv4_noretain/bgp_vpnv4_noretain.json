    { "source": "r1", "target": "s7", "interfaces": ["r1:eth3", "s7:port1"] },
    { "source": "r2", "target": "s8", "interfaces": ["r2:eth3", "s8:port1"] }
  ],
  "vrfs": [
    {
      "router": "r1",
      "vrfs": [
        { "name": "vrf1", "table_id": 10, "interfaces": ["r1-eth1"] },
        { "name": "vrf2", "table_id": 20, "interfaces": ["r1-eth2"] },
        { "name": "vrf3", "table_id": 30, "interfaces": ["r1-eth3"] },
        { "name": "vrf4", "table_id": 40, "interfaces": ["r1-eth4"] }
      ]
    },
    {
      "router": "r2",
      "vrfs": [
