{
  "nodes": {
    "ce1": {
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.1/24"
        }
      }
    },
    "ce2": {
      "interfaces": {
        "eth0": {
          "connected_to": "s2",
          "ipv4": "192.168.2.2/24"
        }
      }
    },
    "pe1": {
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "vrf": "Customer",
          "ipv4": "192.168.1.2/24"
        },
        "eth1": {
          "connected_to": "s2",
          "vrf": "Service",
          "ipv4": "192.168.2.1/24"
        },
        "eth2": {
          "connected_to": "s3",
          "mpls_enabled": true
        },
        "eth3": {
          "connected_to": "s4",
          "vrf": "Customer"
        }
      },
      "vrf_instances": {
        "Customer": {
          "table_id": 1001,
          "interfaces": ["eth0", "eth3"]
        },
        "Service": {
          "table_id": 1002,
          "interfaces": ["eth1"]
        }
      }
    },
    "rr1": {
      "interfaces": {
        "eth0": {
          "connected_to": "s3",
          "mpls_enabled": true
        }
      }
    }
  },
  "switches": {
    "s1": {
      "connected_nodes": ["ce1", "pe1"]
    },
    "s2": {
      "connected_nodes": ["ce2", "pe1"]
    },
    "s3": {
      "connected_nodes": ["pe1", "rr1"]
    },
    "s4": {
      "connected_nodes": ["pe1"]
    }
  }
}
