{
  "metadata": {
    "script_name": "pim_multicast_test.py",
    "description": "Topology with a central switch connecting 4 routers and 2 FRR nodes sending IGMP join requests.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "pimd.conf",
        "ospfd.conf"
      ],
      "r2": [
        "zebra.conf",
        "pimd.conf",
        "ospfd.conf"
      ],
      "r3": [
        "zebra.conf",
        "pimd.conf"
      ],
      "r4": [
        "zebra.conf",
        "pimd.conf"
      ],
      "r5": [
        "zebra.conf",
        "pimd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.4.2/24"
        }
      },
      "ospf": {
        "area": "0.0.0.0",
        "dead_interval": 4,
        "hello_interval": 1
      },
      "pim": {
        "hello_timer": 1,
        "hold_time": 3,
        "interfaces": {
          "eth0": {
            "vrf": "default",
            "ip": "10.0.4.2/24"
          }
        },
        "groups": {
          "224.0.0.0/8": {
            "source": "10.0.0.1",
            "group": "224.1.1.1",
            "rp_addr": "192.168.1.254"
          }
        },
        "igmp": {
          "interfaces": {
            "vlan2501": {
              "ip": "10.1.1.1/24",
              "version": 2,
              "join": [
                "225.1.1.1",
                "227.1.1.1"
              ]
            }
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.4.3/24"
        }
      },
      "ospf": {
        "area": "0.0.0.0",
        "dead_interval": 4,
        "hello_interval": 1
      },
      "pim": {
        "hello_timer": 1,
        "hold_time": 3,
        "interfaces": {
          "eth0": {
            "vrf": "default",
            "ip": "10.0.4.3/24"
          }
        },
        "groups": {
          "224.0.0.0/8": {
            "source": "10.0.0.2",
            "group": "224.1.1.1",
            "rp_addr": "192.168.1.254"
          }
        },
        "igmp": {
          "interfaces": {
            "vlan2501": {
              "ip": "10.1.1.2/24",
              "version": 2,
              "join": [
                "225.1.1.1",
                "227.1.1.2"
              ]
            }
          }
        }
      }
    },
    "r4": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "r5",
          "ipv4": "10.0.3.1/24"
        },
        "eth1": {
          "connected_to": "s1",
          "ipv4": "10.0.1.2/24"
        },
        "eth2": {
          "connected_to": "s1",
          "ipv4": "10.0.2.2/24"
        }
      },
      "pim": {
        "groups": {
          "224.0.0.0/8": {
            "rp": "r4",
            "group_addr_range": [
              "225.1.1.1/32",
              "225.1.1.2/32",
              "227.1.1.1/32",
              "227.1.1.2/32"
            ]
          }
        }
      }
    },
    "r5": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "r4",
          "ipv4": "10.0.3.2/24"
        },
        "lo": {
          "ipv4": "224.0.0.1/24"
        },
        "eth1": {
          "connected_to": "i2",
          "ipv4": "10.0.0.2/24"
        }
      },
      "igmp": {
        "interfaces": {
          "eth1": {
            "version": "2",
            "join": [
              "225.1.1.1",
              "227.1.1.2"
            ]
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2",
        "r4"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "ipv4_subnet": "10.0.4.0/24"
    },
    {
      "source": "r1",
      "target": "s1",
      "interface_source": "r1-eth0",
      "interface_target": "s1",
      "ipv4": "10.0.1.1/24"
    },
    {
      "source": "r2",
      "target": "s1",
      "interface_source": "r2-eth0",
      "interface_target": "s1",
      "ipv4": "10.0.2.2/24"
    },
    {
      "source": "r4",
      "target": "r5",
      "interface_source": "r4-eth0",
      "interface_target": "r5-eth0",
      "ipv4_subnet": "10.0.3.0/24"
    },
    {
      "source": "r4",
      "target": "s1",
      "interface_source": "r4-eth1",
      "interface_target": "s1",
      "ipv4": "10.0.1.2/24"
    },
    {
      "source": "r4",
      "target": "s1",
      "interface_source": "r4-eth2",
      "interface_target": "s1",
      "ipv4": "10.0.2.2/24"
    }
  ]
}