{
  "metadata": {
    "script_name": "test_static_route.py",
    "description": "Test static route functionality with 1 router connected to a switch.",
    "conf_files": {
      "r1": [
        "frr.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "frr": {
        "static_routes": [
          {
            "route": "11.11.11.11/32",
            "next_hop": "1.1.1.2"
          }
        ],
        "debug": [
          "mgmt client frontend",
          "mgmt client backend",
          "mgmt backend frontend"
        ]
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    }
  }
}