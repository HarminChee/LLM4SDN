{
  "metadata": {
    "script_name": "test_bgp_prefix_sid2.py",
    "description": "Test BGP topology with EBGP on prefix-sid",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "zebra": {},
      "bgp": {}
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "peer1"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "peer1",
      "interface_source": "r1-eth0",
      "interface_target": "peer1-eth0",
      "ipv4_subnet": "10.0.0.0/24"
    }
  ]
}