{
  "metadata": {
    "script_name": "test_bgp_extcommunity_none.py",
    "description": "Test if route-map extcommunity none works with topology including 2 routers and 1 switch using BGP and Zebra configurations.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "zebra": {},
      "bgp": {
        "local_as": 65001,
        "address_families": {
          "ipv4": {
            "neighbors": {
              "192.168.1.2": {
                "route_map": "r2",
                "direction": "in"
              }
            }
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "zebra": {},
      "bgp": {
        "local_as": 65001
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0"
    }
  ]
}