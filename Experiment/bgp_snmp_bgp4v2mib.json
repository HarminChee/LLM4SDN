    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth0",
      "interface_target": "r3-eth0",
      "ipv4_subnet": "192.168.12.0/24",
      "bgp_neighbors": true
    },
    {
      "source": "r3",
      "target": "rr",
      "interface_source": "r3-eth0",
      "interface_target": "rr-eth0",
      "ipv4_subnet": "192.168.12.0/24",
      "bgp_neighbors": true
    },
    {
      "source": "rr",
      "target": "r1",
      "interface_source": "rr-eth0",
      "interface_target": "r1-eth0",
      "ipv4_subnet": "192.168.12.0/24",
      "bgp_neighbors": true
    }
  ]
}