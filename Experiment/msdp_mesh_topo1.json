{
  "metadata": {
    "script_name": "test_msdp_mesh_topo1.py",
    "description": "Test the FRR PIM MSDP mesh groups with 4 switches and 3 routers. Includes OSPF, BGP, and PIM configurations.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf",
        "ospfd.conf",
        "pimd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf",
        "ospfd.conf",
        "pimd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf",
        "ospfd.conf",
        "pimd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s3",
          "ipv4": "192.168.10.1/24"
        }
      },
      "bgp": {},
      "ospf": {},
      "zebra": {},
      "pim": {}
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s2"
        }
      },
      "bgp": {},
      "ospf": {},
      "zebra": {},
      "pim": {}
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2"
        },
        "eth1": {
          "connected_to": "s4",
          "ipv4": "192.168.30.1/24"
        }
      },
      "bgp": {},
      "ospf": {},
      "zebra": {},
      "pim": {}
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "h1"
      ]
    },
    "s4": {
      "type": "switch",
      "connected_nodes": [
        "r3",
        "h2"
      ]
    }
  },
  "hosts": {
    "h1": {
      "type": "host",
      "interfaces": {
        "eth0": {
          "connected_to": "s3",
          "ipv4": "192.168.10.2/24"
        },
        "default_gateway": "192.168.10.1"
      }
    },
    "h2": {
      "type": "host",
      "interfaces": {
        "eth0": {
          "connected_to": "s4",
          "ipv4": "192.168.30.2/24"
        },
        "default_gateway": "192.168.30.1"
      }
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "protocols": [
        "ospf"
      ]
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth1",
      "interface_target": "r3-eth0",
      "protocols": [
        "ospf"
      ]
    },
    {
      "source": "r1",
      "target": "h1",
      "interface_source": "r1-eth1",
      "interface_target": "h1-eth0",
      "protocols": []
    },
    {
      "source": "r3",
      "target": "h2",
      "interface_source": "r3-eth1",
      "interface_target": "h2-eth0",
      "protocols": []
    }
  ]
}