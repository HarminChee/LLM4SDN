{
  "metadata": {
    "script_name": "test_evpn-pim_topo1.py",
    "description": "Topology with 4 switches (sw1, sw2, sw3, sw4) and 5 routers (spine, leaf1, leaf2, host1, host2). EVPN and PIM testing.",
    "conf_files": {
      "spine": [
        "zebra.conf",
        "bgpd.conf",
        "pimd.conf"
      ],
      "leaf1": [
        "zebra.conf",
        "bgpd.conf",
        "pimd.conf"
      ],
      "leaf2": [
        "zebra.conf",
        "bgpd.conf",
        "pimd.conf"
      ],
      "host1": [
        "zebra.conf",
        "bgpd.conf",
        "pimd.conf"
      ],
      "host2": [
        "zebra.conf",
        "bgpd.conf",
        "pimd.conf"
      ]
    }
  },
  "routers": {
    "spine": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1"
        },
        "eth1": {
          "connected_to": "sw2"
        }
      },
      "zebra": {},
      "bgp": {},
      "pim": {}
    },
    "leaf1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1"
        },
        "eth1": {
          "connected_to": "sw3"
        }
      },
      "zebra": {},
      "bgp": {},
      "pim": {}
    },
    "leaf2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw2"
        },
        "eth1": {
          "connected_to": "sw4"
        }
      },
      "zebra": {},
      "bgp": {},
      "pim": {}
    },
    "host1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw3"
        }
      },
      "zebra": {},
      "bgp": {},
      "pim": {}
    },
    "host2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw4"
        }
      },
      "zebra": {},
      "bgp": {},
      "pim": {}
    }
  },
  "switches": {
    "sw1": {
      "type": "switch",
      "connected_nodes": [
        "spine",
        "leaf1"
      ]
    },
    "sw2": {
      "type": "switch",
      "connected_nodes": [
        "spine",
        "leaf2"
      ]
    },
    "sw3": {
      "type": "switch",
      "connected_nodes": [
        "leaf1",
        "host1"
      ]
    },
    "sw4": {
      "type": "switch",
      "connected_nodes": [
        "leaf2",
        "host2"
      ]
    }
  },
  "links": [
    {
      "source": "spine",
      "target": "leaf1",
      "interface_source": "spine-eth0",
      "interface_target": "leaf1-eth0"
    },
    {
      "source": "spine",
      "target": "leaf2",
      "interface_source": "spine-eth1",
      "interface_target": "leaf2-eth0"
    },
    {
      "source": "leaf1",
      "target": "host1",
      "interface_source": "leaf1-eth1",
      "interface_target": "host1-eth0"
    },
    {
      "source": "leaf2",
      "target": "host2",
      "interface_source": "leaf2-eth1",
      "interface_target": "host2-eth0"
    }
  ]
}