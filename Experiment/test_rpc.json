{
  "metadata": {
    "script_name": "test_yang_notifications.py",
    "description": "Topology with 1 switch (s1) and 1 router (r1). Tests YANG Notifications with backend client.",
    "conf_files": {
      "r1": [
        "frr.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "mgmt": {
        "backend_adapter": "mgmtd-testc"
      },
      "rip": {
        "vrf": "testname",
        "clear_command": "clear ip rip vrf testname"
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    }
  },
  "links": []
}