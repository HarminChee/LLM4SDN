{
  "metadata": {
    "script_name": "test_bgp_multiview_topo1.py",
    "description": "Simple FRR Route-Server Test with multiple BGP peers connected to a single router through switches.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "peer1": [
        "exabgp.env"
      ],
      "peer2": [
        "exabgp.env"
      ],
      "peer3": [
        "exabgp.env"
      ],
      "peer4": [
        "exabgp.env"
      ],
      "peer5": [
        "exabgp.env"
      ],
      "peer6": [
        "exabgp.env"
      ],
      "peer7": [
        "exabgp.env"
      ],
      "peer8": [
        "exabgp.env"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "stub": {
          "connected_to": "sw0"
        },
        "eth0": {
          "connected_to": "sw1",
          "ipv4": "172.16.1.254/24"
        }
      },
      "bgp": {
        "views": {
          "1": [
            "peer1",
            "peer2",
            "peer3"
          ],
          "2": [
            "peer4",
            "peer5"
          ],
          "3": [
            "peer6",
            "peer7",
            "peer8"
          ]
        }
      }
    }
  },
  "switches": {
    "sw0": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "sw1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "peer1",
        "peer2",
        "peer3",
        "peer4",
        "peer5",
        "peer6",
        "peer7",
        "peer8"
      ]
    }
  },
  "peers": {
    "peer1": {
      "type": "exabgp_peer",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1",
          "ipv4": "172.16.1.1/24"
        }
      },
      "bgp": {
        "local_as": 65001,
        "remote_as": 65001,
        "neighbor": {
          "ipv4": "172.16.1.254"
        }
      }
    },
