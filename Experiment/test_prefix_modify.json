{
  "metadata": {
    "script_name": "test_prefix_lists.py",
    "description": "Topology with 4 routers (r1, r2, r3, r4) testing prefix-list functionality. r1, r2, r3 are in IBGP and r3, r4 are in EBGP",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r4": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "r2",
          "ipv4": "192.168.0.1/24"
        },
        "eth1": {
          "connected_to": "r3",
          "ipv4": "192.168.1.1/24"
        }
      },
      "bgp": {
        "local_as": 100,
        "neighbors": {
          "r2": {
            "remote_as": 100,
            "ipv4_address": "192.168.0.2",
            "state": "Established"
          },
          "r3": {
            "remote_as": 100,
            "ipv4_address": "192.168.1.2",
            "state": "Established"
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "r1",
          "ipv4": "192.168.0.2/24"
        },
        "eth1": {
          "connected_to": "r3",
          "ipv4": "192.168.2.2/24"
        }
      },
      "bgp": {
        "local_as": 100,
        "neighbors": {
          "r1": {
            "remote_as": 100,
            "ipv4_address": "192.168.0.1",
            "state": "Established"
          },
          "r3": {
            "remote_as": 100,
            "ipv4_address": "192.168.2.3",
            "state": "Established"
          }
        }
      },
      "static_routes": [
        {
          "network": "192.168.10.0/24",
          "no_of_ip": 1,
          "next_hop": "Null0"
        },
        {
          "network": "192.168.10.10/32",
          "no_of_ip": 1,
          "next_hop": "Null0"
        }
      ]
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "r1",
          "ipv4": "192.168.1.2/24"
        },
        "eth1": {
          "connected_to": "r2",
          "ipv4": "192.168.2.3/24"
        },
        "eth2": {
          "connected_to": "r4",
          "ipv4": "192.168.3.3/24"
        }
      },
      "bgp": {
        "local_as": 100,
        "neighbors": {
          "r1": {
            "remote_as": 100,
            "ipv4_address": "192.168.1.1",
            "state": "Established"
          },
          "r2": {
            "remote_as": 100,
            "ipv4_address": "192.168.2.2",
            "state": "Established"
          },
          "r4": {
            "remote_as": 200,
            "ipv4_address": "192.168.3.4",
            "state": "Established"
          }
        }
      },
      "prefix_lists": {
        "ipv4": {
          "pf_list_1": [
            {
              "seqid": "5",
              "network": "192.150.10.0/24",
              "action": "deny"
            },
            {
              "seqid": "10",
              "network": "192.168.10.0/24",
              "action": "permit"
            },
            {
              "seqid": "15",
              "network": "any",
              "action": "permit"
            }
          ]
        }
      },
      "route_maps": {
        "rmap_match_pf_1": [
          {
            "action": "permit",
            "match": {
              "ipv4": {
                "prefix_lists": "pf_list_1"
              }
            }
          }
        ]
      }
    },
    "r4": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "r3",
          "ipv4": "192.168.3.4/24"
        }
      },
      "bgp": {
        "local_as": 200,
        "neighbors": {
          "r3": {
            "remote_as": 100,
            "ipv4_address": "192.168.3.3",
            "state": "Established"
          }
        }
      }
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "ipv4_subnet": "192.168.0.0/24",
      "bgp_neighbors": true
    },
    {
      "source": "r1",
      "target": "r3",
      "interface_source": "r1-eth1",
      "interface_target": "r3-eth0",
      "ipv4_subnet": "192.168.1.0/24",
      "bgp_neighbors": true
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth1",
      "interface_target": "r3-eth1",
      "ipv4_subnet": "192.168.2.0/24",
      "bgp_neighbors": true
    },
    {
      "source": "r3",
      "target": "r4",
      "interface_source": "r3-eth2",
      "interface_target": "r4-eth0",
      "ipv4_subnet": "192.168.3.0/24",
      "bgp_neighbors": true
    }
  ]
}