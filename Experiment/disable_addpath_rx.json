{
  "metadata": {
    "script_name": "test_bgp_disable_addpath_rx.py",
    "description": "Topology with 2 switches (s1, s2) and 4 routers (r1, r2, r3, r4). BGP AddPath RX direction test.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r4": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "local_as": null,
        "neighbors": {
          "r2": {
            "remote_as": null,
            "ipv4_address": "192.168.1.2",
            "state": "Established",
            "addPath": {
              "ipv4Unicast": {
                "txReceived": true,
                "rxReceived": true
              }
            },
            "addressFamilyInfo": {
              "ipv4Unicast": {
                "acceptedPrefixCounter": 2
              }
            }
          }
        }
      },
      "zebra": {}
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s2"
        }
      },
      "bgp": {
        "local_as": null,
        "neighbors": {
          "r1": {
            "remote_as": null,
            "ipv4_address": "192.168.1.1",
            "advertisedRoutes": {
              "172.16.16.254/32": {
                "addrPrefix": "172.16.16.254",
                "prefixLen": 32
              },
              "192.168.2.0/24": {
                "addrPrefix": "192.168.2.0",
                "prefixLen": 24
              }
            },
            "totalPrefixCounter": 2
          }
        }
      },
      "zebra": {}
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2"
        }
      },
      "bgp": {
        "local_as": null,
        "neighbors": {}
      },
      "zebra": {}
    },
    "r4": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2"
        }
      },
      "bgp": {
        "local_as": null,
        "neighbors": {}
      },
      "zebra": {}
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3",
        "r4"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0",
      "interface_target": "eth0",
      "protocols": [
        "bgp"
      ],
      "ipv4_subnet": "192.168.1.0/24"
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "eth1",
      "interface_target": "eth0",
      "ipv4_subnet": "192.168.2.0/24"
    },
    {
      "source": "r2",
      "target": "r4",
      "interface_source": "eth1",
      "interface_target": "eth0",
      "ipv4_subnet": "192.168.3.0/24"
    }
  ]
}