{
  "metadata": {
    "script_name": "bgp_local_asn_vrf_topo1.py",
    "description": "Verify BGP Local AS functionality using VRFs and route maps with AS-prepend commands.",
    "conf_files": {
      "r1": [],
      "r2": [],
      "r3": [],
      "r4": []
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.0.1/32",
          "ipv6": "10::1/128"
        }
      },
      "bgp": {
        "local_as": 100
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2"
        }
      },
      "bgp": {
        "local_as": 200,
        "address_family": {
          "ipv4": {
            "unicast": {
              "redistribute": [
                {
                  "redist_type": "static"
                }
              ],
              "neighbor": {
                "r3": {
                  "dest_link": {
                    "r2": {
                      "local_asn": {
                        "remote_as": "110"
                      }
                    }
                  }
                }
              }
            }
          },
          "ipv6": {
            "unicast": {
              "redistribute": [
                {
                  "redist_type": "static"
                }
              ],
              "neighbor": {
                "r3": {
                  "dest_link": {
                    "r2": {
                      "local_asn": {
                        "remote_as": "110"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2"
        },
        "eth1": {
          "connected_to": "s3"
        }
      },
      "bgp": {
        "local_as": 300,
        "vrf": "BLUE",
        "address_family": {
          "ipv4": {
            "unicast": {
              "import": {
                "vrf": "default"
              },
              "neighbor": {
                "r2": {
                  "dest_link": {
                    "r3": {
                      "local_asn": {
                        "local_as": "110"
                      }
                    }
                  }
                },
                "r4": {
                  "dest_link": {
                    "r3": {
                      "local_asn": {
                        "local_as": "110",
                        "no_prepend": true,
                        "replace_as": true
                      }
                    }
                  }
                }
              },
              "route_maps": [
                {
                  "name": "ASP_ipv4",
                  "direction": "out",
                  "set": {
                    "path": {
                      "as_num": "1000 1000",
                      "as_action": "prepend"
                    }
                  }
                }
              ]
            }
          },
          "ipv6": {
            "unicast": {
              "import": {
                "vrf": "default"
              },
              "neighbor": {
                "r2": {
                  "dest_link": {
                    "r3": {
                      "local_asn": {
                        "local_as": "110"
                      }
                    }
                  }
                },
                "r4": {
                  "dest_link": {
                    "r3": {
                      "local_asn": {
                        "local_as": "110",
                        "no_prepend": true,
                        "replace_as": true
                      }
                    }
                  }
                }
              },
              "route_maps": [
                {
                  "name": "ASP_ipv6",
                  "direction": "out",
                  "set": {
                    "path": {
                      "as_num": "1000 1000",
                      "as_action": "prepend"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "r4": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s3"
        }
      },
      "bgp": {
        "local_as": 400,
        "vrf": "BLUE",
        "address_family": {
          "ipv4": {
            "unicast": {
              "redistribute": [
                {
                  "redist_type": "static"
                },
                {
                  "redist_type": "connected"
                },
                {
                  "vrf": "default"
                }
              ],
              "neighbor": {
                "r3": {
                  "dest_link": {
                    "r4": {
                      "local_asn": {
                        "remote_as": "110"
                      }
                    }
                  }
                }
              }
            }
          },
          "ipv6": {
            "unicast": {
              "redistribute": [
                {
                  "redist_type": "static"
                },
                {
                  "redist_type": "connected"
                },
                {
                  "vrf": "default"
                }
              ],
              "neighbor": {
                "r3": {
                  "dest_link": {
                    "r4": {
                      "local_asn": {
                        "remote_as": "110"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r3",
        "r4"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "ipv4_subnet": "10.1.1.0/24",
      "ipv6_subnet": "10:1::1:0/64",
      "bgp_neighbors": true
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth1",
      "interface_target": "r3-eth0",
      "ipv4_subnet": "10.1.2.0/24",
      "ipv6_subnet": "10:2::1:0/64",
      "bgp_neighbors": true
    },
    {
      "source": "r3",
      "target": "r4",
      "interface_source": "r3-eth1",
      "interface_target": "r4-eth0",
      "ipv4_subnet": "10.1.3.0/24",
      "ipv6_subnet": "10:3::1:0/64",
      "bgp_neighbors": true
    }
  ]
}