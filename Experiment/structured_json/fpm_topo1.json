{
  "metadata": {
    "script_name": "test_fpm_topo1.py",
    "description": "Topology with 1 switch (sw1) and 1 router (r1). Testing FPM module. Inferred from Python code.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "sharpd.conf",
        "fpm_stub.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1"
        }
      },
      "zebra": {
        "config_file": "zebra.conf",
        "additional_flags": "-M dplane_fpm_nl"
      },
      "sharp": {
        "config_file": "sharpd.conf"
      },
      "fpm_listener": {
        "config_file": "fpm_stub.conf"
      }
    }
  },
  "switches": {
    "sw1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "sw1",
      "interface_source": "r1-eth0",
      "interface_target": "sw1"
    }
  ]
}