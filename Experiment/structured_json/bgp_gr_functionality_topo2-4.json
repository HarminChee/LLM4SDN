{
  "metadata": {
    "script_name": "bgp_gr_topojson_topo2.py",
    "description": "Topology with 7 routers (r1 to r7) using BGP and Graceful Restart.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r4": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r5": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r6": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r7": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "r2",
          "ipv4": "192.168.1.1/24",
          "ipv6": "fd00:0:0:1::1/64"
        }
      },
      "bgp": {
        "graceful_restart": {
          "helper": true
        },
        "address_family": {
          "ipv4": {
            "unicast": {
              "neighbors": {
                "r3": {
                  "graceful_restart_helper": true
                },
                "r7": {
                  "graceful_restart_helper": true
                }
              }
            }
          },
          "ipv6": {
            "unicast": {
              "neighbors": {
