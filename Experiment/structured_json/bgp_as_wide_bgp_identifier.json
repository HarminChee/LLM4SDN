{
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "192.168.255.1/24"
        }
      },
      "bgp": {

        "neighbors": {
          "r2_s1": {
            "ipv4_address": "192.168.255.2"
          },
          "r3_s1": {
            "ipv4_address": "192.168.255.3"
          }
        }
      }
    },

    "r2": {
      "type": "router",
      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "192.168.255.2/24"
        }
      },
      "bgp": {

        "neighbors": {
          "r1_s1": {
            "ipv4_address": "192.168.255.1"
          },
          "r3_s1": {
            "ipv4_address": "192.168.255.3"
          }
        }
      }
    },

    "r3": {
      "type": "router",
      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "192.168.255.3/24"
        }
      },
      "bgp": {

        "neighbors": {
          "r1_s1": {
            "ipv4_address": "192.168.255.1"
          },
          "r2_s1": {
            "ipv4_address": "192.168.255.2"
          }
        }
      }
    }
  },

  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2",
        "r3"
      ]
    }
  },

  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0_s1",
      "interface_target": "eth0_s1",
      "ipv4_subnet": "192.168.255.0/24",
      "protocols": ["bgp"]
    },
    {
      "source": "r1",
      "target": "r3",
      "interface_source": "eth0_s1",
      "interface_target": "eth0_s1",
      "ipv4_subnet": "192.168.255.0/24",
      "protocols": ["bgp"]
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "eth0_s1",
      "interface_target": "eth0_s1",
      "ipv4_subnet": "192.168.255.0/24",
      "protocols": ["bgp"]
    }
  ],

  "metadata": {
    "script_name": "test_bgp_as_wide_bgp_identifier.py",
    "description": "3 routers (r1,r2,r3) all connected to the same LAN s1 with addresses 192.168.255.1/24 .2/24 .3/24. Script checks as-well wide BGP identifier issues. Possibly we run iBGP among them or something that triggers Bad BGP ID for iBGP. eBGP unaffected.",
    "conf_files": {
      "r1": ["zebra.conf", "bgpd.conf"],
      "r2": ["zebra.conf", "bgpd.conf"],
      "r3": ["zebra.conf", "bgpd.conf"]
    }
  }
}
