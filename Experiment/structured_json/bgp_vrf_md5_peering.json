      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.0.1/24",
          "vrf": "public"
        }
      },
      "bgp": {
        "local_as": 64512,
        "neighbors": {
          "peer1": {
            "remote_as": 64513,
            "ipv4_address": "10.0.0.2",
            "vrf": "public",
            "state": "Established"
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "peer1"
      ]
    }
  }
}