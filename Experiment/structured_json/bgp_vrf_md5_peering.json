{
  "metadata": {
    "script_name": "test_bgp_vrf_md5.py",
    "description": "Test if BGP MD5 basic authentication works per-VRF.",
    "conf_files": {
      "r1": [
        "r1/zebra.conf",
        "r1/bgpd.conf"
      ]
    }
  },
  "routers": {
