{
  "metadata": {
    "script_name": "bgp_bfd_down_cease_notification.py",
    "description": "Two routers (r1, r2) connected via switch s1, running BGP + BFD. Test that a 'Cease/BFD Down' notification is sent when BFD fails on r2.",
    "conf_files": {
      "r1": ["zebra.conf", "bgpd.conf", "bfdd.conf"],
      "r2": ["zebra.conf", "bgpd.conf", "bfdd.conf"]
    }
  },

  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.255.1/24"
        }
      },
      "zebra": {
      },
      "bgp": {
        "local_as": 65001,
        "neighbors": {
          "192.168.255.2": {
            "remote_as": 65002,
            "bfd_enabled": true,
            "status_expected": "Established"
          }
        }
      },
      "bfd": {
      }
    },

    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.255.2/24"
        }
      },
      "zebra": {
      },
      "bgp": {
        "local_as": 65002,
        "neighbors": {
          "192.168.255.1": {
            "remote_as": 65001,
            "bfd_enabled": true,
            "status_expected": "Established"
          }
        }
      },
      "bfd": {
      }
    }
  },

  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": ["r1", "r2"]
    }
  },

  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0",
      "interface_target": "eth0",
      "ipv4_subnet": "192.168.255.0/24",
      "bgp_neighbors": true,
      "bfd": true
    }
  ]
}
