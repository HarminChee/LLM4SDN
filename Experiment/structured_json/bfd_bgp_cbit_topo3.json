{
  "metadata": {
    "script_name": "test_bfd_bgp_cbit_topo3.py",
    "description": "Topology with 2 switches (s1, s2) and 3 routers (r1, r2, r3). BFD + BGP tested. This JSON is an inferred structure from the original Python code. Actual IP/ASNs partially guessed.",
    "conf_files": {
      "r1": ["zebra.conf", "bfdd.conf", "bgpd.conf"],
      "r2": ["zebra.conf", "bfdd.conf", "bgpd.conf"],
      "r3": ["zebra.conf", "bfdd.conf", "bgpd.conf"]
    }
  },

  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv6": "2001:db8:4::1/64"
        }
      },
      "bfd": {
        "peers": {
          "r2": {
            "session_mode": "multihop",
            "c_bit": true,
            "status_expected": "up"
          }
        }
      },
      "bgp": {
        "local_as": 101, 
        "neighbors": {
          "r2": {
            "remote_as": 101, 
            "ipv6_address": "2001:db8:4::2",
            "state": "Established"
          }
        }
      }
    },

    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv6": "2001:db8:3::2/64" 
        },
        "eth1": {
          "connected_to": "s2",
          "ipv6": "2001:db8:4::2/64" 
        }
      },
      "bfd": {
        "peers": {
          "r1": {
            "session_mode": "multihop",
            "c_bit": true,
            "status_expected": "up"
          },
          "r3": {
            "session_mode": "multihop",
            "c_bit": true,
            "status_expected": "up"
          }
        }
      },
      "bgp": {
        "local_as": 101,
        "neighbors": {
          "r1": {
            "remote_as": 101,
            "ipv6_address": "2001:db8:4::1",
            "state": "Established"
          },
          "r3": {
            "remote_as": 101,
            "ipv6_address": "2001:db8:5::2"
          }
        }
      }
    },

    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2",
          "ipv6": "2001:db8:5::1/64"
        }
      },
      "bfd": {
        "peers": {
          "r2": {
            "session_mode": "multihop",
            "c_bit": true,
            "status_expected": "up"
          }
        }
      },
      "bgp": {
        "local_as": 101,
        "neighbors": {
          "r2": {
            "remote_as": 101,
            "ipv6_address": "2001:db8:5::2",
            "state": "Established"
          }
        }
      }
    }
  },

  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": ["r1", "r2"]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": ["r2", "r3"]
    }
  },

  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "ipv6_subnet": "2001:db8:3::/64",
      "bfd": true,
      "bgp_neighbors": true
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth1",
      "interface_target": "r3-eth0",
      "ipv6_subnet": "2001:db8:4::/64",
      "bfd": true,
      "bgp_neighbors": true
    }
  ]
}
