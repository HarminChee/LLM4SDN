{
  "metadata": {
    "script_name": "BGP_VRF_Lite_Pytest_Script",
    "description": "Verifies BGP VRF Lite functionalities, including ECMP for imported routes from different VRFs and selection of locally imported routes as best paths over eBGP imported routes.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.1/24",
          "ipv6": "2001:db8::1/64"
        },
        "eth1": {
          "connected_to": "s2",
          "ipv4": "192.168.2.1/24",
          "ipv6": "2001:db8:1::1/64"
        }
      },
      "bgp": {
        "local_as": 1,
        "vrfs": [
          "RED",
          "BLUE"
        ],
        "address_family": {
          "ipv4": {
            "unicast": {
              "import": {
                "vrf": "RED"
              },
              "maximum_paths": {
                "ebgp": 2
              }
            }
          },
          "ipv6": {
            "unicast": {
              "import": {
                "vrf": "GREEN"
              },
              "maximum_paths": {
                "ebgp": 2
              }
            }
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2",
          "ipv4": "192.168.2.2/24",
          "ipv6": "2001:db8:1::2/64"
        },
        "eth1": {
          "connected_to": "s3",
          "ipv4": "192.168.3.1/24",
          "ipv6": "2001:db8:2::1/64"
        }
      },
      "bgp": {
        "local_as": 2,
        "vrfs": [
          "RED",
          "GREEN"
        ],
        "address_family": {
          "ipv4": {
            "unicast": {
              "import": {
                "vrf": "RED"
              },
              "maximum_paths": {
                "ebgp": 2
              }
            }
          },
          "ipv6": {
            "unicast": {
              "import": {
                "vrf": "GREEN"
              },
              "maximum_paths": {
                "ebgp": 2
              }
            }
          }
        }
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s3",
          "ipv4": "192.168.3.2/24",
          "ipv6": "2001:db8:2::2/64"
        },
        "eth1": {
          "connected_to": "s4",
          "ipv4": "192.168.4.1/24",
          "ipv6": "2001:db8:3::1/64"
        }
      },
      "bgp": {
        "local_as": 3,
        "vrfs": [
          "RED",
          "GREEN"
        ],
        "address_family": {
          "ipv4": {
            "unicast": {
              "import": {
                "vrf": "GREEN"
              },
              "maximum_paths": {
                "ebgp": 2
              }
            }
          },
          "ipv6": {
            "unicast": {
              "import": {
                "vrf": "GREEN"
              },
              "maximum_paths": {
                "ebgp": 2
              }
            }
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3"
      ]
    },
    "s4": {
      "type": "switch",
      "connected_nodes": [
        "r3"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth1",
      "interface_target": "r2-eth0",
      "ipv4_subnet": "192.168.2.0/24",
      "ipv6_subnet": "2001:db8:1::/64",
      "bgp": true
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth1",
      "interface_target": "r3-eth0",
      "ipv4_subnet": "192.168.3.0/24",
      "ipv6_subnet": "2001:db8:2::/64",
      "bgp": true
    }
  ]
}