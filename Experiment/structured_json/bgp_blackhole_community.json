{
  "metadata": {
    "script_name": "test_bgp_blackhole_community.py",
    "description": "Four routers (r1, r2, r3, r4) interconnected by three switches (s1, s2, s3). Testing that prefix 172.16.255.254/32 tagged with communities [blackhole, noExport] is not advertised to eBGP peers (r3) but is advertised to iBGP peers (r1, r4) within local AS.",
    "conf_files": {
      "r1": ["zebra.conf", "bgpd.conf"],
      "r2": ["zebra.conf", "bgpd.conf"],
      "r3": ["zebra.conf", "bgpd.conf"],
      "r4": ["zebra.conf", "bgpd.conf"]
    }
  },

  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.1.1/24"
        }
      },
      "bgp": {
        "local_as": 65200,
        "neighbors": {
          "10.0.1.2": {
            "remote_as": 65200,
            "session_type": "iBGP",
            "description": "iBGP to r2 via s1"
          }
        },
        "routes_originated": [
          {
            "prefix": "172.16.255.254/32",
            "community": ["blackhole", "noExport"],
            "note": "Example prefix tagged with BLACKHOLE + noExport"
          }
        ]
      }
    },

    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.1.2/24"
        },
        "eth1": {
          "connected_to": "s2",
          "ipv4": "10.0.2.2/24"
        },
        "eth2": {
          "connected_to": "s3",
          "ipv4": "10.0.3.2/24"
        }
      },
      "bgp": {
        "local_as": 65200,
        "neighbors": {
          "10.0.1.1": {
            "remote_as": 65200,
            "session_type": "iBGP",
            "description": "iBGP to r1"
          },
          "10.0.2.3": {
            "remote_as": 65300,
            "session_type": "eBGP",
            "description": "eBGP to r3 (external AS). BLACKHOLE prefix shouldn't be advertised here"
          },
          "10.0.3.4": {
            "remote_as": 65200,
            "session_type": "iBGP",
            "description": "iBGP to r4"
          }
        },
        "policy": {
          "blackhole_community_handling": {
            "prefix": "172.16.255.254/32",
            "communities": ["blackhole", "noExport"],
            "advertise_to_iBGP": true,
            "advertise_to_eBGP": false,
            "note": "Implements the logic tested by the script"
          }
        }
      }
    },

    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2",
          "ipv4": "10.0.2.3/24"
        }
      },
      "bgp": {
        "local_as": 65300,
        "neighbors": {
          "10.0.2.2": {
            "remote_as": 65200,
            "session_type": "eBGP",
            "description": "eBGP with r2, shouldn't receive blackhole prefix"
          }
        }
      }
    },

    "r4": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s3",
          "ipv4": "10.0.3.4/24",
          "ipv6_linklocal": "fe80::202:ff:fe00:99"
        }
      },
      "bgp": {
        "local_as": 65200,
        "neighbors": {
          "10.0.3.2": {
            "remote_as": 65200,
            "session_type": "iBGP",
            "description": "iBGP with r2"
          }
        }
      },
      "routes_received": {
        "notes": "Script checks next-hop validity with route-map rewriting to fe80::202:ff:fe00:99"
      }
    }
  },

  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": ["r1", "r2"]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": ["r2", "r3"]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": ["r2", "r4"]
    }
  },

  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0",
      "interface_target": "eth0",
      "ipv4_subnet": "10.0.1.0/24",
      "bgp_neighbors": true,
      "session_type": "iBGP"
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "eth1",
      "interface_target": "eth0",
      "ipv4_subnet": "10.0.2.0/24",
      "bgp_neighbors": true,
      "session_type": "eBGP"
    },
    {
      "source": "r2",
      "target": "r4",
      "interface_source": "eth2",
      "interface_target": "eth0",
      "ipv4_subnet": "10.0.3.0/24",
      "bgp_neighbors": true,
      "session_type": "iBGP"
    }
  ]
}
