{
  "metadata": {
    "script_name": "test_bfd_profiles_topo1.py",
    "description": "Topology with 6 routers (r1..r6) & 5 switches (s1..s5). BFD used for all links; also BGP/ISIS/OSPF/OSPF6 on certain pairs. Inferred from the Python code and references to .conf files.",
    "conf_files": {
      "r1": ["bfdd.conf", "bgpd.conf?", "isisd.conf?", "ospfd.conf?", "ospf6d.conf?", "zebra.conf?"],
      "r2": ["bfdd.conf", "bgpd.conf", "isisd.conf?", "ospfd.conf?", "ospf6d.conf?", "zebra.conf?"],
      "r3": ["bfdd.conf", "bgpd.conf", "isisd.conf", "ospfd.conf?", "ospf6d.conf?", "zebra.conf?"],
      "r4": ["bfdd.conf", "bgpd.conf?", "isisd.conf", "ospfd.conf?", "ospf6d.conf", "zebra.conf?"],
      "r5": ["bfdd.conf", "bgpd.conf?", "isisd.conf?", "ospfd.conf?", "ospf6d.conf", "zebra.conf?"],
      "r6": ["bfdd.conf", "bgpd.conf?", "isisd.conf?", "ospfd.conf", "ospf6d.conf?", "zebra.conf?"]
    }
  },

  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "10.0.12.1/24"
        },
        "eth1_s5": {
          "connected_to": "s5",
          "ipv4": "10.0.16.1/24"
        }
      },
      "bfd": {
        "peers": {
          "r2": {"status_expected": "up"},
          "r6": {"status_expected": "up"}
        }
      },
      "ospf": {
        "neighbors": ["r6"],
        "router_id": "1.1.1.1"
      }
    },

    "r2": {
