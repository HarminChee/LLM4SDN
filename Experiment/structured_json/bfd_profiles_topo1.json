        }
      },
      "bfd": {
        "peers": {
          "r2": {"status_expected": "up"},
          "r4": {"status_expected": "up"}
        }
      },
      "bgp": {
        "local_as": 65003,
        "neighbors": {
          "r2": {
            "remote_as": 65002
          }
        }
      },
      "isis": {
        "area_id": "49.0001?",
        "neighbors": ["r4"]
      }
    },

    "r4": {
      "type": "router",
      "interfaces": {
        "eth0_s3": {
          "connected_to": "s3",
          "ipv4": "10.0.34.4/24"
