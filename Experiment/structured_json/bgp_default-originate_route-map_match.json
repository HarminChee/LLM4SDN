{
  "metadata": {
    "script_name": "test_bgp_default_originate",
    "description": "Test BGP default originate with match operations",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "neighbors": {
          "192.168.255.1": {
            "bgpState": "Established",
            "addressFamilyInfo": {
              "ipv4Unicast": {
                "acceptedPrefixCounter": 1
              }
            }
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "neighbors": {
          "192.168.255.1": {
            "bgpState": "Established",
            "addressFamilyInfo": {
              "ipv4Unicast": {
                "acceptedPrefixCounter": 1
              }
            }
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    }
  }
}