{
  "metadata": {
    "script_name": "test_bgp_confed1.py",
    "description": "Test the FRR BGP confederations with AS member same as confederation Id, verify BGP prefixes and path distribution",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "isisd.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "isisd.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "isisd.conf",
        "bgpd.conf"
      ],
      "r4": [
        "zebra.conf",
        "isisd.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s2"
        }
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2"
        },
        "eth1": {
          "connected_to": "s3"
        }
      }
    },
    "r4": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s3"
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r3",
        "r4"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0"
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth1",
      "interface_target": "r3-eth0"
    },
    {
      "source": "r3",
      "target": "r4",
      "interface_source": "r3-eth1",
      "interface_target": "r4-eth0"
    }
  ]
}