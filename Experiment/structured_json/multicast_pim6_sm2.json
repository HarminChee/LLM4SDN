{
  "metadata": {
    "script_name": "test_multicast_pim6.py",
    "description": "Testing multicast PIM6 with multiple routers and validating BGP convergence and PIM6 configurations.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "pim6d.conf"
      ],
      "r2": [
        "zebra.conf",
        "pim6d.conf"
      ],
      "r3": [
        "zebra.conf",
        "pim6d.conf"
      ],
      "r4": [
        "zebra.conf",
        "pim6d.conf"
      ],
      "r5": [
        "zebra.conf",
        "pim6d.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv6": "2001:db8::1/128"
        },
        "eth1": {
          "connected_to": "s2",
          "ipv6": "2001:db8::2/128"
        }
      },
      "pim6": {
        "enabled": true,
        "rp": {
          "group_range": [
            "ffaa::1/128",
            "ffaa::2/128",
            "ffaa::3/128",
            "ffaa::4/128",
            "ffaa::5/128"
          ]
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2",
          "ipv6": "2001:db8::3/128"
        },
        "eth1": {
          "connected_to": "s3",
          "ipv6": "2001:db8::4/128"
        }
      },
      "pim6": {
        "enabled": true
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s3",
          "ipv6": "2001:db8::5/128"
        },
        "eth1": {
          "connected_to": "s4",
          "ipv6": "2001:db8::6/128"
        }
      },
      "pim6": {
        "enabled": true
      }
    },
    "r4": {
      "type": "router",
      "interfaces": {
        "lo": {
          "ipv6": "2001:db8::7/128"
        }
      },
      "pim6": {
        "enabled": true
      }
    },
    "r5": {
      "type": "router",
      "interfaces": {
        "lo": {
          "ipv6": "2001:db8::8/128"
        }
      },
      "pim6": {
        "enabled": true,
        "rp": {
          "group_range": [
            "ffbb::1/128",
            "ffbb::2/128",
            "ffbb::3/128",
            "ffbb::4/128",
            "ffbb::5/128",
            "ffcc::1/128",
            "ffcc::2/128",
            "ffcc::3/128",
            "ffcc::4/128",
            "ffcc::5/128"
          ]
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3"
      ]
    },
    "s4": {
      "type": "switch",
      "connected_nodes": [
        "r3"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth1",
      "interface_target": "eth0",
      "ipv6_subnet": "2001:db8:0:2::/64"
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "eth1",
      "interface_target": "eth0",
      "ipv6_subnet": "2001:db8:0:3::/64"
    }
  ]
}