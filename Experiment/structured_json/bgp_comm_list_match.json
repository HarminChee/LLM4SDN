{
  "metadata": {
    "script_name": "bgp_comm-list_delete.py",
    "description": "Three routers (r1, r2, r3) interconnected via two switches (s1, s2). Testing BGP community-list with multiple entries (logical OR). For example, 'match community 1' means (65001:1 AND 65002:2) OR 65001:3. Routes with these communities should be denied/filtered as per route-map on r2, r3.",
    "conf_files": {
      "r1": ["zebra.conf", "bgpd.conf"],
      "r2": ["zebra.conf", "bgpd.conf"],
      "r3": ["zebra.conf", "bgpd.conf"]
    }
  },

  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.0.1/24",
          "description": "Interface toward s1, connecting r1 <-> r2"
        }
      },
      "bgp": {
        "local_as": 65001,
        "neighbors": {
          "192.168.0.2": {
            "remote_as": 65002,
            "description": "BGP neighbor with r2"
          }
        },
        "routes_originated": [
          {
            "prefix": "172.16.255.1/32",
            "communities": ["65001:1", "65001:2"],
            "note": "Example route that might match partial portion of the community-list"
          },
          {
            "prefix": "172.16.255.3/32",
            "communities": ["65001:3"],
            "note": "Another route that might match the OR condition"
          }
        ]
      }
    },

    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.0.2/24",
          "description": "Interface toward s1, connecting r2 <-> r1"
        },
        "eth1": {
          "connected_to": "s2",
          "ipv4": "192.168.1.2/24",
          "description": "Interface toward s2, connecting r2 <-> r3"
        }
      },
      "bgp": {
        "local_as": 65002,
        "neighbors": {
          "192.168.0.1": {
            "remote_as": 65001,
            "description": "BGP neighbor with r1"
          },
          "192.168.1.3": {
            "remote_as": 65003,
            "description": "BGP neighbor with r3"
          }
        },
        "policy": {
          "community_lists": [
            {
              "id": 1,
              "seq": [
                {
                  "seq_num": 5,
                  "permit": true,
                  "match_communities": ["65001:1", "65002:2"],
                  "note": "Matches route carrying BOTH 65001:1 and 65002:2"
                },
                {
                  "seq_num": 10,
                  "permit": true,
                  "match_communities": ["65001:3"],
                  "note": "Matches route carrying 65001:3"
                }
              ]
            }
          ],
          "route_map": {
            "name": "test",
            "entries": [
              {
                "action": "deny",
                "sequence": 10,
                "match_community": 1,
                "description": "Deny if route has (65001:1 AND 65002:2) OR 65001:3"
              },
              {
                "action": "permit",
                "sequence": 20
              }
            ]
          }
        }
      }
    },

    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2",
          "ipv4": "192.168.1.3/24",
          "description": "Interface toward s2, connecting r3 <-> r2"
        }
      },
      "bgp": {
        "local_as": 65003,
        "neighbors": {
          "192.168.1.2": {
            "remote_as": 65002,
            "description": "BGP neighbor with r2"
          }
        },
        "routes_originated": [
          {
            "prefix": "172.16.255.4/32",
            "communities": ["65002:2", "65001:1"],
            "note": "Might also be filtered if meets (65001:1 & 65002:2)"
          }
        ]
      }
    }
  },

  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": ["r1", "r2"],
      "description": "Switch connecting r1-eth0 and r2-eth0"
    },
    "s2": {
      "type": "switch",
      "connected_nodes": ["r2", "r3"],
      "description": "Switch connecting r2-eth1 and r3-eth0"
    }
  },

  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0",
      "interface_target": "eth0",
      "ipv4_subnet": "192.168.0.0/24",
      "bgp_neighbors": true,
      "description": "Link from r1 to r2 via s1"
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "eth1",
      "interface_target": "eth0",
      "ipv4_subnet": "192.168.1.0/24",
      "bgp_neighbors": true,
      "description": "Link from r2 to r3 via s2"
    }
  ]
}
