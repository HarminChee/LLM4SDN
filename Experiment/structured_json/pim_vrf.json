{
  "metadata": {
    "script_name": "test_pim_vrf.py",
    "description": "Test PIM with VRFs topology and configuration.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "ospfd.conf",
        "pimd.conf"
      ],
      "r11": [
        "zebra.conf",
        "ospfd.conf",
        "pimd.conf"
      ],
      "r12": [
        "zebra.conf",
        "ospfd.conf",
        "pimd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1"
        },
        "eth1": {
          "connected_to": "sw2"
        },
        "eth2": {
          "connected_to": "sw3"
        },
        "eth3": {
          "connected_to": "sw4"
        }
      },
      "vrfs": {
        "blue": {
          "interfaces": [
            "eth0",
            "eth1"
          ]
        },
        "red": {
          "interfaces": [
            "eth2",
            "eth3"
          ]
        }
      },
      "ospf": {
        "vrf_blue": {},
        "vrf_red": {}
      },
      "pim": {
        "vrf_blue": {},
        "vrf_red": {}
      }
    },
    "r11": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw2"
        }
      },
      "ospf": {},
      "pim": {}
    },
    "r12": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw4"
        }
      },
      "ospf": {},
      "pim": {}
    },
    "h1": {
      "type": "host",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1"
        }
      }
    },
    "h2": {
      "type": "host",
      "interfaces": {
        "eth0": {
          "connected_to": "sw2"
        }
      }
    },
    "h3": {
      "type": "host",
      "interfaces": {
        "eth0": {
          "connected_to": "sw3"
        }
      }
    },
    "h4": {
      "type": "host",
      "interfaces": {
        "eth0": {
          "connected_to": "sw4"
        }
      }
    }
  },
  "switches": {
    "sw1": {
      "type": "switch",
      "connected_nodes": [
        "h1",
        "r1"
      ]
    },
    "sw2": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "h2",
        "r11"
      ]
    },
    "sw3": {
      "type": "switch",
      "connected_nodes": [
        "h3",
        "r1"
      ]
    },
    "sw4": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "h4",
        "r12"
      ]
    }
  },
  "links": [
    {
      "source": "h1",
      "target": "r1",
      "interface_source": "h1-eth0",
      "interface_target": "r1-eth0"
    },
    {
      "source": "h2",
      "target": "r1",
      "interface_source": "h2-eth0",
      "interface_target": "r1-eth1"
    },
    {
      "source": "h3",
      "target": "r1",
      "interface_source": "h3-eth0",
      "interface_target": "r1-eth2"
    },
    {
      "source": "h4",
      "target": "r1",
      "interface_source": "h4-eth0",
      "interface_target": "r1-eth3"
    },
    {
      "source": "r11",
      "target": "r1",
      "interface_source": "r11-eth0",
      "interface_target": "r1-eth1"
    },
    {
      "source": "r12",
      "target": "r1",
      "interface_source": "r12-eth0",
      "interface_target": "r1-eth3"
    }
  ]
}