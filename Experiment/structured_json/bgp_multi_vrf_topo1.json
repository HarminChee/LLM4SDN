{
  "metadata": {
    "script_name": "bgp_multi_vrf_topo1.json",
    "description": "Topology script testing BGP with multiple VRFs.",
    "conf_files": {
      "red1": [
        "zebra.conf",
        "bgpd.conf",
        "staticd.conf"
      ],
      "blue1": [
        "zebra.conf",
        "bgpd.conf",
        "staticd.conf"
      ],
      "r1": [
        "zebra.conf",
        "bgpd.conf",
        "staticd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf",
        "staticd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf",
        "staticd.conf"
      ]
    }
  },
  "routers": {
    "red1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.0.1/24",
          "ipv6": "2001:db8::1/64"
        },
        "eth1": {
          "connected_to": "s2",
          "ipv4": "10.0.1.1/24",
          "ipv6": "2001:db8:1::1/64"
        }
      },
      "vrfs": {
        "RED_A": {
          "static_routes": [
            {
              "network": "1.1.1.0/24",
              "next_hop": "Null0",
              "tag": "500"
            },
            {
              "network": "2.1.1.0/24",
              "next_hop": "Null0"
            }
          ],
          "bgp": {
            "local_as": 500,
            "address_family": {
              "ipv4": {
                "unicast": {
                  "redistribute": "static"
                }
              },
              "ipv6": {
                "unicast": {
                  "redistribute": "static"
                }
              }
            }
          }
        }
      }
    },
    "blue1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s3",
          "ipv4": "10.0.2.1/24",
          "ipv6": "2001:db8:2::1/64"
        },
        "eth1": {
          "connected_to": "s4",
          "ipv4": "10.0.3.1/24",
          "ipv6": "2001:db8:3::1/64"
        }
      },
      "vrfs": {
        "BLUE_A": {
          "static_routes": [
            {
              "network": "3.1.1.0/24",
              "next_hop": "Null0",
              "tag": "600"
            },
            {
              "network": "4.1.1.0/24",
              "next_hop": "Null0"
            }
          ],
          "bgp": {
            "local_as": 800,
            "address_family": {
              "ipv4": {
                "unicast": {
                  "redistribute": "static"
                }
              },
              "ipv6": {
                "unicast": {
                  "redistribute": "static"
                }
              }
            }
          }
        }
      }
    },
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.0.2/24",
          "ipv6": "2001:db8::2/64"
        },
        "eth1": {
          "connected_to": "s2",
          "ipv4": "10.0.1.2/24",
          "ipv6": "2001:db8:1::2/64"
        },
        "eth2": {
          "connected_to": "s3",
          "ipv4": "10.0.2.2/24",
          "ipv6": "2001:db8:2::2/64"
        },
        "eth3": {
          "connected_to": "s4",
          "ipv4": "10.0.3.2/24",
          "ipv6": "2001:db8:3::2/64"
        }
      },
      "vrfs": {
        "RED_A": {
          "import_vrf": [
            "RED_B"
          ],
          "route_maps": {
            "ABC": {
              "action": "permit",
              "match": "source-vrf",
              "set": {
                "as_path": "123"
              }
            }
          }
        },
        "BLUE_A": {
          "import_vrf": [
            "BLUE_B"
          ],
          "route_maps": {
            "ABC": {
              "action": "permit",
              "match": "source-vrf",
              "set": {
                "as_path": "456"
              }
            }
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "red1",
        "r1"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "red1",
        "r1"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "blue1",
        "r1"
      ]
    },
    "s4": {
      "type": "switch",
      "connected_nodes": [
        "blue1",
        "r1"
      ]
    }
  },
  "links": [
    {
      "source": "red1",
      "target": "r1",
      "interface_source": "eth0",
      "interface_target": "eth0",
      "protocols": [
        "bgp"
      ],
      "ipv4_subnet": "10.0.0.0/24"
    },
    {
      "source": "red1",
      "target": "r1",
      "interface_source": "eth1",
      "interface_target": "eth1",
      "protocols": [
        "bgp"
      ],
      "ipv4_subnet": "10.0.1.0/24"
    },
    {
      "source": "blue1",
      "target": "r1",
      "interface_source": "eth0",
      "interface_target": "eth2",
      "protocols": [
        "bgp"
      ],
      "ipv4_subnet": "10.0.2.0/24"
    },
    {
      "source": "blue1",
      "target": "r1",
      "interface_source": "eth1",
      "interface_target": "eth3",
      "protocols": [
        "bgp"
      ],
      "ipv4_subnet": "10.0.3.0/24"
    }
  ]
}