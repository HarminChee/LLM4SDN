{
  "metadata": {
    "script_name": "test_bfd_topo3.py",
    "description": "Topology with 6 routers (r1..r6) & 4 switches (s1..s4). BFD multi-hop, BGP (some unnumbered?), plus static routes. s4 is a broadcast domain for r4,r5,r6.",
    "conf_files": {
      "r1": ["bfdd.conf","zebra.conf","bgpd.conf","staticd.conf?"],
      "r2": ["bfdd.conf","zebra.conf","bgpd.conf","staticd.conf?"],
      "r3": ["bfdd.conf","zebra.conf","bgpd.conf","staticd.conf"],
      "r4": ["bfdd.conf","zebra.conf","bgpd.conf","staticd.conf"],
      "r5": ["bfdd.conf","zebra.conf","bgpd.conf?","staticd.conf"],
      "r6": ["bfdd.conf","zebra.conf","bgpd.conf?","staticd.conf"]
    }
  },

  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "192.168.12.1/24"
        }
      },
      "bfd": {
        "peers": {
          "r2": { "status_expected": "up" }
        }
      },
      "bgp": {
        "local_as": 65001,
        "neighbors": {
          "r2": {
            "remote_as": 65002,
            "ipv4_address": "192.168.12.2"
          }
        }
      }
    },

    "r2": {
      "type": "router",
      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "192.168.12.2/24"
        },
        "eth1_s2": {
          "connected_to": "s2",
          "ipv4": "192.168.23.2/24"
        }
      },
      "bfd": {
        "peers": {
          "r1": { "status_expected": "up" },
          "r3": { "status_expected": "up" }
        }
      },
      "bgp": {
        "local_as": 65002,
        "neighbors": {
          "r1": {
            "remote_as": 65001,
            "ipv4_address": "192.168.12.1"
          },
          "r3": {
            "remote_as": 65003,
            "ipv4_address": "192.168.23.3"
          }
        }
      }
    },

    "r3": {
      "type": "router",
      "interfaces": {
        "eth0_s2": {
          "connected_to": "s2",
          "ipv4": "192.168.23.3/24"
        },
        "eth1_s3": {
          "connected_to": "s3",
          "ipv4": "192.168.34.3/24"
        }
      },
      "bfd": {
        "peers": {
          "r2": {"status_expected": "up"},
          "r4": {"status_expected": "up"}
        }
      },
      "bgp": {
        "local_as": 65003,
        "neighbors": {
          "r2": {
            "remote_as": 65002,
            "ipv4_address": "192.168.23.2"
          },
          "r4": {
            "remote_as": 65004,
            "ipv4_address": "192.168.34.4"  
          }
        }
      },
      "static_routes": {
      }
    },

    "r4": {
      "type": "router",
      "interfaces": {
        "eth0_s3": {
          "connected_to": "s3",
          "ipv4": "192.168.34.4/24"
        },
        "eth1_s4": {
          "connected_to": "s4",
          "ipv4": "192.168.46.4/24"
        }
      },
      "bfd": {
        "peers": {
          "r3": {"status_expected": "up"},
          "r5": {"status_expected": "up"},
          "r6": {"status_expected": "up"}
        }
      },
      "bgp": {
        "local_as": 65004,
        "neighbors": {
          "r3": {
            "remote_as": 65003,
            "ipv4_address": "192.168.34.3"
          }
        }
      },
      "static_routes": {
      }
    },

    "r5": {
      "type": "router",
      "interfaces": {
        "eth0_s4": {
          "connected_to": "s4",
          "ipv4": "192.168.46.5/24"
        }
      },
      "bfd": {
        "peers": {
          "r4": {"status_expected": "up"},
          "r6": {"status_expected": "up"} 
        }
      },
      "static_routes": {
      }
    },

    "r6": {
      "type": "router",
      "interfaces": {
        "eth0_s4": {
          "connected_to": "s4",
          "ipv4": "192.168.46.6/24"
        }
      },
      "bfd": {
        "peers": {
          "r4": {"status_expected": "up"},
          "r5": {"status_expected": "up"}
        }
      },
      "static_routes": {
      }
    }
  },

  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": ["r1","r2"]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": ["r2","r3"]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": ["r3","r4"]
    },
    "s4": {
      "type": "switch",
      "connected_nodes": ["r4","r5","r6"]
    }
  },

  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0_s1",
      "interface_target": "eth0_s1",
      "ipv4_subnet": "192.168.12.0/24",
      "protocols": ["bfd","bgp"]
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "eth1_s2",
      "interface_target": "eth0_s2",
      "ipv4_subnet": "192.168.23.0/24",
      "protocols": ["bfd","bgp"] 
    },
    {
      "source": "r3",
      "target": "r4",
      "interface_source": "eth1_s3",
      "interface_target": "eth0_s3",
      "ipv4_subnet": "192.168.34.0/24",
      "protocols": ["bfd","bgp","static"]
    },
    {
      "source": "r4",
      "target": "r5",
      "interface_source": "eth1_s4",
      "interface_target": "eth0_s4",
      "ipv4_subnet": "192.168.46.0/24",
      "protocols": ["bfd","static"]
    },
    {
      "source": "r4",
      "target": "r6",
      "interface_source": "eth1_s4",
      "interface_target": "eth0_s4",
      "ipv4_subnet": "192.168.46.0/24",
      "protocols": ["bfd","static"]
    },
    {
      "source": "r5",
      "target": "r6",
      "interface_source": "eth0_s4",
      "interface_target": "eth0_s4",
      "ipv4_subnet": "192.168.46.0/24",
      "protocols": ["bfd","static"]
    }
  ]
}
