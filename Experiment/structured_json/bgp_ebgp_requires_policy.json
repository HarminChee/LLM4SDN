{
  "metadata": {
    "script_name": "bgp_ebgp_requires_policy.py",
    "description": "Test if eBGP sender without a filter applied to the peer is allowed to send advertisements in three scenarios using BGP.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r4": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r5": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r6": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "local_as": "<to_be_filled_if_known>",
        "neighbors": {
          "r2": {
            "remote_as": "<to_be_filled_if_known>",
            "state": "Active"
          }
        },
        "filters": {
          "outgoing": {
            "filter_applied": true,
            "routes": [
              "192.168.255.1/32"
            ]
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "local_as": "<to_be_filled_if_known>",
        "neighbors": {
          "r1": {
            "remote_as": "<to_be_filled_if_known>",
            "state": "Established"
          }
        }
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2"
        }
      },
      "bgp": {
        "local_as": "<to_be_filled_if_known>",
        "neighbors": {
          "r4": {
            "remote_as": "<to_be_filled_if_known>",
            "state": "Active"
          }
        },
        "filters": {
          "outgoing": {
            "filter_applied": false
          }
        }
      }
    },
    "r4": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2"
        }
      },
      "bgp": {
        "local_as": "<to_be_filled_if_known>",
        "neighbors": {
          "r3": {
            "remote_as": "<to_be_filled_if_known>",
            "state": "Established"
          }
        }
      }
    },
    "r5": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s3"
        }
      },
      "bgp": {
        "local_as": "<to_be_filled_if_known>",
        "neighbors": {
          "r6": {
            "remote_as": "<to_be_filled_if_known>",
            "state": "Established"
          }
        }
      }
    },
    "r6": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s3"
        }
      },
      "bgp": {
        "local_as": "<to_be_filled_if_known>",
        "neighbors": {
          "r5": {
            "remote_as": "<to_be_filled_if_known>",
            "state": "Established"
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r3",
        "r4"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r5",
        "r6"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "bgp_neighbors": true
    },
    {
      "source": "r3",
      "target": "r4",
      "interface_source": "r3-eth0",
      "interface_target": "r4-eth0",
      "bgp_neighbors": true
    },
    {
      "source": "r5",
      "target": "r6",
      "interface_source": "r5-eth0",
      "interface_target": "r6-eth0",
      "bgp_neighbors": true
    }
  ]
}