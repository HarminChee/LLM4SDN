{
  "metadata": {
    "script_name": "test_script.py",
    "description": "Topology with 1 switch (sw1) and 1 router (r1). Testing Zebra NH resolution.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "sharpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1"
        }
      },
      "static_routes": [
        {
          "network": "2.2.2.0/24",
          "next_hop": "r1-eth0"
        }
      ],
      "sharpd": {
        "watch": {
          "nexthop": "2.2.2.32",
          "type": "connected"
        },
        "install_routes": [
          {
            "route": "2.2.2.32",
            "nexthop": "2.2.2.32",
            "metric": 1
          },
          {
            "route": "2.2.2.31",
            "nexthop": "2.2.2.32",
            "metric": 1
          }
        ]
      }
    }
  },
  "switches": {
    "sw1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "sw1",
      "interface_source": "r1-eth0",
      "protocols": [
        "static"
      ]
    }
  ]
}