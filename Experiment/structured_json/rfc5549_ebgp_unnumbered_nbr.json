            "unicast": {
              "redistribute": [
                {
                  "redist_type": "static"
                }
              ]
            }
          }
        }
      },
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv6": "5001:dead:beef::1/126"
        },
        "eth1": {
          "connected_to": "s1"
        },
        "eth2": {
          "connected_to": "s1"
        }
      },
