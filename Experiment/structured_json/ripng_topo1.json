{
  "metadata": {
    "script_name": "test_ripng_topo1.py",
    "description": "Topology with 6 switches (sw1 to sw6) and 3 routers (r1, r2, r3) using RIPng + Zebra. Inferred from Python code.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "ripngd.conf"
      ],
      "r2": [
        "zebra.conf",
        "ripngd.conf"
      ],
      "r3": [
        "zebra.conf",
        "ripngd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1"
        },
        "eth1": {
          "connected_to": "sw2"
        },
        "eth2": {
          "connected_to": "sw5"
        },
        "eth3": {
          "connected_to": "sw6"
        }
      },
      "ripng": {}
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw2"
        },
        "eth1": {
          "connected_to": "sw3"
        }
      },
      "ripng": {}
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw4"
        },
        "eth1": {
          "connected_to": "sw3"
        }
      },
      "ripng": {}
    }
  },
  "switches": {
    "sw1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "sw2": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "sw3": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3"
      ]
    },
    "sw4": {
      "type": "switch",
      "connected_nodes": [
        "r3"
      ]
    },
    "sw5": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "sw6": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth1",
      "interface_target": "eth0",
      "protocols": [
        "ripng"
      ]
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "eth1",
      "interface_target": "eth1",
      "protocols": [
        "ripng"
      ]
    }
  ]
}