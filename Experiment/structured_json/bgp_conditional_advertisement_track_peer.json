{
  "metadata": {
    "script_name": "test_bgp_conditional_advertisement_track_peer.py",
    "description": "Conditionally advertise 172.16.255.2/32 to r1, only if 172.16.255.3/32 is received from r3. Also, withdraw if 172.16.255.3/32 disappears.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "staticd.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "staticd.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "staticd.conf",
        "bgpd.conf"
      ],
      "r4": [
        "zebra.conf",
        "staticd.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "zebra": {},
      "staticd": {},
      "bgp": {}
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s2"
        }
      },
      "zebra": {},
      "staticd": {},
      "bgp": {}
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2"
        }
      },
      "zebra": {},
      "staticd": {},
      "bgp": {}
    },
    "r4": {
      "type": "router",
      "interfaces": {},
      "zebra": {},
      "staticd": {},
      "bgp": {}
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0"
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth1",
      "interface_target": "r3-eth0"
    }
  ]
}