{
  "metadata": {
    "script_name": "test_bgp_conditional_advertisement.py",
    "description": "Topology with 2 switches (s1, s2) and 3 routers (r1, r2, r3) testing BGP conditional advertisement functionality.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.10.10.1/24"
        }
      },
      "bgp": {
        "local_as": 1,
        "neighbors": {
          "r2": {
            "remote_as": 2,
            "ipv4_address": "10.10.10.2"
          }
        }
      },
      "zebra": {}
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.10.10.2/24"
        },
        "eth1": {
          "connected_to": "s2",
          "ipv4": "10.10.20.2/24"
        }
      },
      "bgp": {
        "local_as": 2,
        "neighbors": {
          "r1": {
            "remote_as": 1,
            "ipv4_address": "10.10.10.1"
          },
          "r3": {
            "remote_as": 3,
            "ipv4_address": "10.10.20.3"
          }
        }
      },
      "zebra": {}
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2",
          "ipv4": "10.10.20.3/24"
        }
      },
      "bgp": {
        "local_as": 3,
        "neighbors": {
          "r2": {
            "remote_as": 2,
            "ipv4_address": "10.10.20.2"
          }
        }
      },
      "zebra": {}
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "protocols": [
        "bgp"
      ],
      "ipv4_subnet": "10.10.10.0/24"
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth1",
      "interface_target": "r3-eth0",
      "protocols": [
        "bgp"
      ],
      "ipv4_subnet": "10.10.20.0/24"
    }
  ]
}