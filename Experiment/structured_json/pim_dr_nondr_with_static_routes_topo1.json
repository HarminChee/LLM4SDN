{
  "metadata": {
    "script_name": "multicast_pim_sm.py",
    "description": "Topology with 1 OVS switch (s1) and 5 routers (r1, r2, r3, r4, r5) using PIM and IGMP. Inferred from Python code. Actual IP/babel info partially guessed.",
    "conf_files": {
      "r1": [
        "pimd.conf",
        "zebra.conf"
      ],
      "r2": [
        "pimd.conf",
        "zebra.conf"
      ],
      "r3": [
        "pimd.conf",
        "zebra.conf"
      ],
      "r4": [
        "pimd.conf",
        "zebra.conf"
      ],
      "r5": [
        "pimd.conf",
        "zebra.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.1.1/24"
        },
        "eth1": {
          "connected_to": "s1",
          "ipv4": "10.0.4.2/24"
        }
      },
      "pim": {
        "dr_priority": 0,
        "hello_timer": 1,
        "hold_timer": 3
      },
      "igmp": {
        "version": 2
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.2.1/24"
        },
        "eth1": {
          "connected_to": "s1",
          "ipv4": "10.0.4.3/24"
        }
      },
      "pim": {
        "dr_priority": 0,
        "hello_timer": 1,
        "hold_timer": 3,
        "rp": [
          {
            "rp_addr": "10.0.1.1",
            "group_addr_range": [
              "225.1.1.1/32",
              "225.1.1.2/32",
              "225.1.1.3/32",
              "225.1.1.4/32",
              "225.1.1.5/32"
            ]
          }
        ]
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.4.4/24"
        },
        "eth1": {
          "connected_to": "s1",
          "ipv4": "10.0.4.1/24"
        }
      },
      "pim": {
        "dr_priority": 0,
        "hello_timer": 1,
        "hold_timer": 3
      }
    },
    "r4": {
      "type": "router",
      "interfaces": {
        "lo": {
          "connected_to": "r1",
          "ipv4": "10.0.2.2/24"
        }
      },
      "pim": {
        "rp": [
          {
            "rp_addr": "10.0.2.2",
            "group_addr_range": [
              "225.1.1.1/32",
              "225.1.1.2/32",
              "225.1.1.3/32",
              "225.1.1.4/32",
              "225.1.1.5/32"
            ]
          }
        ]
      }
    },
    "r5": {
      "type": "router",
      "interfaces": {
        "i2": {
          "connected_to": "r4",
          "ipv4": "10.0.0.2/24"
        }
      },
      "igmp": {
        "interfaces": {
          "i2": {
            "igmp": {
              "version": "2"
            }
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2",
        "r3"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "s1",
      "interface_source": "eth0",
      "interface_target": "eth0",
      "ipv4_subnet": "10.0.1.0/24"
    },
    {
      "source": "r1",
      "target": "s1",
