{
  "metadata": {
    "script_name": "bgp_extcomm_list-delete.py",
    "description": "Topology with 1 switch (s1) and 2 routers (r1, r2). BGP extended community list deletion tested.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "local_as": "assumed from configuration file",
        "neighbors": {
          "r2": {
            "remote_as": "assumed from configuration file",
            "ipv4_address": "192.168.255.2",
            "state": "expected 'Established'"
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "local_as": "assumed from configuration file",
        "neighbors": {
          "r1": {
            "remote_as": "assumed from configuration file",
            "ipv4_address": "192.168.255.1",
            "state": "expected 'Established'"
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "ipv4_subnet": "192.168.255.0/24",
      "bgp_neighbors": true
    }
  ]
}