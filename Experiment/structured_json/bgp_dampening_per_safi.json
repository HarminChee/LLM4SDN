{
  "metadata": {
    "script_name": "test_bgp_dampening_per_peer.py",
    "description": "Topology with 1 switch (s1) and 2 routers (r1, r2). BGP dampening per peer tested.",
    "conf_files": {
      "r1": [
        "frr.conf"
      ],
      "r2": [
        "frr.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "dampening_parameters": {
          "halfLifeSecs": 60,
          "reusePenalty": 1,
          "suppressPenalty": 1,
          "maxSuppressTimeSecs": 60,
          "maxSuppressPenalty": 2
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "announce": [
          "10.10.10.10/32"
        ]
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "bgp_neighbors": true
    }
  ]
}