{
  "metadata": {
    "script_name": "test_bgp_gr_restart_retain_routes.py",
    "description": "Test if routes are retained during BGP restarts.",
    "conf_files": {
      "r1": [
        "frr.conf"
      ],
      "r2": [
        "frr.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "neighbors": {
          "192.168.255.1": {
            "bgpState": "Established",
            "addressFamilyInfo": {
              "ipv4Unicast": {
                "acceptedPrefixCounter": 2
              }
            }
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "neighbors": {
          "192.168.255.1": {
            "bgpState": "Established",
            "addressFamilyInfo": {
              "ipv4Unicast": {
                "acceptedPrefixCounter": 2
              }
            }
          }
        },
        "retained_routes": {
          "bgp": {
            "172.16.255.1/32": {
              "paths": [
                {
                  "stale": true
                }
              ]
            }
          },
          "kernel": {
            "172.16.255.1/32": {
              "dst": "172.16.255.1",
              "gateway": "192.168.255.1",
              "metric": 20,
              "proto": "bgp",
              "dev": "r2-eth0"
            }
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "protocols": [
        "bgp"
      ],
      "ipv4_subnet": "192.168.255.0/24"
    }
  ]
}