{
  "metadata": {
    "script_name": "bgp_gr_topojson_topo1.py",
    "description": "Topology with 2 routers (r1, r2) testing BGP Graceful Restart functionality.",
    "conf_files": {
      "r1": [
        "bgpd.conf"
      ],
      "r2": [
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "r2",
          "ipv4": "192.168.0.1/24",
          "ipv6": "fd00::1/64"
        }
      },
      "bgp": {
        "local_as": 101,
        "neighbors": {
          "r2": {
            "remote_as": 102,
            "ipv4_address": "192.168.0.2",
            "ipv6_address": "fd00::2",
            "graceful_restart": true,
            "graceful_restart_helper": false
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "r1",
          "ipv4": "192.168.0.2/24",
          "ipv6": "fd00::2/64"
        }
      },
      "bgp": {
        "local_as": 102,
        "neighbors": {
          "r1": {
            "remote_as": 101,
            "ipv4_address": "192.168.0.1",
            "ipv6_address": "fd00::1",
            "graceful_restart": true,
            "graceful_restart_helper": true
          }
        }
      }
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0",
      "interface_target": "eth0",
      "protocols": [
        "bgp"
      ],
      "ipv4_subnet": "192.168.0.0/24",
      "ipv6_subnet": "fd00::/64"
    }
  ]
}