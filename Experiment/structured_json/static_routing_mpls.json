{
  "metadata": {
    "script_name": "test_static_routing_mpls.py",
    "description": "Testing MPLS configuration with mpls interface settings",
    "conf_files": {
      "r1": [
        "zebra.conf"
      ],
      "r2": [
        "zebra.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1"
        },
        "eth1": {
          "connected_to": "sw2"
        }
      },
      "mpls": {
        "enabled": true
      },
      "zebra": {}
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw2",
          "mpls_enabled": true
        },
        "eth1": {
          "connected_to": "sw3",
          "mpls_enabled": false
        },
        "eth2": {
          "connected_to": "sw4"
        }
      },
      "mpls": {
        "enabled": true
      },
      "zebra": {}
    }
  },
  "switches": {
    "sw1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "sw2": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "sw3": {
      "type": "switch",
      "connected_nodes": [
        "r2"
      ]
    },
    "sw4": {
      "type": "switch",
      "connected_nodes": [
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "sw1",
      "interface_source": "r1-eth0",
      "interface_target": "sw1-eth0"
    },
    {
      "source": "r1",
      "target": "sw2",
      "interface_source": "r1-eth1",
      "interface_target": "sw2-eth0"
    },
    {
      "source": "r2",
      "target": "sw2",
      "interface_source": "r2-eth0",
      "interface_target": "sw2-eth1"
    },
    {
      "source": "r2",
      "target": "sw3",
      "interface_source": "r2-eth1",
      "interface_target": "sw3-eth0"
    },
    {
      "source": "r2",
      "target": "sw4",
      "interface_source": "r2-eth2",
      "interface_target": "sw4-eth0"
    }
  ]
}