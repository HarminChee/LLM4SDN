{
  "metadata": {
    "script_name": "test_bgp_flowspec_topo.py",
    "description": "Test BGP topology with Flowspec EBGP peering. Topology with 1 switch (s1) and 1 router (r1). Includes an eBGP ExaBGP peer1.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.1.1",
          "ipv6": "1001::1"
        }
      },
      "bgp": {
        "local_as": null,
        "neighbors": {
          "peer1": {
            "remote_as": null,
            "ipv4_address": "10.0.1.101",
            "state": "Established"
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "peer1"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "peer1",
      "interface_source": "r1-eth0",
      "interface_target": "peer1-eth0",
      "ipv4_subnet": "10.0.1.0/24",
      "bgp_neighbors": true
    }
  ],
  "peers": {
    "peer1": {
      "type": "exabgp_peer",
      "ip": "10.0.1.101",
      "defaultRoute": "via 10.0.1.1"
    }
  }
}