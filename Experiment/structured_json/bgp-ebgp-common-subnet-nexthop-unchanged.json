{
  "metadata": {
    "script_name": "test_bgp_ebgp_common_subnet_nh_unchanged.py",
    "description": "Topology with 1 switch (s1) and 3 routers (r1, r2, r3). BGP + Zebra configuration to check if NEXT_HOP attribute is not changed if peer shares a common subnet with this address.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "zebra": {},
      "bgp": {
        "neighbors": {
          "r2": {
            "state": "Established"
          },
          "r3": {
            "state": "Established"
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "zebra": {},
      "bgp": {
        "neighbors": {
          "r1": {
            "state": "Established"
          },
          "r3": {
            "state": "Established"
          }
        }
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "zebra": {},
      "bgp": {
        "neighbors": {
          "r1": {
            "state": "Established"
          },
          "r2": {
            "state": "Established"
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2",
        "r3"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0"
    },
    {
      "source": "r1",
      "target": "r3",
      "interface_source": "r1-eth0",
      "interface_target": "r3-eth0"
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth0",
      "interface_target": "r3-eth0"
    }
  ]
}