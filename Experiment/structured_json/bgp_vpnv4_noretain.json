{
  "metadata": {
    "script_name": "test_bgp_vpnv4_noretain.py",
    "description": "Topology with 8 switches and 2 routers testing BGP VPNv4 non-retain entries",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth1": {
          "connected_to": "s1"
        },
        "eth2": {
          "connected_to": "s5"
        },
        "eth3": {
          "connected_to": "s7"
        },
        "eth4": {
          "connected_to": "s2"
        }
      },
      "bgp": {
        "vrfs": [
          "vrf1",
          "vrf2",
          "vrf3",
          "vrf4"
        ]
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth1": {
          "connected_to": "s1"
        },
        "eth2": {
          "connected_to": "s3"
        },
        "eth3": {
          "connected_to": "s4"
        },
        "eth4": {
          "connected_to": "s6"
        },
        "eth5": {
          "connected_to": "s8"
        }
      },
      "bgp": {
        "vrfs": [
          "vrf1",
          "vrf2",
          "vrf3",
          "vrf4"
        ]
      }
    }
  },
  "switches": {
