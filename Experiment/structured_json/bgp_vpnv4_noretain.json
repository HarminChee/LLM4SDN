      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r2"
      ]
    },
    "s4": {
      "type": "switch",
      "connected_nodes": [
        "r2"
      ]
    },
    "s5": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s6": {
      "type": "switch",
      "connected_nodes": [
        "r2"
      ]
    },
    "s7": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s8": {
