{
  "metadata": {
    "script_name": "test_bgp_community_alias.py",
    "description": "Two routers (r1, r2) connected via switch s1. r2 advertises several prefixes (172.16.16.x/32) with specific communities and large communities that map to aliases (e.g. community-r2-1, large-community-r2-1). r1 checks via CLI to confirm these aliases appear correctly in 'show ip route json' and 'show bgp ipv4 ...' outputs.",
    "conf_files": {
      "r1": ["zebra.conf", "bgpd.conf"],
      "r2": ["zebra.conf", "bgpd.conf"]
    }
  },

  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.255.1/24",
          "description": "Interface to switch s1"
        }
      },
      "bgp": {
        "local_as": 65001,
        "neighbors": {
          "192.168.255.2": {
            "remote_as": 65002,
            "description": "BGP neighbor with r2"
          }
        },
        "community_aliases": [

        ],
        "large_community_aliases": [

        ]
      }
    },

    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.255.2/24",
          "description": "Interface to switch s1"
        }
      },
      "bgp": {
        "local_as": 65002,
        "neighbors": {
          "192.168.255.1": {
            "remote_as": 65001,
            "description": "BGP neighbor with r1"
          }
        },
        "routes_originated": [
          {
            "prefix": "172.16.16.1/32",
            "tag": 10,
            "communities": ["community-r2-1", "65001:2"],
            "large_communities": ["large-community-r2-1", "65001:1:2"],
            "note": "Route carrying both normal and large community aliases"
          },
          {
            "prefix": "172.16.16.2/32",
            "tag": 20,
            "communities": ["65002:1", "community-r2-2"],
            "large_communities": [],
            "note": "Route with different set of communities (no large community)"
          },
          {
            "prefix": "172.16.16.3/32",
            "tag": 100,
            "communities": [],
            "large_communities": [],
            "note": "Route with no communities or aliases"
          }
        ],
        "community_aliases": [
          {
            "alias": "community-r2-1",
            "value": "65001:2"
          },
          {
            "alias": "community-r2-2",
            "value": "65002:1"
          }
        ],
        "large_community_aliases": [
          {
            "alias": "large-community-r2-1",
            "value": "65001:1:2"
          }
        ]
      }
    }
  },

  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": ["r1", "r2"]
    }
  },

  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0",
      "interface_target": "eth0",
      "ipv4_subnet": "192.168.255.0/24",
      "description": "Link between r1 and r2 through switch s1",
      "bgp_neighbors": true
    }
  ]
}
