{
  "metadata": {
    "script_name": "test_nhrp_topo.py",
    "description": "Topology with 5 switches (s1, s2, s3, s4, s5) and 4 routers (r1, r2, r3, r4) to test NHRP.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "nhrpd.conf",
        "sharpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "nhrpd.conf"
      ],
      "r3": [
        "zebra.conf"
      ],
      "r4": [
        "zebra.conf",
        "nhrpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "gre0": {
          "connected_to": "eth0"
        }
      },
      "nhrp": {
        "gre_interfaces": [
          "gre0"
        ]
      },
      "sharpd": {
        "routes": [
          {
            "prefix": "4.4.4.1",
            "nexthop": "10.255.255.2",
            "metric": 1
          },
          {
            "prefix": "5.5.5.1",
            "nexthop": "10.255.255.2",
            "metric": 1,
            "no_recurse": true
          }
        ]
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2"
        },
        "gre0": {
          "connected_to": "eth0"
        }
      },
      "nhrp": {
        "gre_interfaces": [
          "gre0"
        ]
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2"
        }
      }
    },
    "r4": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "gre0": {
          "connected_to": "eth0"
        }
      },
      "nhrp": {
        "gre_interfaces": [
          "gre0"
        ]
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r3",
        "r4"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r2"
      ]
    },
    "s4": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s5": {
      "type": "switch",
      "connected_nodes": [
        "r4"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r3",
      "interface_source": "eth0",
      "interface_target": "eth0"
    },
    {
      "source": "r1",
      "target": "r4",
      "interface_source": "gre0",
      "interface_target": "gre0",
      "protocols": [
        "nhrp"
      ]
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "eth0",
      "interface_target": "eth0"
    },
    {
      "source": "r2",
      "target": "r1",
      "interface_source": "gre0",
      "interface_target": "gre0",
      "protocols": [
        "nhrp"
      ]
    }
  ]
}