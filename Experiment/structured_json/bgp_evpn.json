{
  "metadata": {
    "script_name": "test_bgp_evpn.py",
    "description": "Test the FRR BGP daemon with BGP IPv6 interface with route advertisements on a separate netns.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.100.21"
        }
      },
      "vrfs": {
        "vrf-101": {
          "loopback_interface": "loop101",
          "bridge_interface": "bridge-101",
          "vxlan_interface": {
            "name": "vxlan-101",
            "id": 101,
            "local_ip": "192.168.100.21",
            "bridge": "bridge-101",
            "vrf": "vrf-101"
          }
        }
      },
      "bgp": {
        "local_as": 65000,
        "neighbors": {}
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.100.41"
        }
      },
      "vrfs": {
        "vrf-101": {
          "loopback_interface": "loop101",
          "bridge_interface": "bridge-101",
          "vxlan_interface": {
            "name": "vxlan-101",
            "id": 101,
            "local_ip": "192.168.100.41",
            "bridge": "bridge-101",
            "vrf": "vrf-101"
          }
        }
      },
      "bgp": {
        "local_as": 65000,
        "neighbors": {}
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "ipv4_subnet": "192.168.100.0/24"
    }
  ]
}