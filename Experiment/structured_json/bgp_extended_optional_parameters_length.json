{
  "metadata": {
    "script_name": "test_bgp_extended_optional_parameters_length.py",
    "description": "Topology with 1 switch (s1) and 2 routers (r1, r2) using BGP + Zebra. Test if Extended Optional Parameters Length encoding format works if forced with a knob.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "local_as": 101,
        "neighbors": {
          "r2": {
            "remote_as": 102,
            "ipv4_address": "192.168.1.2",
            "state": "Established"
          }
        }
      },
      "zebra": {}
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "local_as": 102,
        "neighbors": {
          "r1": {
            "remote_as": 101,
            "ipv4_address": "192.168.1.1",
            "state": "Established"
          }
        }
      },
      "zebra": {}
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "ipv4_subnet": "192.168.1.0/24",
      "bgp_neighbors": true
    }
  ]
}