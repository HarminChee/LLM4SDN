{
  "metadata": {
    "script_name": "test_aggregate_address_matching_med.py",
    "description": "4 routers (r1..r4), 2 switches (s1..s2). BGP aggregator with MED-based summarization. Only (r1<->r2) & (r2<->r3) are used. r4 is present but not used.",
    "conf_files": {
      "r1": ["zebra.conf","bgpd.conf"],
      "r2": ["zebra.conf","bgpd.conf"],
      "r3": ["zebra.conf","bgpd.conf"],
      "r4": ["zebra.conf","bgpd.conf"]
    }
  },

  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "192.168.1.1/24"
        }
      },
      "bgp": {
        "neighbors": {
          "r2_s1": {
            "ipv4_address": "192.168.1.2"
          }
        }
      }
    },

    "r2": {
      "type": "router",
      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "192.168.1.2/24"
        },

        "eth1_s2": {
          "connected_to": "s2",
          "ipv4": "192.168.2.2/24"
        }
      },
      "bgp": {

        "neighbors": {
          "r1_s1": {
            "ipv4_address": "192.168.1.1"
          },
          "r3_s2": {
            "ipv4_address": "192.168.2.3"
          }
        }
      }
    },

    "r3": {
      "type": "router",
      "interfaces": {

        "eth0_s2": {
          "connected_to": "s2",
          "ipv4": "192.168.2.3/24"
        }
      },
      "bgp": {
        "neighbors": {
          "r2_s2": {
            "ipv4_address": "192.168.2.2"
          }
        }
      }
    },

    "r4": {
      "type": "router",

      "interfaces": {},
      "bgp": {}
    }
  },

  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": ["r1","r2"]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": ["r2","r3"]

    }
  },

  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0_s1",
      "interface_target": "eth0_s1",
      "ipv4_subnet": "192.168.1.0/24",
      "protocols": ["bgp"]
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "eth1_s2",
      "interface_target": "eth0_s2",
      "ipv4_subnet": "192.168.2.0/24",
      "protocols": ["bgp"]
    }
 
  ]
}
