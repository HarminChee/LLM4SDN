{
  "metadata": {
    "script_name": "test_babel_topo1.py",
    "description": "Topology with 4 switches (sw1..sw4) and 3 routers (r1,r2,r3) using Babel + Zebra. Inferred from Python code. Actual IP/babel info partially guessed.",
    "conf_files": {
      "r1": ["zebra.conf", "babeld.conf"],
      "r2": ["zebra.conf", "babeld.conf"],
      "r3": ["zebra.conf", "babeld.conf"]
    }
  },

  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1"
        },
        "eth1": {
          "connected_to": "sw2"
        }
      },
      "babel": {
        "enable": true,
        "neighbors": {
          "r2": {
            "mode": "multihop" 
          }
        }
      },
      "zebra": {
      }
    },

    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw2"
        },
        "eth1": {
          "connected_to": "sw3"
        }
      },
      "babel": {
        "enable": true,
        "neighbors": {
          "r1": {},
          "r3": {}
        }
      },
      "zebra": {}
    },

    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw3"
        },
        "eth1": {
          "connected_to": "sw4"
        }
      },
      "babel": {
        "enable": true,
        "neighbors": {
          "r2": {}
        }
      },
      "zebra": {}
    }
  },

  "switches": {
    "sw1": {
      "type": "switch",
      "connected_nodes": ["r1"]
    },
    "sw2": {
      "type": "switch",
      "connected_nodes": ["r1", "r2"]
    },
    "sw3": {
      "type": "switch",
      "connected_nodes": ["r2", "r3"]
    },
    "sw4": {
      "type": "switch",
      "connected_nodes": ["r3"]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth1",
      "interface_target": "r2-eth0",
      "protocols": ["babel"],
      "ipv4_subnet": "10.0.2.0/24"
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth1",
      "interface_target": "r3-eth0",
      "protocols": ["babel"]
    }
  ]
}
