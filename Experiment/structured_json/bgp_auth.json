{
  "metadata": {
    "script_name": "test_bgp_auth.py",
    "description": "Three routers (r1, r2, r3) forming a full mesh, each link bound to a distinct VRF (default, blue, red). Test BGP MD5 auth/password changes.",
    "conf_files": {
      "r1": ["zebra.conf", "bgpd.conf"],
      "r2": ["zebra.conf", "bgpd.conf"],
      "r3": ["zebra.conf", "bgpd.conf"]
    }
  },

  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "r2",
          "vrf": "default",
          "ipv4": "1.1.1.1/24"
        },
        "eth1": {
          "connected_to": "r3",
          "vrf": "red",
          "ipv4": "1.1.3.1/24"
        }
      },
      "bgp": {
        "local_as": 65001,
        "neighbors": {
          "r2": {
            "remote_as": 65002,
            "password": "md5secret", 
            "vrf": "default"
          },
          "r3": {
            "remote_as": 65003,
            "password": "md5secret",
            "vrf": "red"
          }
        }
      }
    },

    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "r1",
          "vrf": "default",
          "ipv4": "1.1.1.2/24"
        },
        "eth1": {
          "connected_to": "r3",
          "vrf": "blue",
          "ipv4": "2.2.3.2/24"
        }
      },
      "bgp": {
        "local_as": 65002,
        "neighbors": {
          "r1": {
            "remote_as": 65001,
            "password": "md5secret",
            "vrf": "default"
          },
          "r3": {
            "remote_as": 65003,
            "password": "md5secret",
            "vrf": "blue"
          }
        }
      }
    },

    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "r2",
          "vrf": "blue",
          "ipv4": "2.2.3.3/24"
        },
        "eth1": {
          "connected_to": "r1",
          "vrf": "red",
          "ipv4": "1.1.3.3/24"
        }
      },
      "bgp": {
        "local_as": 65003,
        "neighbors": {
          "r2": {
            "remote_as": 65002,
            "password": "md5secret",
            "vrf": "blue"
          },
          "r1": {
            "remote_as": 65001,
            "password": "md5secret",
            "vrf": "red"
          }
        }
      }
    }
  },

  "switches": {
  },

  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0",
      "interface_target": "eth0",
      "vrf": "default",
      "ipv4_subnet": "1.1.1.0/24",
      "bgp": true
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "eth1",
      "interface_target": "eth0",
      "vrf": "blue",
      "ipv4_subnet": "2.2.3.0/24",
      "bgp": true
    },
    {
      "source": "r1",
      "target": "r3",
      "interface_source": "eth1",
      "interface_target": "eth1",
      "vrf": "red",
      "ipv4_subnet": "1.1.3.0/24",
      "bgp": true
    }
  ]
}
