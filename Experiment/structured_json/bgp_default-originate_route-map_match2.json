{
  "metadata": {
    "script_name": "test_bgp_default_originate_route_map.py",
    "description": "Test if default-originate works with conditional match. If 10.0.0.0/22 is received from r2, then we announce 0.0.0.0/0 to r2.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "config_file": "bgpd.conf"
      },
      "zebra": {
        "config_file": "zebra.conf"
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "config_file": "bgpd.conf"
      },
      "zebra": {
        "config_file": "zebra.conf"
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0"
    }
  ]
}