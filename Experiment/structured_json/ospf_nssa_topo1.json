{
  "metadata": {
    "script_name": "test_ospf_nssa_topo1.py",
    "description": "Topology with 3 switches s1, s2, s3 and 4 routers rt1, rt2, rt3, rt4 using OSPF NSSA.",
    "conf_files": {
      "rt1": [
        "zebra.conf",
        "staticd.conf",
        "ospfd.conf"
      ],
      "rt2": [
        "zebra.conf",
        "staticd.conf",
        "ospfd.conf"
      ],
      "rt3": [
        "zebra.conf",
        "staticd.conf",
        "ospfd.conf"
      ],
      "rt4": [
        "zebra.conf",
        "staticd.conf",
        "ospfd.conf"
      ]
    }
  },
  "routers": {
    "rt1": {
      "type": "router",
      "interfaces": {
        "eth-rt2": {
          "connected_to": "s1",
          "ipv4": "10.0.1.1/24"
        }
      },
      "ospf": {
        "enable": true,
        "neighbors": {
          "rt2": {}
        }
      }
    },
    "rt2": {
      "type": "router",
      "interfaces": {
        "eth-rt1": {
          "connected_to": "s1",
          "ipv4": "10.0.1.2/24"
        },
        "eth-rt3": {
          "connected_to": "s2",
          "ipv4": "10.0.2.1/24"
        },
        "eth-rt4": {
          "connected_to": "s3",
          "ipv4": "10.0.3.1/24"
        }
      },
      "ospf": {
        "enable": true,
        "neighbors": {
          "rt1": {},
          "rt3": {},
          "rt4": {}
        }
      }
    },
    "rt3": {
      "type": "router",
      "interfaces": {
        "eth-rt2": {
          "connected_to": "s2",
          "ipv4": "10.0.2.2/24"
        }
      },
      "ospf": {
        "enable": true,
        "neighbors": {
          "rt2": {}
        }
      }
    },
    "rt4": {
      "type": "router",
      "interfaces": {
        "eth-rt2": {
          "connected_to": "s3",
          "ipv4": "10.0.3.2/24"
        }
      },
      "ospf": {
        "enable": true,
        "neighbors": {
          "rt2": {}
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "rt1",
        "rt2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "rt2",
        "rt3"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "rt2",
        "rt4"
      ]
    }
  },
  "links": [
    {
      "source": "rt1",
      "target": "rt2",
      "interface_source": "rt1-eth-rt2",
      "interface_target": "rt2-eth-rt1",
      "ipv4_subnet": "10.0.1.0/24",
      "ospf_neighbors": true
    },
    {
      "source": "rt2",
      "target": "rt3",
      "interface_source": "rt2-eth-rt3",
      "interface_target": "rt3-eth-rt2",
      "ipv4_subnet": "10.0.2.0/24",
      "ospf_neighbors": true
    },
    {
      "source": "rt2",
      "target": "rt4",
      "interface_source": "rt2-eth-rt4",
      "interface_target": "rt4-eth-rt2",
      "ipv4_subnet": "10.0.3.0/24",
      "ospf_neighbors": true
    }
  ]
}