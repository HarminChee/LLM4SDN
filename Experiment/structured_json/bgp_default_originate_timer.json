{
  "metadata": {
    "script_name": "test_bgp_default_originate_timer.py",
    "description": "Check BGP default-originate timer behavior. Topology with 2 switches (s1, s2) and 3 routers (r1, r2, r3). Routers connected in a specific configuration.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s2"
        }
      },
      "bgp": {
        "local_as": null,
        "neighbors": {
          "r2": {
            "remote_as": null,
            "ipv4_address": "192.168.1.2",
            "state": "Established"
          },
          "r3": {
            "remote_as": null,
            "ipv4_address": "192.168.1.3"
          }
        }
      },
      "zebra": {}
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "local_as": null,
        "neighbors": {
          "r1": {
            "remote_as": null,
            "ipv4_address": "192.168.1.1",
            "state": "Established"
          }
        }
      },
      "zebra": {}
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2"
        }
      },
      "bgp": {
        "local_as": null,
        "neighbors": {
          "r1": {
            "remote_as": null,
            "ipv4_address": "192.168.1.1"
          }
        }
      },
      "zebra": {}
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r3"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0",
      "interface_target": "eth0",
      "ipv4_subnet": "192.168.1.0/24",
      "bgp_neighbors": true
    },
    {
      "source": "r1",
      "target": "r3",
      "interface_source": "eth1",
      "interface_target": "eth0",
      "ipv4_subnet": "192.168.1.0/24",
      "bgp_neighbors": true
    }
  ]
}