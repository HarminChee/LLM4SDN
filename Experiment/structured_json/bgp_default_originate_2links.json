{
  "metadata": {
    "script_name": "bgp_default_originate_2links.py",
    "description": "Topology with 2 links between r1 and r2, testing BGP default-originate with various configurations.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "r1-link1": {
          "connected_to": "r2-link1",
          "ipv4": "198.51.100.1/24",
          "ipv6": "2001:db8::1/64"
        },
        "r1-link2": {
          "connected_to": "r2-link2",
          "ipv4": "198.51.200.1/24",
          "ipv6": "2001:db8::2/64"
        }
      },
      "bgp": {
        "local_as": 65001,
        "neighbors": {
          "r2": {
            "dest-links": [
              "r1-link1",
              "r1-link2"
            ],
            "default_originate": true
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "r2-link1": {
          "connected_to": "r1-link1",
          "ipv4": "198.51.100.2/24",
          "ipv6": "2001:db8::2/64"
        },
        "r2-link2": {
          "connected_to": "r1-link2",
          "ipv4": "198.51.200.2/24",
          "ipv6": "2001:db8::3/64"
        }
      },
      "bgp": {
        "local_as": 65002,
        "neighbors": {
          "r1": {
            "dest-links": [
              "r2-link1",
              "r2-link2"
            ],
            "default_originate": true
          }
        }
      }
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-link1",
      "interface_target": "r2-link1",
      "ipv4_subnet": "198.51.100.0/24",
      "ipv6_subnet": "2001:db8::/64",
      "bfd": false,
      "bgp_neighbors": true
    },
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-link2",
      "interface_target": "r2-link2",
      "ipv4_subnet": "198.51.200.0/24",
      "ipv6_subnet": "2001:db8::/64",
      "bfd": false,
      "bgp_neighbors": true
    }
  ]
}