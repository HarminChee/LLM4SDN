{
  "metadata": {
    "script_name": "test_bgp_dual_as.py",
    "description": "Topology with a single switch and two routers (r1, r2) using BGP. Inferred from Python code. Actual IP/ASNs partially guessed.",
    "conf_files": {
      "r1": [
        "frr.conf"
      ],
      "r2": [
        "frr.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.0.1/24"
        }
      },
      "bgp": {
        "local_as": 65000,
        "neighbors": {
          "r2": {
            "remote_as": 65002,
            "ipv4_address": "10.0.0.2",
            "state": "Established"
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.0.2/24"
        }
      },
      "bgp": {
        "local_as": 65002,
        "neighbors": {
          "r1": {
            "remote_as": 65000,
            "ipv4_address": "10.0.0.1",
            "state": "Established"
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "ipv4_subnet": "10.0.0.0/24",
      "bgp_neighbors": true
    }
  ]
}