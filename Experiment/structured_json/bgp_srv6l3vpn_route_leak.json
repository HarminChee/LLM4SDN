{
  "metadata": {
    "script_name": "Unnamed Script",
    "description": "Topology with 1 link between routers pe1 and ce1. VRF and BGP configurations are applied.",
    "conf_files": {
      "pe1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "ce1": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "pe1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "ce1",
          "vrfs": [
            "vrf10",
            "vrf20"
          ]
        }
      },
      "vrf": {
        "vrf10": {
          "table": 10
        },
        "vrf20": {
          "table": 20
        }
      },
      "bgp": {
        "local_as": null,
        "neighbors": {}
      }
    },
    "ce1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "pe1"
        }
      },
      "bgp": {
        "local_as": null,
        "neighbors": {}
      }
    }
  },
  "links": [
    {
      "source": "pe1",
      "target": "ce1",
      "interface_source": "pe1-eth0",
      "interface_target": "ce1-eth0",
      "protocols": [
        "bgp"
      ]
    }
  ]
}