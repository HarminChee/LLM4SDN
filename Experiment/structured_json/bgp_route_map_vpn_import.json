{
  "metadata": {
    "script_name": "bgp_route_map_vpn_import.py",
    "description": "Topology with 4 switches (s1, s2, s3, s4) and 1 router (r1) using BGP with VRF and route-maps.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s2"
        },
        "eth2": {
          "connected_to": "s3"
        },
        "eth3": {
          "connected_to": "s4"
        }
      },
      "vrfs": {
        "Customer": {
          "table": 1001,
          "interfaces": [
            "eth0",
            "eth3"
          ]
        },
        "Service": {
          "table": 1002,
          "interfaces": [
            "eth1"
          ]
        }
      },
      "bgp": {
        "local_as": 100,
        "vrfs": {
          "Customer": {
            "import_route_map": "vpn import",
            "routes": {
              "192.0.2.0/24": {
                "locPrf": 123
              }
            }
          },
          "Service": {
            "import_route_map": "vpn import",
            "routes": {
              "192.168.1.0/24": {
                "locPrf": null
              }
            }
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s4": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "s1",
      "interface_source": "eth0"
    },
    {
      "source": "r1",
      "target": "s2",
      "interface_source": "eth1"
    },
    {
      "source": "r1",
      "target": "s3",
      "interface_source": "eth2"
    },
    {
      "source": "r1",
      "target": "s4",
      "interface_source": "eth3"
    }
  ]
}