{
  "metadata": {
    "script_name": "test_bgp_confederation_astype.py",
    "description": "Test if BGP confederation works properly with remote-as internal/external configurations, including peer-groups.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.1/24"
        },
        "eth1": {
          "connected_to": "s2",
          "ipv4": "192.168.2.1/24"
        }
      },
      "bgp": {
        "local_as": 65001,
        "neighbors": {
          "r2": {
            "remote_as": 65002,
            "ipv4_address": "192.168.1.2",
            "state": "Established",
            "pfxRcd": 1
          },
          "r3": {
            "remote_as": 65003,
            "ipv4_address": "192.168.2.2",
            "state": "Established",
            "pfxRcd": 1
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.2/24"
        }
      },
      "bgp": {
        "local_as": 65002,
        "neighbors": {
          "r1": {
            "remote_as": 65001,
            "ipv4_address": "192.168.1.1",
            "state": "Established"
          }
        }
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2",
          "ipv4": "192.168.2.2/24"
        }
      },
      "bgp": {
        "local_as": 65003,
        "neighbors": {
          "r1": {
            "remote_as": 65001,
            "ipv4_address": "192.168.2.1",
            "state": "Established"
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r3"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "ipv4_subnet": "192.168.1.0/24",
      "bgp_neighbors": true
    },
    {
      "source": "r1",
      "target": "r3",
      "interface_source": "r1-eth1",
      "interface_target": "r3-eth0",
      "ipv4_subnet": "192.168.2.0/24",
      "bgp_neighbors": true
    }
  ]
}