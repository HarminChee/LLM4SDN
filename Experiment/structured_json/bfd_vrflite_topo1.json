{
  "metadata": {
    "script_name": "test_bfd_vrflite_topo1.py",
    "description": "2 routers (r1, r2) with VRF-lite, VLAN subinterfaces .100, .200, .300 each mapped to vrf1, vrf2, vrf3. BFD tested in these VRFs.",
    "conf_files": {
      "r1": ["zebra.conf", "bfdd.conf"],
      "r2": ["zebra.conf", "bfdd.conf"]
    }
  },

  "routers": {
    "r1": {
      "type": "router",
      "vrfs": {
        "vrf1": {
          "table_id": 10,
          "interfaces": ["eth0.100","loop1"]
        },
        "vrf2": {
          "table_id": 20,
          "interfaces": ["eth0.200","loop2"]
        },
        "vrf3": {
          "table_id": 30,
          "interfaces": ["eth0.300"]
        }
      },
      "interfaces": {
        "eth0.100": {
          "vlan_id": 100,
          "parent_if": "eth0",
          "vrf_name": "vrf1",
          "ipv4": "192.168.1.1/24",
          "connected_to": "s1" 
        },
        "eth0.200": {
          "vlan_id": 200,
          "parent_if": "eth0",
          "vrf_name": "vrf2",
          "ipv4": "192.168.2.1/24",
          "connected_to": "s1"
        },
        "eth0.300": {
          "vlan_id": 300,
          "parent_if": "eth0",
          "vrf_name": "vrf3",
          "ipv4": "192.168.3.1/24",
          "connected_to": "s1"
        },
        "loop1": {
          "vrf_name": "vrf1",
          "ipv4": "10.0.1.1/32"
        },
        "loop2": {
          "vrf_name": "vrf2",
          "ipv4": "10.0.2.1/32"
        }
      },
      "bfd": {
        "peers": {
        }
      }
    },

    "r2": {
      "type": "router",
      "vrfs": {
        "vrf1": {
          "table_id": 10,
          "interfaces": ["eth0.100","loop1"]
        },
        "vrf2": {
          "table_id": 20,
          "interfaces": ["eth0.200","loop2"]
        },
        "vrf3": {
          "table_id": 30,
          "interfaces": ["eth0.300"]
        }
      },
      "interfaces": {
        "eth0.100": {
          "vlan_id": 100,
          "parent_if": "eth0",
          "vrf_name": "vrf1",
          "ipv4": "192.168.1.2/24",
          "connected_to": "s1"
        },
        "eth0.200": {
          "vlan_id": 200,
          "parent_if": "eth0",
          "vrf_name": "vrf2",
          "ipv4": "192.168.2.2/24",
          "connected_to": "s1"
        },
        "eth0.300": {
          "vlan_id": 300,
          "parent_if": "eth0",
          "vrf_name": "vrf3",
          "ipv4": "192.168.3.2/24",
          "connected_to": "s1"
        },
        "loop1": {
          "vrf_name": "vrf1",
          "ipv4": "10.0.1.2/32"
        },
        "loop2": {
          "vrf_name": "vrf2",
          "ipv4": "10.0.2.2/32"
        }
      },
      "bfd": {
        "peers": {
        }
      }
    }
  },

  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": ["r1","r2"]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": ["r2"]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": ["r1"]
    }
  },

  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0.100",
      "interface_target": "eth0.100",
      "ipv4_subnet": "192.168.1.0/24",
      "vrf_source": "vrf1",
      "vrf_target": "vrf1",
      "protocols": ["bfd"] 
    },
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0.200",
      "interface_target": "eth0.200",
      "ipv4_subnet": "192.168.2.0/24",
      "vrf_source": "vrf2",
      "vrf_target": "vrf2",
      "protocols": ["bfd"]
    },
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0.300",
      "interface_target": "eth0.300",
      "ipv4_subnet": "192.168.3.0/24",
      "vrf_source": "vrf3",
      "vrf_target": "vrf3",
      "protocols": ["bfd"]
    }
  ]
}
