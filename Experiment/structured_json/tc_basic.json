      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "r2",
          "ipv4": "192.168.100.1/24"
        }
      },
      "zebra": {},
      "sharpd": {}
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "r1",
          "ipv4": "192.168.101.1/24"
        }
      },
      "zebra": {},
      "sharpd": {}
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0",
