{
  "metadata": {
    "script_name": "test_tc_basic.py",
    "description": "Test basic TC filters, classes and qdiscs.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "sharpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "sharpd.conf"
      ]
    }
  },
  "routers": {
