{
  "metadata": {
    "script_name": "test_bgp_graceful_restart.py",
    "description": "This test script configures and verifies BGP Graceful Restart functionality between two routers.",
    "conf_files": {
      "r1": [
        "bgpd.conf",
        "zebra.conf"
      ],
      "r2": [
        "bgpd.conf",
        "zebra.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1",
          "ipv4": "192.168.0.1/24",
          "ipv6": "fd00::1/64"
        }
      },
      "bgp": {
        "local_as": 65001,
        "graceful-restart": {
          "graceful-restart": true
        },
        "address_family": {
          "ipv4": {
            "unicast": {
              "neighbor": {
                "r2": {
                  "remote_as": "65002",
                  "ipv4_address": "192.168.0.2",
                  "graceful-restart-helper": true
                }
              }
            }
          },
          "ipv6": {
            "unicast": {
              "neighbor": {
                "r2": {
                  "remote_as": "65002",
                  "ipv6_address": "fd00::2",
                  "graceful-restart-helper": true
                }
              }
            }
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1",
          "ipv4": "192.168.0.2/24",
          "ipv6": "fd00::2/64"
        }
      },
      "bgp": {
        "local_as": 65002,
        "graceful-restart": {
          "graceful-restart": true
        },
        "address_family": {
          "ipv4": {
            "unicast": {
              "neighbor": {
                "r1": {
                  "remote_as": "65001",
                  "ipv4_address": "192.168.0.1",
                  "graceful-restart": true
                }
              }
            }
          },
          "ipv6": {
            "unicast": {
              "neighbor": {
                "r1": {
                  "remote_as": "65001",
                  "ipv6_address": "fd00::1",
                  "graceful-restart": true
                }
              }
            }
          }
        }
      }
    }
  },
  "switches": {
    "sw1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "ipv4_subnet": "192.168.0.0/24",
      "ipv6_subnet": "fd00::/64",
      "bgp_neighbors": true
    }
  ]
}