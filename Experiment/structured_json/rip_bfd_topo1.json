{
  "metadata": {
    "script_name": "test_rip_bfd_topo1.py",
    "description": "Test RIP BFD integration on a topology with 2 switches (s1, s2) and 3 routers (r1, r2, r3).",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bfdd.conf",
        "ripd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bfdd.conf",
        "ripd.conf",
        "staticd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bfdd.conf",
        "ripd.conf",
        "staticd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.0.1/24"
        },
        "eth1": {
          "connected_to": "s2",
          "ipv4": "192.168.1.1/24"
        }
      },
      "bfd": {
        "peers": {
          "192.168.0.2": {
            "status": "up",
            "receive_interval": 1000,
            "transmit_interval": 1000
          },
          "192.168.1.2": {
            "status": "up",
            "receive_interval": 1000,
            "transmit_interval": 1000
          }
        }
      },
      "rip": {
        "routes": {
          "10.254.254.2/32": [
            {
              "code": "R",
              "subCode": "n",
              "from": "192.168.0.2"
            }
          ],
          "10.254.254.3/32": [
            {
              "code": "R",
              "subCode": "n",
              "from": "192.168.1.2"
            }
          ],
          "10.254.254.100/32": [
            {
              "code": "R",
              "subCode": "n",
              "from": "192.168.0.2"
            },
            {
              "code": "R",
              "subCode": "n",
              "from": "192.168.1.2"
            }
          ]
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.0.2/24"
        }
      },
      "bfd": {
        "peers": {
          "192.168.0.1": {
            "status": "up",
            "receive_interval": 1000,
            "transmit_interval": 1000
          }
        }
      },
      "rip": {
        "routes": {
          "10.254.254.1/32": [
            {
              "code": "R",
              "subCode": "n",
              "from": "192.168.0.1"
            }
          ],
          "10.254.254.3/32": [
            {
              "code": "R",
              "subCode": "n",
              "from": "192.168.0.1"
            }
          ],
          "10.254.254.100/32": [
            {
              "code": "S",
              "subCode": "r",
              "from": "self"
            }
          ]
        }
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2",
          "ipv4": "192.168.1.2/24"
        }
      },
      "bfd": {
        "peers": {
          "192.168.1.1": {
            "status": "up",
            "receive_interval": 1000,
            "transmit_interval": 1000
          }
        }
      },
      "rip": {
        "routes": {
          "10.254.254.1/32": [
            {
              "code": "R",
              "subCode": "n",
              "from": "192.168.1.1"
            }
          ],
          "10.254.254.2/32": [
            {
              "code": "R",
              "subCode": "n",
              "from": "192.168.1.1"
            }
          ],
          "10.254.254.100/32": [
            {
              "code": "S",
              "subCode": "r",
              "from": "self"
            }
          ]
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r3"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0",
      "interface_target": "eth0",
      "ipv4_subnet": "192.168.0.0/24",
      "protocols": [
        "rip",
        "bfd"
      ]
    },
    {
      "source": "r1",
      "target": "r3",
      "interface_source": "eth1",
      "interface_target": "eth0",
      "ipv4_subnet": "192.168.1.0/24",
      "protocols": [
        "rip",
        "bfd"
      ]
    }
  ]
}