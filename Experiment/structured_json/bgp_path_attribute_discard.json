{
  "metadata": {
    "script_name": "test_bgp_path_attribute_discard.py",
    "description": "Topology with 1 switch (s1) and 2 routers (r1, r2) and 1 external BGP peer (peer1). Tests BGP path attribute discard functionality.",
    "conf_files": {
      "r1": [
        "frr.conf"
      ],
      "r2": [
        "frr.conf"
      ],
      "peer1": [
        "exabgp.env"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "neighbors": {
          "peer1": {
            "ip": "10.0.0.254",
            "description": "ExaBGP peer",
            "attributes_discarded": [
              "atomic-aggregate",
              "community"
            ]
          }
        },
        "routes": {
          "192.168.100.101/32": {
            "paths": [
              {
                "valid": true,
                "atomicAggregate": null,
                "community": null
              }
            ]
          },
          "192.168.100.102/32": {
            "paths": [
              {
                "valid": true,
                "originatorId": null,
                "community": null
              }
            ]
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "neighbors": {},
        "routes": {
          "192.168.100.101/32": {
            "paths": [
              {
                "valid": true,
                "aigpMetric": null
              }
            ]
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2",
        "peer1"
      ]
    }
  },
  "exabgp_peers": {
    "peer1": {
      "type": "exabgp",
      "ip": "10.0.0.254",
      "default_route": "via 10.0.0.1",
      "connected_to": [
        "s1"
      ]
    }
  }
}