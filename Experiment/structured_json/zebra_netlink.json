{
  "metadata": {
    "script_name": "test_zebra_netlink.py",
    "description": "Test some basic interactions with kernel using Netlink.",
    "conf_files": {
      "r1": [
        "zebra.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.1/24"
        }
      },
      "zebra": {
        "config_commands": [
          "conf t",
          "zebra kernel netlink batch-tx-buf 256 256"
        ]
      },
      "sharp": {
        "installed_routes": [
          {
            "prefix": "2.1.3.7/32",
            "nexthop": "192.168.1.1",
            "distance": 150,
            "metric": 0,
            "table": 254,
            "protocol": "sharp"
          }
        ],
        "route_removal": "2.1.3.7 100"
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "s1",
      "interface_source": "r1-eth0",
      "interface_target": "s1-port",
      "ipv4_subnet": "192.168.1.0/24"
    }
  ]
}