{
  "metadata": {
    "script_name": "test_bgpd_graceful_restart.py",
    "description": "Tests for BGP Graceful Restart functionality with 2 routers in IBGP.",
    "conf_files": {
      "r1": [
        "bgpd.conf"
      ],
      "r2": [
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.1/24",
          "ipv6": "fd00:0:0:1::1/64"
        }
      },
      "bgp": {
        "local_as": 100,
        "graceful-restart": {
          "preserve-fw-state": true
        },
        "neighbors": {
          "r2": {
            "dest_link": {
              "r1-link1": {
                "graceful-restart": true
              }
            },
            "remote_as": 100,
            "ipv4_address": "192.168.1.2",
            "ipv6_address": "fd00:0:0:1::2"
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.2/24",
          "ipv6": "fd00:0:0:1::2/64"
        }
      },
      "bgp": {
        "local_as": 100,
        "neighbors": {
          "r1": {
            "dest_link": {
              "r2-link1": {
                "graceful-restart": true
              }
            },
            "remote_as": 100,
            "ipv4_address": "192.168.1.1",
            "ipv6_address": "fd00:0:0:1::1"
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "ipv4_subnet": "192.168.1.0/24",
      "ipv6_subnet": "fd00:0:0:1::/64",
      "bgp_neighbors": true
    }
  ]
}