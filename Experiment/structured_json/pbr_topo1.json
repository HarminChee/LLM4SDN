{
  "metadata": {
    "script_name": "test_pbr_topo1.py",
    "description": "Network topology with 1 router and 5 switches, performing PBR tests.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "pbrd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1"
        },
        "eth1": {
          "connected_to": "sw2"
        },
        "eth2": {
          "connected_to": "sw3"
        },
        "eth3": {
          "connected_to": "sw4",
          "master": "vrf-chiyoda"
        },
        "eth4": {
          "connected_to": "sw5"
        }
      },
      "vrf": {
        "name": "vrf-chiyoda",
        "table": 1000
      },
      "pbr": {
        "interfaces": "pbr-interface.json",
        "map": "pbr-map.json",
        "nexthop_groups": "pbr-nexthop-groups.json"
      }
    }
  },
  "switches": {
    "sw1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "sw2": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "sw3": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "sw4": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "sw5": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    }
  }
}