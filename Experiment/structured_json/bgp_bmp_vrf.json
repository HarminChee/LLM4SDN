{
  "metadata": {
    "script_name": "test_bgp_bmp.py",
    "description": "Topology with 2 routers (r1, r2) exchanging IPv4/IPv6 routes in VRF 'vrf1'. Router r1 connects to a BMP server (bmp1) via switch s1, with BMP monitoring enabled. Tests BGP in VRF + BMP logging of updates/withdraws and peer state changes.",
    "conf_files": {
      "r1": ["zebra.conf", "bgpd.conf"],
      "r2": ["zebra.conf", "bgpd.conf"]
    }
  },

  "routers": {
    "r1": {
      "type": "router",

      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.0.2.1/24",
          "description": "Interface to BMP server via switch s1"
        },
        "eth1": {
          "connected_to": "r2",
          "ipv4": "192.168.0.1/24",
          "ipv6": "192:168::1/64",
          "vrf": "vrf1",
          "description": "Interface toward r2, placed into VRF 'vrf1'"
        }
      },

      "vrfs": {
        "vrf1": {
          "table_id": 10,
          "interfaces": ["eth1"],
          "description": "Example VRF with table ID=10, used for BGP session to r2"
        }
      },

      "bgp": {
        "local_as": 65501,

        "neighbors": {
          "192.168.0.2": {
            "remote_as": 65502,
            "vrf": "vrf1",
            "ipv6_address": "192:168::2",
            "description": "BGP neighbor (IPv4+IPv6) in vrf1 with router r2",
            "session_policies": [
              "pre-policy",
              "post-policy",
              "loc-rib"
            ]
          }
        },

        "bmp": {
          "enabled": true,
          "monitored_peers": ["192.168.0.2", "192:168::2"],
          "description": "R1 monitors BGP sessions in VRF 'vrf1' and sends BMP data to bmp1"
        }
      }
    },

    "r2": {
      "type": "router",

      "interfaces": {
        "eth0": {
          "connected_to": "r1",
          "ipv4": "192.168.0.2/24",
          "ipv6": "192:168::2/64",
          "description": "Interface toward r1"
        }
      },

      "bgp": {
        "local_as": 65502,

        "neighbors": {
          "192.168.0.1": {
            "remote_as": 65501,
            "vrf": null,  
            "ipv6_address": "192:168::1",
            "description": "BGP neighbor with r1 in r1's vrf1"
          }
        },

        "routes_originated": [
          {
            "prefix": "172.31.0.15/32",
            "active_state": "Tested with 'update' or 'withdraw'",
            "note": "IPv4 prefix in test scenario"
          },
          {
            "prefix": "2111::1111/128",
            "active_state": "Tested with 'update' or 'withdraw'",
            "note": "IPv6 prefix in test scenario"
          }
        ]
      }
    }
  },

  "bmp_servers": {
    "bmp1": {
      "type": "bmp_server",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.0.2.10/24",
          "default_route": "via 192.0.2.1",
          "description": "BMP server interface toward r1 via s1"
        }
      },
      "logging": {
        "log_file": "/path/to/logdir/bmp1/bmp.log",
        "description": "BMP log storing BGP updates/withdraw/peer up/down from r1"
      }
    }
  },

  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": ["r1", "bmp1"]
    }
  },

  "links": [
    {
      "source": "r1",
      "target": "s1",
      "interface_source": "eth0",
      "interface_target": "eth0",
      "ipv4_subnet": "192.0.2.0/24",
      "description": "Link between r1 and bmp1 via switch s1"
    },
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth1",
      "interface_target": "eth0",
      "ipv4_subnet": "192.168.0.0/24",
      "ipv6_subnet": "192:168::/64",
      "bgp_neighbors": true,
      "vrf_used": "vrf1",
      "description": "Link r1-eth1 <-> r2-eth0 (in VRF 'vrf1' on r1 side)"
    }
  ]
}
