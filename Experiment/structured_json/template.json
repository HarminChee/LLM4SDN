{
  "metadata": {
    "script_name": "<template>.py",
    "description": "Topology with 2 switches (s1, s2) and 2 routers (r1, r2) using OSPF + Zebra. Inferred from Python code.",
    "conf_files": {
      "r1": [
        "zebra.conf"
      ],
      "r2": [
        "zebra.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "r2",
          "ipv4": "192.168.1.1/24"
        },
        "eth1": {
          "connected_to": "s1"
        },
        "eth2": {
          "connected_to": "s2"
        }
      },
      "zebra": {
        "config_file": "zebra.conf"
      },
      "ospf": {
        "config_file": ""
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "r1",
          "ipv4": "192.168.1.2/24"
        },
        "eth1": {
          "connected_to": "s2"
        }
      },
      "zebra": {
        "config_file": "zebra.conf"
      },
      "ospf": {
        "config_file": ""
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0",
      "interface_target": "eth0",
      "ipv4_subnet": "192.168.1.0/24"
    }
  ]
}