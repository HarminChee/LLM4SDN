{
  "metadata": {
    "script_name": "test_bgp_dynamic_capability.py",
    "description": "Test BGP dynamic capability with graceful restart and long-lived graceful restart in a topology with 1 switch (s1) and 2 routers (r1, r2).",
    "conf_files": {
      "r1": [
        "frr.conf"
      ],
      "r2": [
        "frr.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.1/24"
        }
      },
      "bgp": {
        "local_as": 100,
        "neighbors": {
          "r2": {
            "remote_as": 100,
            "ipv4_address": "192.168.1.2",
            "state": "Established",
            "dynamic_capability": "advertisedAndReceived",
            "graceful_restart": "advertisedAndReceived",
            "long_lived_graceful_restart": "advertisedAndReceived",
            "accepted_prefix_counter": 3,
            "graceful_restart_info": {
              "nBit": true,
              "timers": {
                "receivedRestartTimer": 123,
                "configuredLlgrStaleTime": 10,
                "ipv4Unicast": {
                  "llgrStaleTime": 5
                }
              }
            },
            "message_stats": {
              "notificationsRecv": 0,
              "capabilityRecv": 2
            }
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.2/24"
        }
      },
      "bgp": {
        "local_as": 100,
        "neighbors": {
          "r1": {
            "remote_as": 100,
            "ipv4_address": "192.168.1.1",
            "state": "Established",
            "dynamic_capability": "advertisedAndReceived",
            "graceful_restart": "advertisedAndReceived",
            "long_lived_graceful_restart": "advertisedAndReceived",
            "graceful_restart_info": {
              "nBit": true,
              "timers": {
                "receivedRestartTimer": 120,
                "configuredLlgrStaleTime": 10,
                "ipv4Unicast": {
                  "llgrStaleTime": 10
                }
              }
            }
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "ipv4_subnet": "192.168.1.0/24",
      "bgp_neighbors": true
    }
  ]
}