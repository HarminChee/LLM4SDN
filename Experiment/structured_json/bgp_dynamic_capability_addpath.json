{
  "metadata": {
    "script_name": "test_bgp_addpath_paths_limit.py",
    "description": "Test if Addpath/Paths-Limit capabilities are adjusted dynamically.",
    "conf_files": {
      "r1": [
        "frr.conf"
      ],
      "r2": [
        "frr.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.1"
        }
      },
      "bgp": {
        "local_as": 65100,
        "neighbors": {
          "r2": {
            "remote_as": 65100,
            "ipv4_address": "192.168.1.2",
            "bgpState": "Established",
            "neighborCapabilities": {
              "dynamic": "advertisedAndReceived",
              "addPath": {
                "ipv4Unicast": {
                  "txAdvertisedAndReceived": false,
                  "txAdvertised": true,
                  "txReceived": false,
                  "rxAdvertisedAndReceived": true,
                  "rxAdvertised": true,
                  "rxReceived": true
                }
              },
              "pathsLimit": {
                "ipv4Unicast": {
                  "advertisedAndReceived": true,
                  "advertisedPathsLimit": 10,
                  "receivedPathsLimit": 20
                }
              }
            },
            "addressFamilyInfo": {
              "ipv4Unicast": {
                "acceptedPrefixCounter": 3
              }
            }
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.2"
        }
      },
      "bgp": {
        "local_as": 65100,
        "neighbors": {
          "r1": {
            "remote_as": 65100,
            "ipv4_address": "192.168.1.1",
            "bgpState": "Established",
            "neighborCapabilities": {
              "dynamic": "advertisedAndReceived",
              "addPath": {
                "ipv4Unicast": {
                  "txAdvertisedAndReceived": true,
                  "txAdvertised": true,
                  "txReceived": true,
                  "rxAdvertisedAndReceived": true,
                  "rxAdvertised": true,
                  "rxReceived": true
                }
              },
              "pathsLimit": {
                "ipv4Unicast": {
                  "advertisedAndReceived": true,
                  "advertisedPathsLimit": 10,
                  "receivedPathsLimit": 21
                }
              }
            },
            "addressFamilyInfo": {
              "ipv4Unicast": {
                "acceptedPrefixCounter": 3
              }
            }
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0",
      "interface_target": "eth0",
      "ipv4_subnet": "192.168.1.0/24",
      "bgp_neighbors": true
    }
  ]
}