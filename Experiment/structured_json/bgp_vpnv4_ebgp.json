{
  "metadata": {
    "script_name": "test_bgp_vpnv4_ebgp.py",
    "description": "Test the FRR BGP daemon with EBGP direct connection.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s2"
        }
      },
      "bgp": {},
      "zebra": {}
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s3"
        }
      },
      "bgp": {},
      "zebra": {}
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s4"
        }
      },
      "bgp": {},
      "zebra": {}
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2",
        "r3"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r2"
      ]
    },
    "s4": {
      "type": "switch",
      "connected_nodes": [
        "r3"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0"
    },
    {
      "source": "r1",
      "target": "r3",
      "interface_source": "r1-eth0",
      "interface_target": "r3-eth0"
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth0",
      "interface_target": "r3-eth0"
    }
  ]
}