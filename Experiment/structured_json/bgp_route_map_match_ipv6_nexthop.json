        "neighbors": {
          "r2": {
            "remote_as": 65002
          }
        }
      },
      "zebra": {}
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "local_as": 65002,
        "neighbors": {
          "r1": {
            "remote_as": 65001
          }
        }
      },
      "zebra": {}
    }
  },
  "switches": {
