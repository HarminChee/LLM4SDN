{
  "metadata": {
    "script_name": "bgp_vrf_dynamic_route_leak.py",
    "description": "Test BGP Multi-VRF Dynamic Route Leaking.",
    "conf_files": {
      "r1": [
        "bgpd.conf",
        "zebra.conf",
        "staticd.conf"
      ],
      "r2": [
        "bgpd.conf",
        "zebra.conf",
        "staticd.conf"
      ],
      "r3": [
        "bgpd.conf",
        "zebra.conf",
        "staticd.conf"
      ],
      "r4": [
        "bgpd.conf",
        "zebra.conf",
        "staticd.conf"
      ]
    }
