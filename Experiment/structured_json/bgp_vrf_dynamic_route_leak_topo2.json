          "connected_to": "r2",
          "ipv4": "11.11.11.1/32",
          "ipv6": "11:11::1/128"
        }
      },
      "bgp": {
        "local_as": 100,
        "address_family": {
          "ipv4": {
            "unicast": {
              "redistribute": [
