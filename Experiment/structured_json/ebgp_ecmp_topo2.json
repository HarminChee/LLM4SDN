{
  "metadata": {
    "script_name": "test_ecmp_ebgp.py",
    "description": "ECMP functionality on EBGP with multiple tests verifying route handling, redistribution of static routes, and network advertisement.",
    "conf_files": {
      "r2": [
        "bgpd.conf",
        "zebra.conf"
      ],
      "r3": [
        "bgpd.conf",
        "zebra.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.1/24"
        },
        "eth1": {
          "connected_to": "s2",
          "ipv4": "192.168.2.1/24"
        }
      },
      "bgp": {
        "local_as": 100,
        "address_family": {
          "ipv4": {
            "unicast": {}
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.2/24"
        },
        "eth1": {
          "connected_to": "s3",
          "ipv4": "192.168.3.2/24"
        }
      },
      "bgp": {
        "local_as": 200,
        "address_family": {
          "ipv4": {
            "unicast": {
              "redistribute": [
                {
                  "redist_type": "static"
                }
              ]
            }
          }
        }
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2",
          "ipv4": "192.168.2.2/24"
        },
        "eth1": {
          "connected_to": "s3",
          "ipv4": "192.168.3.3/24"
        }
      },
      "bgp": {
        "local_as": 300,
        "address_family": {
          "ipv4": {
            "unicast": {
              "maximum_paths": {
                "ebgp": "8"
              }
            }
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r3"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "ipv4_subnet": "192.168.1.0/24"
    },
    {
      "source": "r1",
      "target": "r3",
      "interface_source": "r1-eth1",
      "interface_target": "r3-eth0",
      "ipv4_subnet": "192.168.2.0/24"
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth1",
      "interface_target": "r3-eth1",
      "ipv4_subnet": "192.168.3.0/24"
    }
  ]
}