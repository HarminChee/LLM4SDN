{
  "metadata": {
    "script_name": "test_bgp_listen_on_multiple_addresses.py",
    "description": "Topology with 4 routers (r1, r2, r3, r4) in different ASes testing BGP listening on multiple addresses",
    "conf_files": {
      "r1": [
        "bgpd.conf",
        "zebra.conf"
      ],
      "r2": [
        "bgpd.conf",
        "zebra.conf"
      ],
      "r3": [
        "bgpd.conf",
        "zebra.conf"
      ],
      "r4": [
        "bgpd.conf",
        "zebra.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "asn": 1000,
      "interfaces": {
        "eth0": {
          "connected_to": "r2-eth0",
          "ipv4": "10.0.0.1/24"
        }
      },
      "bgp": {
        "local_as": 1000,
        "neighbors": {
          "r2": {
            "remote_as": 2000,
            "ipv4_address": "10.0.0.2",
            "state": "Established"
          }
        },
        "listen_addresses": [
          "10.0.0.1"
        ]
      }
    },
    "r2": {
      "type": "router",
      "asn": 2000,
      "interfaces": {
        "eth0": {
          "connected_to": "r1-eth0",
          "ipv4": "10.0.0.2/24"
        },
        "eth1": {
          "connected_to": "r3-eth0",
          "ipv4": "10.0.1.1/24"
        }
      },
      "bgp": {
        "local_as": 2000,
        "neighbors": {
          "r1": {
            "remote_as": 1000,
            "ipv4_address": "10.0.0.1",
            "state": "Established"
          },
          "r3": {
            "remote_as": 2000,
            "ipv4_address": "10.0.1.2",
            "state": "Established"
          }
        },
        "listen_addresses": [
          "10.0.0.2",
          "10.0.1.1"
        ]
      }
    },
    "r3": {
      "type": "router",
      "asn": 2000,
      "interfaces": {
        "eth0": {
          "connected_to": "r2-eth1",
          "ipv4": "10.0.1.2/24"
        },
        "eth1": {
          "connected_to": "r4-eth0",
          "ipv4": "10.0.2.1/24"
        }
      },
      "bgp": {
        "local_as": 2000,
        "neighbors": {
          "r2": {
            "remote_as": 2000,
            "ipv4_address": "10.0.1.1",
            "state": "Established"
          },
          "r4": {
            "remote_as": 3000,
            "ipv4_address": "10.0.2.2",
            "state": "Established"
          }
        },
        "listen_addresses": [
          "10.0.1.2",
          "10.0.2.1"
        ]
      }
    },
    "r4": {
      "type": "router",
      "asn": 3000,
      "interfaces": {
        "eth0": {
          "connected_to": "r3-eth1",
          "ipv4": "10.0.2.2/24"
        }
      },
      "bgp": {
        "local_as": 3000,
        "neighbors": {
          "r3": {
            "remote_as": 2000,
            "ipv4_address": "10.0.2.1",
            "state": "Established"
          }
        },
        "listen_addresses": [
          "10.0.2.2"
        ]
      }
    }
  }
}