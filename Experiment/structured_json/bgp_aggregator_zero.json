{
  "metadata": {
    "script_name": "test_bgp_aggregator_zero.py",
    "description": "1 FRR router (r1) + 1 ExaBGP peer (peer1) + 1 switch (s1). Tests aggregator as=0 scenario, aggregator attribute is discarded. FRR config => zebra.conf, bgpd.conf for r1, exabgp => exabgp.env for peer1",
    "conf_files": {
      "r1": ["zebra.conf", "bgpd.conf"],
      "peer1": ["exabgp.env", "ExaBGP config directory"]
    }
  },

  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",

          "ipv4": "10.0.0.1/24"
        }
      },
      "bgp": {

        "neighbors": {
          "peer1_s1": {
            "ipv4_address": "10.0.0.2"
          }
        }
      }
    }
  },

  "exabgp_peers": {
    "peer1": {
      "type": "exabgp",
      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",

          "ipv4": "10.0.0.2/24"
        }
      },
      "bgp": {

        "neighbors": {
          "r1_s1": {
            "ipv4_address": "10.0.0.1"
          }
        }
      }
    }
  },

  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": ["r1","peer1"]
    }
  },

  "links": [
    {
      "source": "r1",
      "target": "peer1",
      "interface_source": "eth0_s1",
      "interface_target": "eth0_s1",
      "ipv4_subnet": "10.0.0.0/24",
      "protocols": ["bgp"]
    }
  ]
}
