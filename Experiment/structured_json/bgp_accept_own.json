{
  "metadata": {
    "script_name": "test_bgp_accept_own.py",
    "description": "4 routers (ce1,ce2,pe1,rr1) + 4 switches (s1..s4). pe1 has VRF Customer(table=1001) & Service(table=1002). MPLS enabled for pe1-rr1 link. BGP accept-own test.",
    "conf_files": {
      "ce1": ["zebra.conf","bgpd.conf","ospfd.conf","ldpd.conf"],
      "ce2": ["zebra.conf","bgpd.conf","ospfd.conf","ldpd.conf"],
      "pe1": ["zebra.conf","bgpd.conf","ospfd.conf","ldpd.conf"],
      "rr1": ["zebra.conf","bgpd.conf","ospfd.conf","ldpd.conf"]
    }
  },

  "routers": {
    "ce1": {
      "type": "router",
      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "192.168.1.1/24"
        }
      },
      "bgp": {
      },
      "ospf": {},
      "ldp": {}
    },

    "ce2": {
      "type": "router",
      "interfaces": {
        "eth0_s2": {
          "connected_to": "s2",
          "ipv4": "192.168.2.1/24"
        }
      },
      "bgp": {},
      "ospf": {},
      "ldp": {}
    },

    "pe1": {
      "type": "router",
      "vrfs": {
        "Customer": { "table_id": 1001, "interfaces": ["eth0_s1","eth3_s4"] },
        "Service":  { "table_id": 1002, "interfaces": ["eth1_s2"] }
      },
      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "192.168.1.2/24",
          "vrf_name": "Customer"
        },
        "eth1_s2": {
          "connected_to": "s2",
          "ipv4": "192.168.2.2/24",
          "vrf_name": "Service"
        },
        "eth2_s3": {
          "connected_to": "s3",
          "ipv4": "10.10.10.1/30"
        },
        "eth3_s4": {
          "connected_to": "s4",
          "vrf_name": "Customer"
        }
      },
      "bgp": {
        "neighbors": {
          "ce1": { },
          "ce2": { },
          "rr1": { }
        }
      },
      "ospf": {},
      "ldp": {
      }
    },

    "rr1": {
      "type": "router",
      "interfaces": {
        "eth0_s3": {
          "connected_to": "s3",
          "ipv4": "10.10.10.2/30"
        }
      },
      "bgp": {
      },
      "ospf": {},
      "ldp": {}
    }
  },

  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": ["ce1","pe1"]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": ["ce2","pe1"]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": ["pe1","rr1"]
    },
    "s4": {
      "type": "switch",
      "connected_nodes": ["pe1"]
    }
  },

  "links": [
    {
      "source": "ce1",
      "target": "pe1",
      "interface_source": "eth0_s1",
      "interface_target": "eth0_s1",
      "ipv4_subnet": "192.168.1.0/24",
      "vrf_target": "Customer",
      "protocols": ["bgp","ospf"]
    },
    {
      "source": "ce2",
      "target": "pe1",
      "interface_source": "eth0_s2",
      "interface_target": "eth1_s2",
      "ipv4_subnet": "192.168.2.0/24",
      "vrf_target": "Service",
      "protocols": ["bgp","ospf"]
    },
    {
      "source": "pe1",
      "target": "rr1",
      "interface_source": "eth2_s3",
      "interface_target": "eth0_s3",
      "ipv4_subnet": "10.10.10.0/30",
      "mpls_enabled": true,
      "protocols": ["bgp","ospf","ldp"]
    }
  ]
}
