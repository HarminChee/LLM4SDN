{
  "metadata": {
    "script_name": "test_bgp_aigp.py",
    "description": "8 routers (r1..r8) + 8 switches (s1..s8). BGP AIGP scenario: r7 sets initial AIGP=71/72, r6,r2,r3 each add increments, r1 uses best AIGP path, r8 checks MED. OSPF + BGP in zebra/ospfd/bgpd conf.",
    "conf_files": {
      "r1": ["zebra.conf","ospfd.conf","bgpd.conf"],
      "r2": ["zebra.conf","ospfd.conf","bgpd.conf"],
      "r3": ["zebra.conf","ospfd.conf","bgpd.conf"],
      "r4": ["zebra.conf","ospfd.conf","bgpd.conf"],
      "r5": ["zebra.conf","ospfd.conf","bgpd.conf"],
      "r6": ["zebra.conf","ospfd.conf","bgpd.conf"],
      "r7": ["zebra.conf","ospfd.conf","bgpd.conf"],
      "r8": ["zebra.conf","ospfd.conf","bgpd.conf"]
    }
  },

  "routers": {
