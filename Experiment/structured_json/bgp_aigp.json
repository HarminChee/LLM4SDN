      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "10.0.1.1/24"
        },
        "eth1_s2": {
          "connected_to": "s2",
          "ipv4": "10.0.2.1/24"
        },
        "eth2_s8": {
