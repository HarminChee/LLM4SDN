{
  "metadata": {
    "script_name": "test_oper.py",
    "description": "Topology with 2 switches (s1, s2) and 1 router (r1) with VRF configuration and various query types testing.",
    "conf_files": {
      "r1": [
        "frr-simple.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth1": {
          "connected_to": "s2"
        },
        "lo-red": {
          "connected_to": null
        }
      },
      "vrf": {
        "red": {
          "id": 10,
          "interfaces": [
            "lo-red",
            "eth1"
          ]
        }
      },
      "frr_config": "frr-simple.conf"
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    }
  }
}