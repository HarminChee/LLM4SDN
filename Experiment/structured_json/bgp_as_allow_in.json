{
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "10.0.12.1/24"
        }
      },
      "bgp": {

        "neighbors": {
          "r2_s1": {
            "ipv4_address": "10.0.12.2"
          }
        }
      }
    },

    "r2": {
      "type": "router",
      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "10.0.12.2/24"
        },
        "eth1_s2": {
          "connected_to": "s2",
          "ipv4": "10.0.23.2/24"
        }
      },
      "bgp": {

        "neighbors": {
          "r1_s1": {
            "ipv4_address": "10.0.12.1"
          },
          "r3_s2": {
            "ipv4_address": "10.0.23.3"
          }
        }
      }
    },

    "r3": {
      "type": "router",
      "interfaces": {
        "eth0_s2": {
          "connected_to": "s2",
          "ipv4": "10.0.23.3/24"
        },
        "eth1_s3": {
          "connected_to": "s3",
          "ipv4": "10.0.34.3/24"
        }
      },
      "bgp": {

        "neighbors": {
          "r2_s2": {
            "ipv4_address": "10.0.23.2"
          },
          "r4_s3": {
            "ipv4_address": "10.0.34.4"
          }
        }
      }
    },

    "r4": {
      "type": "router",
      "interfaces": {
        "eth0_s3": {
          "connected_to": "s3",
          "ipv4": "10.0.34.4/24"
        },
        "eth1_s4": {
          "connected_to": "s4",
          "ipv4": "10.0.45.4/24"
        }
      },
      "bgp": {

        "neighbors": {
          "r3_s3": {
            "ipv4_address": "10.0.34.3"
          },
          "r5_s4": {
            "ipv4_address": "10.0.45.5"
          }
        }
      }
    },

    "r5": {
      "type": "router",
      "interfaces": {
        "eth0_s4": {
          "connected_to": "s4",
          "ipv4": "10.0.45.5/24"
        }
      },
      "bgp": {

        "neighbors": {
          "r4_s4": {
            "ipv4_address": "10.0.45.4"
          }
        }
      }
    }
  },

  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r3",
        "r4"
      ]
    },
    "s4": {
      "type": "switch",
      "connected_nodes": [
        "r4",
        "r5"
      ]
    }
  },

  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0_s1",
      "interface_target": "eth0_s1",
      "ipv4_subnet": "10.0.12.0/24",
      "protocols": ["bgp"]
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "eth1_s2",
      "interface_target": "eth0_s2",
      "ipv4_subnet": "10.0.23.0/24",
      "protocols": ["bgp"]
    },
    {
      "source": "r3",
      "target": "r4",
      "interface_source": "eth1_s3",
      "interface_target": "eth0_s3",
      "ipv4_subnet": "10.0.34.0/24",
      "protocols": ["bgp"]
    },
    {
      "source": "r4",
      "target": "r5",
      "interface_source": "eth1_s4",
      "interface_target": "eth0_s4",
      "ipv4_subnet": "10.0.45.0/24",
      "protocols": ["bgp"]
    }
  ],

  "metadata": {
    "script_name": "bgp_as_allow_in.py",
    "description": "5 routers (r1..r5) in a chain: (r1<->r2<->r3<->r4<->r5). The test checks BGP allowas-in over multiple occurrences, path prepends, eBGP vs iBGP. R1 typically local_as=200, route=2.2.2.2 is tested.",
    "conf_files": {
      "r1": ["zebra.conf", "bgpd.conf"],
      "r2": ["zebra.conf", "bgpd.conf"],
      "r3": ["zebra.conf", "bgpd.conf"],
      "r4": ["zebra.conf", "bgpd.conf"],
      "r5": ["zebra.conf", "bgpd.conf"]
    }
  }
}
