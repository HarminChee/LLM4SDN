{
  "metadata": {
    "script_name": "test_script.py",
    "description": "Testing BGP Graceful Restart functionality with a 7-router topology including various scenarios.",
    "conf_files": {
      "r1": [
        "bgpd.conf",
        "zebra.conf"
      ],
      "r2": [
        "bgpd.conf",
        "zebra.conf"
      ],
      "r3": [
        "bgpd.conf",
        "zebra.conf"
      ],
      "r6": [
        "bgpd.conf",
        "zebra.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.1/24",
          "ipv6": "fd00:0:0:1::1/64"
        },
        "eth1": {
          "connected_to": "s2",
          "ipv4": "192.168.2.1/24",
          "ipv6": "fd00:0:0:2::1/64"
        },
        "eth2": {
          "connected_to": "s3",
          "ipv4": "192.168.3.1/24",
          "ipv6": "fd00:0:0:3::1/64"
        }
      },
      "bgp": {
        "local_as": 100,
        "graceful_restart": {
          "graceful-restart": true,
          "preserve-fw-state": true
        },
        "address_family": {
          "ipv4": {
            "unicast": {
              "neighbor": {
                "r2": {
                  "graceful-restart": true
                },
                "r3": {
                  "graceful-restart": true
                }
              }
            }
          },
          "ipv6": {
            "unicast": {
              "neighbor": {
                "r2": {
                  "graceful-restart": true
                },
                "r3": {
                  "graceful-restart": true
                }
              }
            }
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2",
          "ipv4": "192.168.2.2/24",
          "ipv6": "fd00:0:0:2::2/64"
        },
        "eth1": {
          "connected_to": "s4",
          "ipv4": "192.168.4.2/24",
          "ipv6": "fd00:0:0:4::2/64"
        }
      },
      "bgp": {
        "local_as": 200,
        "graceful_restart": {
          "graceful-restart": true,
          "preserve-fw-state": true
        },
        "address_family": {
          "ipv4": {
            "unicast": {
              "neighbor": {
                "r1": {
                  "graceful-restart-helper": true
                },
                "r6": {
                  "graceful-restart-helper": true
                }
              }
            }
          },
          "ipv6": {
            "unicast": {
              "neighbor": {
                "r1": {
                  "graceful-restart-helper": true
                },
                "r6": {
                  "graceful-restart-helper": true
                }
              }
            }
          }
        }
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.3/24",
          "ipv6": "fd00:0:0:1::3/64"
        },
        "eth1": {
          "connected_to": "s3",
          "ipv4": "192.168.3.3/24",
          "ipv6": "fd00:0:0:3::3/64"
        }
      },
      "bgp": {
        "local_as": 300,
        "graceful_restart": {
          "graceful-restart": true,
          "next_hop_self": true
        },
        "address_family": {
          "ipv4": {
            "unicast": {
              "neighbor": {
                "r1": {
                  "graceful-restart-helper": true
                }
              }
            }
          },
          "ipv6": {
            "unicast": {
              "neighbor": {
                "r1": {
                  "graceful-restart-helper": true
                }
              }
            }
          }
        }
      }
    },
    "r6": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s4",
          "ipv4": "192.168.4.6/24",
          "ipv6": "fd00:0:0:4::6/64"
        }
      },
      "bgp": {
        "local_as": 600,
        "graceful_restart": {
          "graceful-restart-helper": true
        },
        "address_family": {
          "ipv4": {
            "unicast": {
              "neighbor": {
                "r1": {
                  "graceful-restart-helper": true
                },
                "r2": {
                  "graceful-restart-helper": true
                }
              }
            }
          },
          "ipv6": {
            "unicast": {
              "neighbor": {
                "r1": {
                  "graceful-restart-helper": true
                },
                "r2": {
                  "graceful-restart-helper": true
                }
              }
            }
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r3"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r3"
      ]
    },
    "s4": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r6"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth1",
      "interface_target": "eth0",
      "protocols": [
        "bgp"
      ],
      "ipv4_subnet": "192.168.2.0/24",
      "ipv6_subnet": "fd00:0:0:2::/64"
    },
    {
      "source": "r1",
      "target": "r3",
      "interface_source": "eth2",
      "interface_target": "eth1",
      "protocols": [
        "bgp"
      ],
      "ipv4_subnet": "192.168.3.0/24",
      "ipv6_subnet": "fd00:0:0:3::/64"
    },
    {
      "source": "r2",
      "target": "r6",
      "interface_source": "eth1",
      "interface_target": "eth0",
      "protocols": [
        "bgp"
      ],
      "ipv4_subnet": "192.168.4.0/24",
      "ipv6_subnet": "fd00:0:0:4::/64"
    }
  ]
}