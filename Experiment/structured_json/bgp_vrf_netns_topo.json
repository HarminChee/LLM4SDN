{
  "metadata": {
    "script_name": "test_bgp_vrf_netns_topo1.py",
    "description": "Test BGP topology with EBGP on NETNS VRF",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "vrf": [
        "r1-bgp-cust1"
      ],
      "bgp": {},
      "zebra": {}
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "peer1"
      ]
    }
  },
  "peers": {
    "peer1": {
      "type": "exabgp",
      "ip": "10.0.1.101",
      "defaultRoute": "via 10.0.1.1"
    }
  }
}