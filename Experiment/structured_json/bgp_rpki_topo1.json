{
  "metadata": {
    "script_name": "bgp_rpki_test_script.py",
    "description": "BGP RPKI test script with 3 switches and 4 routers using BGP, static and Zebra configurations.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "staticd.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "staticd.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "staticd.conf",
        "bgpd.conf"
      ],
      "r4": [
        "zebra.conf",
        "staticd.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "zebra": {},
      "static": {},
      "bgp": {
        "local_as": 65001,
        "neighbors": {}
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s2",
          "vrf": "vrf10"
        },
        "eth2": {
          "connected_to": "s3"
        }
      },
      "zebra": {},
      "static": {},
      "bgp": {
        "local_as": 65002,
        "neighbors": {}
      },
      "vrf": "vrf10"
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2"
        }
      },
      "zebra": {},
      "static": {},
      "bgp": {
        "local_as": 65003,
        "neighbors": {}
      }
    },
    "r4": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s3"
        }
      },
      "zebra": {},
      "static": {},
      "bgp": {
        "local_as": 65004,
        "neighbors": {}
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r4"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0"
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth1",
      "interface_target": "r3-eth0"
    },
    {
      "source": "r2",
      "target": "r4",
      "interface_source": "r2-eth2",
      "interface_target": "r4-eth0"
    }
  ]
}