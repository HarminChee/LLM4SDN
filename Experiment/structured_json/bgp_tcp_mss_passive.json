{
  "metadata": {
    "script_name": "test_bgp_tcp_mss.py",
    "description": "Test if TCP MSS is synced with passive neighbor. Topology with 1 switch (s1) and 2 routers (r1, r2). BGP and TCP MSS tested.",
    "conf_files": {
      "r1": [
        "frr.conf"
      ],
      "r2": [
        "frr.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.1/24"
        }
      },
      "bgp": {
        "neighbors": {
          "r2": {
            "remote_as": 65001,
            "ipv4_address": "192.168.1.2",
            "tcp_mss_configured": 300,
            "tcp_mss_synced": 288
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.2/24"
        }
      },
      "bgp": {
        "neighbors": {
          "r1": {
            "remote_as": 65001,
            "ipv4_address": "192.168.1.1",
            "tcp_mss_configured": 1500,
            "tcp_mss_synced": 1488
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    }
  }
}