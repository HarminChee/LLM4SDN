{
  "metadata": {
    "script_name": "bgp_vrf_dynamic_route_leaking.py",
    "description": "BGP Multi-VRF Dynamic Route Leaking: Verify recursive imports among Tenant VRFs.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "11.11.11.1/32",
          "ipv6": "11:11::1/128"
        }
      },
      "bgp": {
        "local_as": 1,
        "vrf": {
          "RED": {
            "address_family": {
              "ipv4": {
                "unicast": {
                  "neighbors": {
                    "r3": {
                      "remote_as": 3,
                      "shutdown": true
                    }
                  }
                }
              },
              "ipv6": {
                "unicast": {
                  "neighbors": {
                    "r3": {
                      "remote_as": 3,
                      "shutdown": true
                    }
                  }
                }
              }
            },
            "import": [
              "BLUE",
              "GREEN"
            ]
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2",
          "ipv4": "22.22.22.2/32",
          "ipv6": "22:22::2/128"
        }
      },
      "bgp": {
        "local_as": 2,
        "vrf": {
          "RED": {
            "address_family": {
              "ipv4": {
                "unicast": {
                  "neighbors": {
                    "r3": {
                      "remote_as": 3,
                      "shutdown": true
                    }
                  }
                }
              },
              "ipv6": {
                "unicast": {
                  "neighbors": {
                    "r3": {
                      "remote_as": 3,
                      "shutdown": true
                    }
                  }
                }
              }
            },
            "import": [
              "BLUE",
              "GREEN"
            ]
          }
        }
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.10.10.1/32",
          "ipv6": "10:10::1/128"
        }
      },
      "bgp": {
        "local_as": 3,
        "vrf": {
          "RED": {
            "address_family": {
              "ipv4": {
                "unicast": {
                  "redistribute": [
                    {
                      "redist_type": "static"
                    }
                  ],
                  "neighbors": {
                    "r1": {
                      "remote_as": 1,
                      "shutdown": true
                    },
                    "r2": {
                      "remote_as": 2,
                      "shutdown": true
                    }
                  }
                }
              },
              "ipv6": {
                "unicast": {
                  "redistribute": [
                    {
                      "redist_type": "static"
                    }
                  ],
                  "neighbors": {
                    "r1": {
                      "remote_as": 1,
                      "shutdown": true
                    },
                    "r2": {
                      "remote_as": 2,
                      "shutdown": true
                    }
                  }
                }
              }
            },
            "import": [
              "BLUE",
              "GREEN"
            ]
          },
          "BLUE": {
            "address_family": {
              "ipv4": {
                "unicast": {
                  "redistribute": [
                    {
                      "redist_type": "static"
                    }
                  ]
                }
              },
              "ipv6": {
                "unicast": {
                  "redistribute": [
                    {
                      "redist_type": "static"
                    }
                  ]
                }
              }
            }
          },
          "GREEN": {
            "address_family": {
              "ipv4": {
                "unicast": {
                  "redistribute": [
                    {
                      "redist_type": "static"
                    }
                  ]
                }
              },
              "ipv6": {
                "unicast": {
                  "redistribute": [
                    {
                      "redist_type": "static"
                    }
                  ]
                }
              }
            }
          }
        },
        "static_routes": [
          {
            "network": [
              "10.10.10.1/32"
            ],
            "next_hop": "blackhole",
            "vrf": "RED"
          }
        ]
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r3"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r3",
      "interface_source": "r1-eth0",
      "interface_target": "r3-eth0",
      "ipv4_subnet": "10.10.10.1/32",
      "bgp_neighbors": true
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth0",
      "interface_target": "r3-eth0",
      "ipv4_subnet": "10.10.10.1/32",
      "bgp_neighbors": true
    }
  ]
}