{
  "metadata": {
    "script_name": "test_bgp_gr_restart_retain_routes.py",
    "description": "Test if routes are retained during BGP restarts using Graceful Restart per-neighbor.",
    "conf_files": {
      "r1": [
        "frr.conf"
      ],
      "r2": [
        "frr.conf"
      ],
      "r3": [
        "frr.conf"
      ],
      "r4": [
        "frr.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {}
    },
    "r2": {
      "type": "router",
      "interfaces": {}
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      }
    },
    "r4": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "neighbors": {
          "192.168.34.3": {
            "bgpState": "Established",
            "addressFamilyInfo": {
              "ipv4Unicast": {
                "acceptedPrefixCounter": 2
              }
            }
          }
        },
        "routes": {
          "172.16.255.3/32": {
            "stale": true
          }
        }
      },
      "kernel_routes": {
        "172.16.255.3/32": {
          "dst": "172.16.255.3",
          "gateway": "192.168.34.3",
          "metric": 20
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r3",
        "r4"
      ]
    }
  },
  "links": [
    {
      "source": "r3",
      "target": "r4",
      "interface_source": "r3-eth0",
      "interface_target": "r4-eth0"
    }
  ]
}