{
  "metadata": {
    "script_name": "pim_dr_nondr_with_transit_router_topo3.py",
    "description": "Configuring OSPF on r1/r2/r4/r5/r6 for RP reachability with r6 as a transit router between r1/r2 and r4.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "ospfd.conf",
        "pimd.conf"
      ],
      "r2": [
        "zebra.conf",
        "ospfd.conf",
        "pimd.conf"
      ],
      "r4": [
        "zebra.conf",
        "ospfd.conf",
        "pimd.conf"
      ],
      "r5": [
        "zebra.conf",
        "ospfd.conf",
        "pimd.conf"
      ],
      "r6": [
        "zebra.conf",
        "ospfd.conf",
        "pimd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.1.1/24"
        },
        "eth1": {
          "connected_to": "s1",
          "ipv4": "10.0.5.2/24"
        }
      },
      "ospf": {
        "area": "0.0.0.0"
      },
      "pim": {
        "dr_priority": 1,
        "hello_timer": 1,
        "hold_timer": 3
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.2.1/24"
        },
        "eth1": {
          "connected_to": "s1",
          "ipv4": "10.0.5.3/24"
        }
      },
      "ospf": {
        "area": "0.0.0.0"
      },
      "pim": {
        "dr_priority": 1,
        "hello_timer": 1,
        "hold_timer": 3
      }
    },
    "r4": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2",
          "ipv4": "10.0.4.1/24"
        },
        "eth1": {
          "connected_to": "r5",
          "ipv4": "10.0.3.1/24"
        }
      },
      "ospf": {
        "area": "0.0.0.0"
      },
      "pim": {
        "rp": {
          "rp_addr": "10.0.4.1",
          "group_range": "225.1.1.0/24"
        }
      }
    },
    "r5": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2",
          "ipv4": "10.0.3.2/24"
        },
        "eth1": {
          "connected_to": "r4",
          "ipv4": "10.0.3.2/24"
        }
      },
      "ospf": {
        "area": "0.0.0.0"
      },
      "pim": {
        "interfaces": [
          {
            "intf": "eth0",
            "igmp": {
              "version": 2
            }
          }
        ]
      }
    },
    "r6": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.4.2/24"
        },
        "eth1": {
          "connected_to": "s1",
          "ipv4": "10.0.1.2/24"
        },
        "eth2": {
          "connected_to": "s1",
          "ipv4": "10.0.2.2/24"
        }
      },
      "ospf": {
        "area": "0.0.0.0"
      }
    },
    "i1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.5.1/24"
        }
      }
    },
    "i2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2",
          "ipv4": "10.0.5.1/24"
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2",
        "r6"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r4",
        "r5"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r6",
      "interface_source": "eth0",
      "interface_target": "eth0"
    },
    {
      "source": "r2",
      "target": "r6",
      "interface_source": "eth0",
      "interface_target": "eth1"
    },
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth1",
      "interface_target": "eth1"
    },
    {
      "source": "r4",
      "target": "r5",
      "interface_source": "eth1",
      "interface_target": "eth1"
    }
  ]
}