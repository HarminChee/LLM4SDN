{
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "192.168.1.1/24"
        }
      },
      "bgp": {

        "neighbors": {
          "r2_s1": {
            "ipv4_address": "192.168.1.2"
          }
        }
      }
    },

    "r2": {
      "type": "router",
      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "192.168.1.2/24"
        },
        "eth1_s2": {
          "connected_to": "s2",
          "ipv4": "192.168.2.1/24"
        }
      },
      "bgp": {

        "neighbors": {
          "r1_s1": {
            "ipv4_address": "192.168.1.1"
          },
          "r3_s2": {
            "ipv4_address": "192.168.2.2"
          }
        }
      }
    },

    "r3": {
      "type": "router",
      "interfaces": {
        "eth0_s2": {
          "connected_to": "s2",
          "ipv4": "192.168.2.2/24"
        },
        "eth1_s3": {
          "connected_to": "s3",
          "ipv4": "192.168.3.3/24"
        }
      },
      "bgp": {

        "neighbors": {
          "r2_s2": {
            "ipv4_address": "192.168.2.1"
          },
          "r4_s3": {
            "ipv4_address": "192.168.3.4"
          }
        }
      }
    },

    "r4": {
      "type": "router",
      "interfaces": {
        "eth0_s3": {
          "connected_to": "s3",
          "ipv4": "192.168.3.4/24"
        }
      },
      "bgp": {

        "neighbors": {
          "r3_s3": {
            "ipv4_address": "192.168.3.3"
          }
        }
      }
    }
  },

  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r3",
        "r4"
      ]
    }
  },

  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0_s1",
      "interface_target": "eth0_s1",
      "ipv4_subnet": "192.168.1.0/24",
      "protocols": ["bgp"]
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "eth1_s2",
      "interface_target": "eth0_s2",
      "ipv4_subnet": "192.168.2.0/24",
      "protocols": ["bgp"]
    },
    {
      "source": "r3",
      "target": "r4",
      "interface_source": "eth1_s3",
      "interface_target": "eth0_s3",
      "ipv4_subnet": "192.168.3.0/24",
      "protocols": ["bgp"]
    }
  ],

  "metadata": {
    "script_name": "test_bgp_as_override.py",
    "description": "4 routers in chain (r1<->r2<->r3<->r4). The script tests as-override from r3, checking final path in r4 is '65003 65002 65003' for the 172.16.255.1/32 route.",
    "conf_files": {
      "r1": ["zebra.conf","bgpd.conf"],
      "r2": ["zebra.conf","bgpd.conf"],
      "r3": ["zebra.conf","bgpd.conf"],
      "r4": ["zebra.conf","bgpd.conf"]
    }
  }
}
