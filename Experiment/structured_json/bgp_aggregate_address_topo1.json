{
  "metadata": {
    "script_name": "test_bgp_aggregate_address_topo1.py",
    "description": "2 FRR routers (r1,r2) + 1 ExaBGP peer (peer1) + 2 switches (s1,s2). BGP aggregator tests with ExaBGP injection. FRR configs => zebra.conf,bgpd.conf for r1,r2. ExaBGP => exabgp.env.",
    "conf_files": {
      "r1": ["zebra.conf","bgpd.conf"],
      "r2": ["zebra.conf","bgpd.conf"],
      "peer1": ["exabgp.env","ExaBGP config dir"]
    }
  },

  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {

        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "10.0.0.1/24"
        },

        "eth1_s2": {
          "connected_to": "s2",
          "ipv4": "10.0.1.1/24"
        }
      },
      "bgp": {

        "neighbors": {
          "peer1_s1": {
            "ipv4_address": "10.0.0.2"
          },
          "r2_s2": {
            "ipv4_address": "10.0.1.2"
          }
        }
      }
    },

    "r2": {
      "type": "router",
      "interfaces": {

        "eth0_s2": {
          "connected_to": "s2",
          "ipv4": "10.0.1.2/24"
        }
      },
      "bgp": {

        "neighbors": {
          "r1_s2": {
            "ipv4_address": "10.0.1.1"
          }
        }
      }
    }
  },

  "exabgp_peers": {
    "peer1": {
      "type": "exabgp",
      "interfaces": {

        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "10.0.0.2/24"
        }
      },

      "bgp": {
        "neighbors": {
          "r1_s1": {
            "ipv4_address": "10.0.0.1"
          }
        }
      }
    }
  },

  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": ["r1","peer1"]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": ["r1","r2"]
    }
  },

  "links": [
    {
      "source": "r1",
      "target": "peer1",
      "interface_source": "eth0_s1",
      "interface_target": "eth0_s1",
      "ipv4_subnet": "10.0.0.0/24",
      "protocols": ["bgp"]
    },
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth1_s2",
      "interface_target": "eth0_s2",
      "ipv4_subnet": "10.0.1.0/24",
      "protocols": ["bgp"]
    }
  ]
}
