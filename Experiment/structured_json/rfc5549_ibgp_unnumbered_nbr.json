{
  "metadata": {
    "script_name": "rfc5549_ibgp_unnumbered_nbr.json",
    "description": "Topology with 4 routers (R0, R1, R2, R3) and 2 eBGP/iBGP connections, using static routes with IPv6 nexthop.",
    "conf_files": {
      "R1": [
        "bgpd.conf",
        "staticd.conf"
      ],
      "R2": [
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "R0": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "R1-eth0",
          "ipv4": "10.0.0.1/32"
        },
        "eth1": {
          "connected_to": "R1-eth1",
          "ipv4": "10.0.1.1/32"
        }
      }
    },
    "R1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "R0-eth0",
          "ipv4": "10.0.0.2/32"
        },
        "eth1": {
          "connected_to": "R0-eth1",
          "ipv4": "10.0.1.2/32"
        },
        "eth2": {
          "connected_to": "R2-eth0",
          "ipv6_linklocal": "fe80::1",
          "ipv6": "2001:db8::1/128"
        }
      },
      "bgp": {
        "local_as": 65001,
        "neighbors": {
          "R2": {
            "remote_as": 65002,
            "ipv6_linklocal": "fe80::2",
            "ipv6_nexthop": true
          }
        }
      }
    },
    "R2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "R1-eth2",
          "ipv6_linklocal": "fe80::2",
          "ipv6": "2001:db8::2/128"
        },
        "eth1": {
          "connected_to": "R3-eth0",
          "ipv4": "10.0.3.1/32"
        }
      },
      "bgp": {
        "local_as": 65002,
        "neighbors": {
          "R1": {
            "remote_as": 65001,
            "ipv6_linklocal": "fe80::1",
            "ipv6_nexthop": true
          }
        }
      }
    },
    "R3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "R2-eth1",
          "ipv4": "10.0.3.2/32"
        },
        "eth1": {
          "connected_to": "R4-eth0",
          "ipv4": "11.0.4.1/32"
        }
      }
    },
    "R4": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "R3-eth1",
          "ipv4": "11.0.4.2/32"
        }
      }
    }
  },
  "links": [
    {
      "source": "R0",
      "target": "R1",
      "interface_source": "eth0",
      "interface_target": "eth0",
      "ipv4_subnet": "10.0.0.0/32"
    },
    {
      "source": "R0",
      "target": "R1",
      "interface_source": "eth1",
      "interface_target": "eth1",
      "ipv4_subnet": "10.0.1.0/32"
    },
    {
      "source": "R1",
      "target": "R2",
      "interface_source": "eth2",
      "interface_target": "eth0",
      "ipv6_subnet": "2001:db8::/128",
      "ipv6_linklocal": "fe80::"
    },
    {
      "source": "R2",
      "target": "R3",
      "interface_source": "eth1",
      "interface_target": "eth0",
      "ipv4_subnet": "10.0.3.0/32"
    },
    {
      "source": "R3",
      "target": "R4",
      "interface_source": "eth1",
      "interface_target": "eth0",
      "ipv4_subnet": "11.0.4.0/32"
    }
  ]
}