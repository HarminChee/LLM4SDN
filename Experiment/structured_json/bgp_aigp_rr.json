{
  "metadata": {
    "script_name": "test_bgp_aigp_rr.py",
    "description": "4 routers (r1,r2,r3,r4) + 4 switches (s1..s4). r1 is route-reflector, r2->aigp=2 => r3 sees 2, r4 sees 12. Also check local-route vs AIGP preference. OSPF & BGP in zebra/ospfd/bgpd.conf",
    "conf_files": {
      "r1": ["zebra.conf","ospfd.conf","bgpd.conf"],
      "r2": ["zebra.conf","ospfd.conf","bgpd.conf"],
      "r3": ["zebra.conf","ospfd.conf","bgpd.conf"],
      "r4": ["zebra.conf","ospfd.conf","bgpd.conf"]
    }
  },

  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "10.0.1.1/24"
        },
        "eth1_s2": {
          "connected_to": "s2",
          "ipv4": "10.0.2.1/24"
        },
        "eth2_s3": {
          "connected_to": "s3",
          "ipv4": "10.0.3.1/24"
        }
      },
      "ospf": {},
      "bgp": {

        "neighbors": {
          "r2_s1": {
            "ipv4_address": "10.0.1.2"
          },
          "r3_s2": {
            "ipv4_address": "10.0.2.3"
          },
          "r4_s3": {
            "ipv4_address": "10.0.3.4"
          }
        }
      }
    },

    "r2": {
      "type": "router",
      "interfaces": {
        "eth0_s1": {
          "connected_to": "s1",
          "ipv4": "10.0.1.2/24"
        },

        "eth1_s4": {
          "connected_to": "s4",
          "ipv4": "10.0.4.2/24"
        }
      },
      "ospf": {},
      "bgp": {

        "neighbors": {
          "r1_s1": {
            "ipv4_address": "10.0.1.1"
          },
          "r3_s4": {
            "ipv4_address": "10.0.4.3"
          }
        }
      }
    },

    "r3": {
      "type": "router",
      "interfaces": {
        "eth0_s2": {
          "connected_to": "s2",
          "ipv4": "10.0.2.3/24"
        },
        "eth1_s4": {
          "connected_to": "s4",
          "ipv4": "10.0.4.3/24"
        }
      },
      "ospf": {},
      "bgp": {

        "neighbors": {
          "r1_s2": {
            "ipv4_address": "10.0.2.1"
          },
          "r2_s4": {
            "ipv4_address": "10.0.4.2"
          }
        }
      }
    },

    "r4": {
      "type": "router",
      "interfaces": {
        "eth0_s3": {
          "connected_to": "s3",
          "ipv4": "10.0.3.4/24"
        }
      },
      "ospf": {},
      "bgp": {

        "neighbors": {
          "r1_s3": {
            "ipv4_address": "10.0.3.1"
          }
        }
      }
    }
  },

  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": ["r1","r2"]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": ["r1","r3"]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": ["r1","r4"]
    },
    "s4": {
      "type": "switch",
      "connected_nodes": ["r2","r3"]
    }
  },

  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0_s1",
      "interface_target": "eth0_s1",
      "ipv4_subnet": "10.0.1.0/24",
      "protocols": ["bgp","ospf"]
    },
    {
      "source": "r1",
      "target": "r3",
      "interface_source": "eth1_s2",
      "interface_target": "eth0_s2",
      "ipv4_subnet": "10.0.2.0/24",
      "protocols": ["bgp","ospf"]
    },
    {
      "source": "r1",
      "target": "r4",
      "interface_source": "eth2_s3",
      "interface_target": "eth0_s3",
      "ipv4_subnet": "10.0.3.0/24",
      "protocols": ["bgp"]

    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "eth1_s4",
      "interface_target": "eth1_s4",
      "ipv4_subnet": "10.0.4.0/24",
      "protocols": ["bgp","ospf"]
    }
  ]
}
