{
  "metadata": {
    "script_name": "test_prefix_list_functionality.py",
    "description": "Testing IP prefix-list functionality with 4 routers topology, r1, r2, r3 in IBGP and r3, r4 in EBGP.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r4": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.0.1/24"
        }
      },
      "bgp": {
        "local_as": 100,
        "neighbors": {
          "r2": {
            "remote_as": 100,
            "ipv4_address": "10.0.0.2"
          },
          "r3": {
            "remote_as": 100,
            "ipv4_address": "10.0.0.3"
          }
        },
        "address_family": {
          "ipv4": {
            "unicast": {
              "redistribute": [
                "static",
                "connected"
              ]
            }
          }
        }
      },
      "static_routes": [
        {
          "network": "20.0.20.1/32",
          "next_hop": "10.0.0.2"
        },
        {
          "network": "10.0.20.1/32",
          "next_hop": "10.0.0.2"
        }
      ],
      "prefix_lists": {
        "ipv4": {
          "pf_list_1": [
            {
              "seqid": 10,
              "network": "20.0.20.1/32",
              "action": "permit"
            },
            {
              "seqid": "10",
              "network": "10.0.20.1/32",
              "action": "deny"
            },
            {
              "seqid": "11",
              "network": "any",
              "action": "permit"
            }
          ]
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.0.2/24"
        },
        "eth1": {
          "connected_to": "s2",
          "ipv4": "20.0.0.1/24"
        }
      },
      "bgp": {
        "local_as": 100,
        "neighbors": {
          "r1": {
            "remote_as": 100,
            "ipv4_address": "10.0.0.1"
          },
          "r3": {
            "remote_as": 100,
            "ipv4_address": "10.0.0.3"
          }
        },
        "address_family": {
          "ipv4": {
            "unicast": {
              "redistribute": [
                "static",
                "connected"
              ]
            }
          }
        }
      },
      "static_routes": [
        {
          "network": "20.0.20.1/32",
          "next_hop": "10.0.0.1"
        }
      ]
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2",
          "ipv4": "10.0.0.3/24"
        },
        "eth1": {
          "connected_to": "s3",
          "ipv4": "20.0.0.2/24"
        }
      },
      "bgp": {
        "local_as": 100,
        "neighbors": {
          "r1": {
            "remote_as": 100,
            "ipv4_address": "10.0.0.1"
          },
          "r2": {
            "remote_as": 100,
            "ipv4_address": "10.0.0.2"
          },
          "r4": {
            "remote_as": 200,
            "ipv4_address": "20.0.0.3"
          }
        },
        "address_family": {
          "ipv4": {
            "unicast": {
              "redistribute": [
                "static",
                "connected"
              ],
              "neighbor": {
                "r1": {
                  "prefix_lists": [
                    {
                      "name": "pf_list_1",
                      "direction": "in"
                    }
                  ]
                },
                "r4": {
                  "prefix_lists": [
                    {
                      "name": "pf_list_1",
                      "direction": "out"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "static_routes": [
        {
          "network": "10.0.0.2/30",
          "next_hop": "10.0.0.9"
        },
        {
          "network": "10.0.0.0/8",
          "le": 32,
          "action": "deny"
        }
      ],
      "prefix_lists": {
        "ipv4": {
          "pf_list_1": [
            {
              "seqid": 10,
              "network": "10.0.0.0/8",
              "le": 32,
              "action": "deny"
            },
            {
              "seqid": 11,
              "network": "any",
              "action": "permit"
            }
          ]
        }
      }
    },
    "r4": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s3",
          "ipv4": "20.0.0.3/24"
        }
      },
      "bgp": {
        "local_as": 200,
        "neighbors": {
          "r3": {
            "remote_as": 100,
            "ipv4_address": "20.0.0.2"
          }
        },
        "address_family": {
          "ipv4": {
            "unicast": {
              "redistribute": [
                "static",
                "connected"
              ]
            }
          }
        }
      },
      "static_routes": [
        {
          "network": "20.0.20.1/32",
          "next_hop": "10.0.0.1"
        }
      ]
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r3",
        "r4"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "ipv4_subnet": "10.0.0.0/24",
      "bgp_neighbors": true
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth1",
      "interface_target": "r3-eth0",
      "ipv4_subnet": "20.0.0.0/24",
      "bgp_neighbors": true
    },
    {
      "source": "r3",
      "target": "r4",
      "interface_source": "r3-eth1",
      "interface_target": "r4-eth0",
      "ipv4_subnet": "20.0.0.0/24",
      "bgp_neighbors": true
    }
  ]
}