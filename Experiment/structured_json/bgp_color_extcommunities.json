{
  "metadata": {
    "script_name": "test_bgp_color_extcommunity.py",
    "description": "Two routers (r1, r2) connected via switch s1. Tests BGP color extended communities on prefix 10.10.10.0/24, verifying that it is announced from r1 to r2 with specific color RT:80:987 / Color:01:100 / 01:200 / 01:55555.",
    "conf_files": {
      "r1": ["zebra.conf", "bgpd.conf"],
      "r2": ["zebra.conf", "bgpd.conf"]
    }
  },

  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.1/24",
          "description": "r1 interface to s1"
        }
      },
      "bgp": {
        "local_as": 65001,
        "neighbors": {
          "192.168.1.2": {
            "remote_as": 65002,
            "description": "BGP neighbor with r2",
            "ipv4_address": "192.168.1.2"
          }
        },
        "routes_originated": [
          {
            "prefix": "10.10.10.0/24",
            "extended_communities": [
              "RT:80:987",
              "Color:01:100",
              "Color:01:200",
              "Color:01:55555"
            ],
            "note": "Route injected by r1 with multiple color ext communities"
          }
        ]
      }
    },

    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "192.168.1.2/24",
          "description": "r2 interface to s1"
        }
      },
      "bgp": {
        "local_as": 65002,
        "neighbors": {
          "192.168.1.1": {
            "remote_as": 65001,
            "description": "BGP neighbor with r1",
            "ipv4_address": "192.168.1.1"
          }
        },
        "routes_received": [
          {
            "prefix": "10.10.10.0/24",
            "expected_extended_communities": [
              "RT:80:987",
              "Color:01:100",
              "Color:01:200",
              "Color:01:55555"
            ],
            "note": "r2 should see these ext communities upon success"
          }
        ]
      }
    }
  },

  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": ["r1", "r2"],
      "description": "Single switch interconnecting r1 and r2"
    }
  },

  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "eth0",
      "interface_target": "eth0",
      "ipv4_subnet": "192.168.1.0/24",
      "bgp_neighbors": true,
      "description": "Direct link between r1 and r2 through s1"
    }
  ]
}
