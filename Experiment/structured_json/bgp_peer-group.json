{
  "metadata": {
    "script_name": "test_bgp_peer_group.py",
    "description": "Test if peer-group works for numbered and unnumbered configurations.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s2"
        }
      },
      "bgp": {
        "local_as": 65001,
        "neighbors": {
          "r2": {
            "remote_as": 65001,
            "state": "Established",
            "peer_group": "PG"
          },
          "r3": {
            "remote_as": 65001,
            "state": "Established",
            "peer_group": "PG1"
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s2"
        }
      },
      "bgp": {
        "local_as": 65001,
        "neighbors": {
          "r1": {
            "remote_as": 65001,
            "state": "Established",
            "peer_group": "PG"
          }
        }
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "local_as": 65001,
        "neighbors": {
          "r1": {
            "remote_as": 65001,
            "state": "Established",
            "peer_group": "PG1"
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2",
        "r3"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "bgp_neighbors": true
    },
    {
      "source": "r1",
      "target": "r3",
      "interface_source": "r1-eth1",
      "interface_target": "r3-eth0",
      "bgp_neighbors": true
    }
  ]
}