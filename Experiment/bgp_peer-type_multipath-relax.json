{
  "metadata": {
    "script_name": "test_bgp_peer-type_multipath-relax.py",
    "description": "Test the effects of the 'bgp bestpath peer-type multipath-relax' command in a topology with mixed eBGP, iBGP, and confed routes.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "staticd.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "staticd.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1",
          "ipv4": "10.0.1.1/24"
        },
        "eth1": {
          "connected_to": "sw2",
          "ipv4": "10.0.2.1/24"
        },
        "eth2": {
          "connected_to": "sw3",
          "ipv4": "10.0.3.1/24"
        },
        "eth3": {
          "connected_to": "sw4",
          "ipv4": "10.0.4.1/24"
        }
      },
      "bgp": {
        "local_as": 64510,
        "neighbors": {
          "peer1": {
            "remote_as": 64499,
            "ipv4_address": "10.0.1.2",
            "state": "Established"
          },
          "peer2": {
            "remote_as": 64499,
            "ipv4_address": "10.0.2.2",
            "state": "Established"
          },
          "peer3": {
            "remote_as": 64499,
            "ipv4_address": "10.0.3.2",
            "state": "Established"
          },
          "peer4": {
            "remote_as": 64499,
            "ipv4_address": "10.0.4.2",
            "state": "Established"
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw2",
          "ipv4": "10.0.2.1/24"
        }
      },
      "bgp": {
        "local_as": 64510,
        "neighbors": {
          "r1": {
            "remote_as": 64510,
            "ipv4_address": "10.0.2.1",
            "state": "Established"
          }
        }
      }
    }
  },
  "switches": {
