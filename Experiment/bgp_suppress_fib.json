{
  "metadata": {
    "script_name": "test_bgp_suppress_fib.py",
    "description": "Topology with 2 switches (s1, s2) and 3 routers (r1, r2, r3). BGP tested with zebra configurations.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s2"
        }
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2"
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "protocols": [
        "bgp"
      ]
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth1",
      "interface_target": "r3-eth0",
      "protocols": [
        "bgp"
      ]
    }
  ]
}