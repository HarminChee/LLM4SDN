{
  "metadata": {
    "script_name": "test_bgp_prefix_sid.py",
    "description": "BGP topology with EBGP on prefix-sid",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.0.0.1/24"
        }
      },
      "zebra": {},
      "bgp": {
        "local_as": null,
        "neighbors": {
          "peer1": {
            "remote_as": null,
            "ipv4_address": "10.0.0.101"
          },
          "peer2": {
            "remote_as": null,
            "ipv4_address": "10.0.0.102"
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "peer1",
        "peer2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "peer1",
      "interface_source": "r1-eth0",
      "interface_target": "",
      "ipv4_subnet": "10.0.0.0/24",
      "bgp_neighbors": true
    },
    {
      "source": "r1",
      "target": "peer2",
      "interface_source": "r1-eth0",
      "interface_target": "",
      "ipv4_subnet": "10.0.0.0/24",
      "bgp_neighbors": true
    }
  ]
}