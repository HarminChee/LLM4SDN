{
  "metadata": {
    "script_name": "test_bgp_llgr.py",
    "description": "Topology with multiple routers and switches to test BGP Long-lived Graceful Restart capability.",
    "conf_files": {
      "r0": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r4": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r5": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r0": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s0"
        }
      },
      "bgp": {}
    },
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {}
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s0"
        },
        "eth1": {
          "connected_to": "s1"
        },
        "eth2": {
          "connected_to": "s2"
        },
        "eth3": {
          "connected_to": "s3"
        }
      },
      "bgp": {}
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2"
        }
      },
      "bgp": {}
    },
    "r4": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s3"
        }
      },
      "bgp": {}
    },
    "r5": {
      "type": "router",
      "bgp": {}
    }
  },
  "switches": {
    "s0": {
      "type": "switch",
      "connected_nodes": [
        "r0",
        "r2"
      ]
    },
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r4"
      ]
    }
  },
  "links": [
    {
      "source": "r0",
      "target": "r2",
      "interface_source": "r0-eth0",
      "interface_target": "r2-eth0"
    },
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth1"
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth2",
      "interface_target": "r3-eth0"
    },
    {
      "source": "r2",
      "target": "r4",
      "interface_source": "r2-eth3",
      "interface_target": "r4-eth0"
    }
  ]
}