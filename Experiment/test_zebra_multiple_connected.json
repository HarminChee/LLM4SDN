{
  "metadata": {
    "script_name": "test_zebra_multiple_connected.py",
    "description": "Testing multiple connected routes with zebra and dummy interfaces.",
    "conf_files": {
      "r1": [
        "zebra.conf"
      ],
      "r2": [
        "zebra.conf"
      ],
      "r3": [
        "zebra.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1"
        },
        "eth1": {
          "connected_to": "sw2"
        }
      },
      "zebra": {
        "config_file": "zebra.conf"
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw2"
        },
        "eth1": {
          "connected_to": "sw3"
        }
      },
      "zebra": {
        "config_file": "zebra.conf"
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw3"
        },
        "eth1": {
          "connected_to": "sw4"
        }
      },
      "zebra": {
        "config_file": "zebra.conf"
      }
    }
  },
  "switches": {
    "sw1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "sw2": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "sw3": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3"
      ]
    },
    "sw4": {
      "type": "switch",
      "connected_nodes": [
        "r3"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth1",
      "interface_target": "r2-eth0"
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth1",
      "interface_target": "r3-eth0"
    }
  ]
}