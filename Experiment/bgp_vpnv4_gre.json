{
  "metadata": {
    "script_name": "test_bgp_vpnv4_gre.py",
    "description": "Test the FRR BGP daemon with BGP IPv6 interface with route advertisements on a separate netns.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s2"
        }
      },
      "bgp": {},
      "zebra": {}
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s3"
        }
      },
      "bgp": {},
      "zebra": {}
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r2"
      ]
    }
  }
}