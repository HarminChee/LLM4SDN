{
  "metadata": {
    "script_name": "unknown",
    "description": "Check if routes from R1 has local-preference set to 0 and graceful-shutdown community.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "local_as": 1,
        "neighbors": {
          "r2": {
            "remote_as": 2,
            "ipv4_address": "192.168.1.1",
            "state": "Established",
            "graceful_shutdown": true
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s2"
        }
      },
      "bgp": {
        "local_as": 2,
        "neighbors": {
          "r1": {
            "remote_as": 1,
            "ipv4_address": "192.168.1.1",
            "state": "Established"
          },
          "r3": {
            "remote_as": 3,
            "ipv4_address": "192.168.2.2",
            "state": "Established"
          }
        }
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2"
        }
      },
      "bgp": {
        "local_as": 3,
        "neighbors": {
          "r2": {
            "remote_as": 2,
            "ipv4_address": "192.168.2.2",
            "state": "Established"
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r2",
        "r3"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "protocols": [
        "bgp"
      ],
      "ipv4_subnet": "192.168.1.0/24"
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth1",
      "interface_target": "r3-eth0",
      "protocols": [
        "bgp"
      ],
      "ipv4_subnet": "192.168.2.0/24"
    }
  ]
}