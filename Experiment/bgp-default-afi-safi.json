{
  "metadata": {
    "script_name": "bgp_default_ipv4_ipv6_unicast.py",
    "description": "Test default BGP ipv4-unicast, ipv6-unicast, and l2vpn-evpn functionalities.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r3": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r4": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "neighbors": {
          "192.168.255.254": {
            "remote_as": "external",
            "address_families": [
              "ipv4Unicast"
            ]
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "neighbors": {
          "192.168.255.254": {
            "remote_as": "external",
            "address_families": [
              "ipv6Unicast"
            ]
          }
        }
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "neighbors": {
          "192.168.255.254": {
            "remote_as": "external",
            "address_families": [
              "l2VpnEvpn"
            ]
          }
        }
      }
    },
    "r4": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "neighbors": {
          "192.168.255.254": {
            "remote_as": "external",
            "address_families": [
              "ipv4Unicast",
              "ipv6Unicast",
              "l2VpnEvpn"
            ]
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2",
        "r3",
        "r4"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "s1",
      "interface_source": "eth0",
      "interface_target": "eth0"
    },
    {
      "source": "r2",
      "target": "s1",
      "interface_source": "eth0",
      "interface_target": "eth0"
    },
    {
      "source": "r3",
      "target": "s1",
      "interface_source": "eth0",
      "interface_target": "eth0"
    },
    {
      "source": "r4",
      "target": "s1",
      "interface_source": "eth0",
      "interface_target": "eth0"
    }
  ]
}