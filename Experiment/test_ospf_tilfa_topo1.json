{
  "metadata": {
    "script_name": "test_ospf_tilfa_topo1.py",
    "description": "Topology with 5 switches and 5 routers using OSPF and Zebra for TI-LFA testing.",
    "conf_files": {
      "rt1": [
        "zebra.conf",
        "ospfd.conf"
      ],
      "rt2": [
        "zebra.conf",
        "ospfd.conf"
      ],
      "rt3": [
        "zebra.conf",
        "ospfd.conf"
      ],
      "rt4": [
        "zebra.conf",
        "ospfd.conf"
      ],
      "rt5": [
        "zebra.conf",
        "ospfd.conf"
      ]
    }
  },
  "routers": {
    "rt1": {
      "type": "router",
      "interfaces": {
        "eth-rt2": {
          "connected_to": "s1",
          "ipv4": "10.0.1.1/24"
        },
        "eth-rt3": {
          "connected_to": "s2",
          "ipv4": "10.0.2.1/24"
        }
      },
      "ospf": {
        "enable": true
      },
      "zebra": {}
    },
    "rt2": {
      "type": "router",
      "interfaces": {
        "eth-rt1": {
          "connected_to": "s1",
          "ipv4": "10.0.1.2/24"
        },
        "eth-rt4": {
          "connected_to": "s3",
          "ipv4": "10.0.3.2/24"
        }
      },
      "ospf": {
        "enable": true
      },
      "zebra": {}
    },
    "rt3": {
      "type": "router",
      "interfaces": {
        "eth-rt1": {
          "connected_to": "s2",
          "ipv4": "10.0.2.3/24"
        },
        "eth-rt5": {
          "connected_to": "s4",
          "ipv4": "10.0.4.3/24"
        }
      },
      "ospf": {
        "enable": true
      },
      "zebra": {}
    },
    "rt4": {
      "type": "router",
      "interfaces": {
        "eth-rt2": {
          "connected_to": "s3",
          "ipv4": "10.0.3.4/24"
        },
        "eth-rt5": {
          "connected_to": "s5",
          "ipv4": "10.0.5.4/24"
        }
      },
      "ospf": {
        "enable": true
      },
      "zebra": {}
    },
    "rt5": {
      "type": "router",
      "interfaces": {
        "eth-rt3": {
          "connected_to": "s4",
          "ipv4": "10.0.4.5/24"
        },
        "eth-rt4": {
          "connected_to": "s5",
          "ipv4": "10.0.5.5/24"
        }
      },
      "ospf": {
        "enable": true
      },
      "zebra": {}
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "rt1",
        "rt2"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "rt1",
        "rt3"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "rt2",
        "rt4"
      ]
    },
    "s4": {
      "type": "switch",
      "connected_nodes": [
        "rt3",
        "rt5"
      ]
    },
    "s5": {
      "type": "switch",
      "connected_nodes": [
        "rt4",
        "rt5"
      ]
    }
  },
  "links": [
    {
      "source": "rt1",
      "target": "rt2",
      "interface_source": "eth-rt2",
      "interface_target": "eth-rt1",
      "ipv4_subnet": "10.0.1.0/24",
      "ospf_neighbors": true
    },
    {
      "source": "rt1",
      "target": "rt3",
      "interface_source": "eth-rt3",
      "interface_target": "eth-rt1",
      "ipv4_subnet": "10.0.2.0/24",
      "ospf_neighbors": true
    },
    {
      "source": "rt2",
      "target": "rt4",
      "interface_source": "eth-rt4",
      "interface_target": "eth-rt2",
      "ipv4_subnet": "10.0.3.0/24",
      "ospf_neighbors": true
    },
    {
      "source": "rt3",
      "target": "rt5",
      "interface_source": "eth-rt5",
      "interface_target": "eth-rt3",
      "ipv4_subnet": "10.0.4.0/24",
      "ospf_neighbors": true
    },
    {
      "source": "rt4",
      "target": "rt5",
      "interface_source": "eth-rt5",
      "interface_target": "eth-rt4",
      "ipv4_subnet": "10.0.5.0/24",
      "ospf_neighbors": true
    }
  ]
}