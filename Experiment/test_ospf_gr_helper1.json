{
  "metadata": {
    "script_name": "ospf_gr_helper.py",
    "description": "Topology with 1 switch (sw1) and 4 routers (r0, r1, r2, r3) using OSPF.",
    "conf_files": {
      "r0": [
        "ospfd.conf",
        "zebra.conf"
      ],
      "r1": [
        "ospfd.conf",
        "zebra.conf"
      ],
      "r2": [
        "ospfd.conf",
        "zebra.conf"
      ],
      "r3": [
        "ospfd.conf",
        "zebra.conf"
      ]
    }
  },
  "routers": {
    "r0": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1"
        }
      },
      "ospf": {
        "graceful_restart": {
          "helper_enable": [
            "1.1.1.1"
          ],
          "opaque": true
        }
      }
    },
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1"
        }
      },
      "ospf": {
        "graceful_restart": {
          "helper_enable": [
            "1.1.1.1"
          ],
          "opaque": true
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1"
        }
      },
      "ospf": {
        "graceful_restart": {
          "helper_enable": [
            "1.1.1.1"
          ],
          "opaque": true
        }
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "sw1"
        }
      },
      "ospf": {
        "graceful_restart": {
          "helper_enable": [
            "1.1.1.1"
          ],
          "opaque": true
        }
      }
    }
  },
  "switches": {
    "sw1": {
      "type": "switch",
      "connected_nodes": [
        "r0",
        "r1",
        "r2",
        "r3"
      ]
    }
  },
  "links": [
    {
      "source": "r0",
      "target": "sw1",
      "interface_source": "r0-eth0",
      "interface_target": "sw1"
    },
    {
      "source": "r1",
      "target": "sw1",
      "interface_source": "r1-eth0",
      "interface_target": "sw1"
    },
    {
      "source": "r2",
      "target": "sw1",
      "interface_source": "r2-eth0",
      "interface_target": "sw1"
    },
    {
      "source": "r3",
      "target": "sw1",
      "interface_source": "r3-eth0",
      "interface_target": "sw1"
    }
  ]
}