{
  "metadata": {
    "script_name": "test_bgp_local_as_ecmp.py",
    "description": "Topology with 4 routers (r1, r2, r3, r4) and BGP configuration for testing local AS functionality with ECMP on 8 links. Inferred from the original Python code.",
    "conf_files": {
      "r1": [
        "bgpd.conf",
        "zebra.conf"
      ],
      "r2": [
        "bgpd.conf",
        "zebra.conf"
      ],
      "r3": [
        "bgpd.conf",
        "zebra.conf"
      ],
      "r4": [
        "bgpd.conf",
        "zebra.conf"
      ]
    }
  },
  "routers": {
