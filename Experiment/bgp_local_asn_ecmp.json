      "interfaces": {
        "eth0": {
          "connected_to": "s1",
          "ipv4": "10.1.1.1/24"
        },
        "eth1": {
          "connected_to": "s2",
          "ipv4": "10.1.2.1/24"
        }
      },
      "bgp": {
        "local_as": 100,
        "address_family": {
          "ipv4": {
