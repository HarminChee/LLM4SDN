                  "redist_type": "static"
                }
              ],
              "neighbor": {
                "r2": {
                  "dest_link": {
                    "r1-link1": {
                      "local_asn": {
                        "local_as": "110"
                      }
                    }
                  }
                }
              }
            }
          },
          "ipv6": {
            "unicast": {
              "redistribute": [
