{
  "metadata": {
    "script_name": "test_bgp_received_routes_with_soft_inbound.py",
    "description": "Test topology with a single switch s1 connecting two routers r1 and r2. The script tests BGP received routes and convergence.",
    "conf_files": {
      "r1": [
        "frr.conf"
      ],
      "r2": [
        "frr.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "local_as": 65000,
        "neighbors": {
          "r2": {
            "remote_as": 65000,
            "ipv4_address": "192.168.1.2",
            "state": "Established",
            "received_routes": {
              "10.0.0.2/32": {
                "valid": true,
                "path": "65002",
                "next_hop": "192.168.1.2"
              }
            }
          }
        },
        "routes": {
          "10.0.0.2/32": {
            "valid": true,
            "path": "65000 65000 65000 65002",
            "nexthops": [
              {
                "ip": "192.168.1.2"
              }
            ]
          }
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "local_as": 65000,
        "neighbors": {
          "r1": {
            "remote_as": 65000,
            "ipv4_address": "192.168.1.1",
            "state": "Established"
          }
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "protocols": [
        "bgp"
      ]
    }
  ]
}