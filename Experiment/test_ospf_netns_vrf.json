{
  "metadata": {
    "script_name": "test_ospf_netns_vrf.py",
    "description": "Test OSPF with Network Namespace VRFs.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "ospfd.conf"
      ],
      "r2": [
        "zebra.conf",
        "ospfd.conf"
      ],
      "r3": [
        "zebra.conf",
        "ospfd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s3"
        }
      },
      "ospf": {
        "vrf": "r1-ospf-cust1"
      },
      "zebra": {
        "vrf": "r1-ospf-cust1"
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s2"
        },
        "eth1": {
          "connected_to": "s3"
        }
      },
      "ospf": {
        "vrf": "r2-ospf-cust1"
      },
      "zebra": {
        "vrf": "r2-ospf-cust1"
      }
    },
    "r3": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s3"
        },
        "eth1": {
          "connected_to": "s4"
        }
      },
      "ospf": {
        "vrf": "r3-ospf-cust1"
      },
      "zebra": {
        "vrf": "r3-ospf-cust1"
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r2"
      ]
    },
    "s3": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2",
        "r3"
      ]
    },
    "s4": {
      "type": "switch",
      "connected_nodes": [
        "r3"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth1",
      "interface_target": "r2-eth1"
    },
    {
      "source": "r1",
      "target": "r3",
      "interface_source": "r1-eth1",
      "interface_target": "r3-eth0"
    },
    {
      "source": "r2",
      "target": "r3",
      "interface_source": "r2-eth1",
      "interface_target": "r3-eth0"
    }
  ]
}