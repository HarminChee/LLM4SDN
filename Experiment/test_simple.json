{
  "metadata": {
    "script_name": "test_static_route_functionality.py",
    "description": "Test static route functionality with simple topology involving two switches and one router using static routes and VRF configuration.",
    "conf_files": {
      "r1": [
        "frr-simple.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s2"
        }
      },
      "vrf": {
        "red": {
          "id": 10,
          "interfaces": [
            "lo-red",
            "eth1"
          ]
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "s1",
      "interface_source": "r1-eth0",
      "protocols": []
    },
    {
      "source": "r1",
      "target": "s2",
      "interface_source": "r1-eth1",
      "protocols": []
    }
  ]
}