{
  "metadata": {
    "script_name": "static_route_test.py",
    "description": "Test static route functionality with VRF configuration, using Zebra and static routes.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "static_routes.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        },
        "eth1": {
          "connected_to": "s2",
          "vrf": "red"
        }
      },
      "vrfs": {
        "red": {
          "interfaces": [
            "lo-red",
            "eth1"
          ]
        }
      },
      "zebra": {},
      "static": {}
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    },
    "s2": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    }
  }
}