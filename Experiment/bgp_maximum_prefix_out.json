{
  "metadata": {
    "script_name": "test_bgp_maximum_prefix_out.py",
    "description": "Test if `neighbor <X.X.X.X> maximum-prefix-out <Y>` is working correctly in a topology with 2 routers (r1, r2) connected by one switch (s1).",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "neighbors": {
          "192.168.255.1": {}
        }
      }
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "neighbors": {
          "192.168.255.2": {}
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0"
    }
  ]
}