{
  "metadata": {
    "script_name": "test_bgp_vrf_different_asn.py",
    "description": "Topology with 1 router (r1) connected to a switch (s1). BGP and VRF configuration with different ASNs.",
    "conf_files": {
      "r1": [
        "frr.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "default": {
          "vrfName": "default",
          "localAS": 65000
        },
        "vrf100": {
          "vrfName": "vrf100",
          "localAS": 65100
        }
      }
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "s1",
      "interface_source": "r1-eth0",
      "interface_target": "s1"
    }
  ]
}