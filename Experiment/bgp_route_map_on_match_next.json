{
  "metadata": {
    "script_name": "test_bgp_route_map_on_match_next.py",
    "description": "Test whether `on-match next` added to an existing route-map entry takes effect.",
    "conf_files": {
      "r1": [
        "zebra.conf",
        "bgpd.conf"
      ],
      "r2": [
        "zebra.conf",
        "bgpd.conf"
      ]
    }
  },
  "routers": {
    "r1": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "local_as": null,
        "neighbors": {
          "r2": {
            "remote_as": null,
            "ipv4_address": "192.168.255.1",
            "state": "Established"
          }
        }
      },
      "zebra": {}
    },
    "r2": {
      "type": "router",
      "interfaces": {
        "eth0": {
          "connected_to": "s1"
        }
      },
      "bgp": {
        "local_as": null,
        "neighbors": {
          "r1": {
            "remote_as": null,
            "ipv4_address": "192.168.255.1",
            "state": "Established"
          }
        }
      },
      "zebra": {}
    }
  },
  "switches": {
    "s1": {
      "type": "switch",
      "connected_nodes": [
        "r1",
        "r2"
      ]
    }
  },
  "links": [
    {
      "source": "r1",
      "target": "r2",
      "interface_source": "r1-eth0",
      "interface_target": "r2-eth0",
      "ipv4_subnet": "192.168.255.0/24",
      "bgp_neighbors": true
    }
  ]
}